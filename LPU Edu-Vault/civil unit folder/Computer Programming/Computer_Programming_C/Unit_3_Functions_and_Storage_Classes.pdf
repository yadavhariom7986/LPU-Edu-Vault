(Problem: Solve the Tower of Hanoi puzzle for N disks moving from source rod A to) Tj
T*
(destination rod C using auxiliary rod B. Calculate total moves: 2^N - 1.) Tj
T*
(Source Code:) Tj
T*
(#include <stdio.h>) Tj
T*
(void towerOfHanoi\(int n, char from_rod, char to_rod, char aux_rod, int *moveCount\) {) Tj
T*
(if \(n == 1\) {) Tj
T*
(\(*moveCount\)++;) Tj
T*
(printf\("Move %2d: Move disk 1 from rod %c to rod %c\\n", *moveCount, from_rod, to_rod\);) Tj
T*
(return;) Tj
T*
(}) Tj
T*
(towerOfHanoi\(n - 1, from_rod, aux_rod, to_rod, moveCount\);) Tj
T*
(\(*moveCount\)++;) Tj
T*
(printf\("Move %2d: Move disk %d from rod %c to rod %c\\n", *moveCount, n, from_rod,) Tj
T*
(to_rod\);) Tj
T*
(towerOfHanoi\(n - 1, aux_rod, to_rod, from_rod, moveCount\);) Tj
T*
(}) Tj
T*
