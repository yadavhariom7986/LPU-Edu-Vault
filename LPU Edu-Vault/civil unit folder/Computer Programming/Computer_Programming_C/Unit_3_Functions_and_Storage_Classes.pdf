([PROGRAM 1: Call-by-Value vs. Call-by-Reference Demonstration \(Swap Function\)]) Tj
T*
/F1 9 Tf
/F2 9.5 Tf
(-----------------------------------------------------------------------------------------) Tj
T*
/F1 9 Tf
(Problem: Write two swap functions in C to rigorously contrast Call-by-Value and) Tj
T*
(Call-by-Reference \(via pointers\), inspecting memory addresses before, during, and after) Tj
T*
(execution.) Tj
T*
(Source Code:) Tj
T*
(#include <stdio.h>) Tj
T*
(void swapByValue\(int x, int y\) {) Tj
T*
(int temp = x;) Tj
T*
(x = y;) Tj
T*
(y = temp;) Tj
T*
(printf\(" Inside swapByValue: x = %d, y = %d \(Formal parameters altered\)\\n", x, y\);) Tj
T*
(}) Tj
T*
(void swapByReference\(int *x, int *y\) {) Tj
T*
(int temp = *x;) Tj
T*
(*x = *y;) Tj
T*
(*y = temp;) Tj
T*
(printf\(" Inside swapByReference: *x = %d, *y = %d \(Original memory modified\)\\n", *x,) Tj
T*
(*y\);) Tj
T*
(}) Tj
T*
(int main\(\) {) Tj
T*
(int a = 10, b = 20;) Tj
T*
(printf\("Initial: a = %d, b = %d\\n", a, b\);) Tj
T*
(swapByValue\(a, b\);) Tj
T*
(printf\("After swapByValue: a = %d, b = %d \(UNALTERED\)\\n", a, b\);) Tj
T*
(swapByReference\(&a, &b\);) Tj
T*
(printf\("After swapByReference: a = %d, b = %d \(SUCCESSFULLY SWAPPED\)\\n", a, b\);) Tj
T*
(return 0;) Tj
T*
(}) Tj
T*
(Output:) Tj
T*
(Initial: a = 10, b = 20) Tj
T*
(Inside swapByValue: x = 20, y = 10 \(Formal parameters altered\)) Tj
T*
(After swapByValue: a = 10, b = 20 \(UNALTERED\)) Tj
T*
(Inside swapByReference: *x = 20, *y = 10 \(Original memory modified\)) Tj
T*
(After swapByReference: a = 20, b = 10 \(SUCCESSFULLY SWAPPED\)) Tj
T*
() Tj
T*
() Tj
