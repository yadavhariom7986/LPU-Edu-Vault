(import numpy as np) Tj
T*
() Tj
T*
(t = np.linspace\(0, 0.04, 1000\) # 40 ms \(2 full 50 Hz cycles\)) Tj
T*
(v = 325.27 * np.sin\(2 * np.pi * 50 * t\) # 230 V RMS) Tj
T*
(i = 14.14 * np.sin\(2 * np.pi * 50 * t - np.pi / 4\) # 10 A RMS lagging 45 deg) Tj
T*
(p = v * i # Instantaneous power) Tj
T*
() Tj
T*
(fig, \(ax1, ax2\) = plt.subplots\(2, 1, figsize=\(9, 6\), sharex=True\)) Tj
T*
() Tj
T*
(# Upper Plot: Voltage and Current) Tj
T*
(ax1.plot\(t * 1000, v, 'b-', label='Voltage v\(t\) [V]'\)) Tj
T*
(ax1.set_ylabel\('Voltage \(V\)', color='blue'\)) Tj
T*
(ax1.tick_params\(axis='y', labelcolor='blue'\)) Tj
T*
() Tj
T*
(ax1_twin = ax1.twinx\(\)) Tj
T*
(ax1_twin.plot\(t * 1000, i, 'g--', label='Current i\(t\) [A]'\)) Tj
T*
(ax1_twin.set_ylabel\('Current \(A\)', color='green'\)) Tj
T*
(ax1_twin.tick_params\(axis='y', labelcolor='green'\)) Tj
T*
(ax1.set_title\('AC Voltage and Current Waveforms', fontweight='bold'\)) Tj
T*
(ax1.grid\(True, alpha=0.4\)) Tj
T*
() Tj
T*
(# Lower Plot: Instantaneous Power) Tj
T*
(ax2.plot\(t * 1000, p / 1000, 'r-', label='Power p\(t\) [kW]'\)) Tj
T*
(ax2.axhline\(y=np.mean\(p\) / 1000, color='black', linestyle='--', label=f'Average Power:) Tj
T*
({np.mean\(p\)/1000:.2f} kW'\)) Tj
T*
(ax2.set_title\('Instantaneous Power Dissipation', fontweight='bold'\)) Tj
T*
(ax2.set_xlabel\('Time \(milliseconds\)'\)) Tj
T*
(ax2.set_ylabel\('Power \(kW\)'\)) Tj
T*
(ax2.grid\(True, alpha=0.4\)) Tj
T*
(ax2.legend\(\)) Tj
T*
() Tj
T*
(plt.tight_layout\(\)) Tj
T*
(print\('Dual subplot dashboard generated successfully.'\)) Tj
T*
() Tj
T*
() Tj
T*
/F2 9.5 Tf
(-----------------------------------------------------------------------------------------) Tj
T*
