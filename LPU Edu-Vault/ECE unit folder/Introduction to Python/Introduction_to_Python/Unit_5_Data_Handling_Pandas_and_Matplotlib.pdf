(batch_samples = np.random.normal\(loc=10000, scale=120, size=10000\)) Tj
T*
() Tj
T*
(df_batch = pd.DataFrame\(batch_samples, columns=['Resistance_Ohms']\)) Tj
T*
() Tj
T*
(# Quality Control Limits \(+/- 2% of nominal 10,000 Ohm -> [9800, 10200]\)) Tj
T*
(in_tolerance = df_batch[\(df_batch['Resistance_Ohms'] >= 9800\) &) Tj
T*
(\(df_batch['Resistance_Ohms'] <= 10200\)]) Tj
T*
(yield_percentage = \(len\(in_tolerance\) / len\(df_batch\)\) * 100.0) Tj
T*
() Tj
T*
(print\(f'Total Resistor Batch Size : {len\(df_batch\)}'\)) Tj
T*
(print\(f'Batch Mean Resistance : {df_batch['Resistance_Ohms'].mean\(\):.2f} Ohms'\)) Tj
T*
(print\(f'Batch Standard Deviation : {df_batch['Resistance_Ohms'].std\(\):.2f} Ohms'\)) Tj
T*
(print\(f'Manufacturing Yield \(+/-2%\): {yield_percentage:.2f} %'\)) Tj
T*
