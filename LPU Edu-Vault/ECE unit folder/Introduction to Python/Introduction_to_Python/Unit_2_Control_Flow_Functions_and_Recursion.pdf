([PROGRAM 4: Functional Sensor Calibration Pipeline using Map & Filter]) Tj
T*
/F1 9 Tf
/F2 9.5 Tf
(-----------------------------------------------------------------------------------------) Tj
T*
/F1 9 Tf
(Problem Context: Filter out out-of-bounds electrical noise from an ADC reading stream) Tj
T*
(and calibrate raw integers into physical temperature readings using functional) Tj
T*
(programming.) Tj
T*
(Python Source Code:) Tj
T*
(raw_adc_readings = [12, 105, 340, 1025, 512, -4, 780, 2048, 420]) Tj
T*
() Tj
T*
(# 1. Filter valid 10-bit ADC range [0 to 1023]) Tj
T*
(valid_readings = list\(filter\(lambda x: 0 <= x <= 1023, raw_adc_readings\)\)) Tj
T*
() Tj
T*
(# 2. Map ADC reading to Voltage: V = \(ADC / 1023\) * 5.0 Volts) Tj
T*
(voltages = list\(map\(lambda adc: round\(\(adc / 1023.0\) * 5.0, 3\), valid_readings\)\)) Tj
T*
() Tj
T*
(# 3. Map Voltage to Temperature \(LM35 sensor: 10 mV/C -> T = V / 0.010\)) Tj
T*
(temperatures = list\(map\(lambda v: round\(v / 0.010, 1\), voltages\)\)) Tj
T*
() Tj
T*
(print\('Raw ADC Stream :', raw_adc_readings\)) Tj
T*
(print\('Filtered ADC Values :', valid_readings\)) Tj
T*
(print\('Calibrated Voltages :', voltages\)) Tj
T*
(print\('Final Temperatures C:', temperatures\)) Tj
T*
