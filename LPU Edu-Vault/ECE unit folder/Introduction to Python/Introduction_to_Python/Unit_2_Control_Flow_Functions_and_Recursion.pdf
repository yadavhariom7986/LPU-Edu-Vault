(for i in range\(2, int\(num**0.5\) + 1\):) Tj
T*
(if num % i == 0:) Tj
T*
(break) Tj
T*
(else:) Tj
T*
(# Executes only if loop completed without break) Tj
T*
(primes.append\(num\)) Tj
T*
(return primes) Tj
T*
() Tj
T*
(def prime_factorization\(n\):) Tj
T*
(factors = []) Tj
T*
(d = 2) Tj
T*
(while d * d <= n:) Tj
T*
(while n % d == 0:) Tj
T*
(factors.append\(d\)) Tj
T*
(n //= d) Tj
T*
(d += 1) Tj
T*
(if n > 1:) Tj
T*
(factors.append\(n\)) Tj
T*
(return factors) Tj
T*
() Tj
T*
(print\('Primes between 20 and 60:', find_primes_in_range\(20, 60\)\)) Tj
T*
(print\('Prime factors of 840:', prime_factorization\(840\)\)) Tj
T*
() Tj
T*
() Tj
