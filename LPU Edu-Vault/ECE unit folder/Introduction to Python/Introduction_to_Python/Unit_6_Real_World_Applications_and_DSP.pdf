T*
(rx_corrupt_payload = corrupted_packet[:-2]) Tj
T*
(rx_corrupt_crc = int.from_bytes\(corrupted_packet[-2:], byteorder='big'\)) Tj
T*
(is_corrupt_clean = \(rx_corrupt_crc == compute_crc16_ccitt\(rx_corrupt_payload\)\)) Tj
T*
(print\(f'Corrupted Bit Test : REJECTED={not is_corrupt_clean} \(Error detected cleanly!\)'\)) Tj
T*
