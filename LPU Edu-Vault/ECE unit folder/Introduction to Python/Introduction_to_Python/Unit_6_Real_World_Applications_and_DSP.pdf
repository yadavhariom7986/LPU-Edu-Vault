/F1 9 Tf
/F2 9.5 Tf
([PROGRAM 1: Non-Linear Diode Circuit Operating Point via Newton-Raphson]) Tj
T*
/F1 9 Tf
/F2 9.5 Tf
(-----------------------------------------------------------------------------------------) Tj
T*
/F1 9 Tf
(Problem Context: Solve for the exact quiescent diode voltage V_D in a series circuit) Tj
T*
(with battery V_S = 5.0 V, resistor R = 1.0 kOhm, and a Silicon diode \(Shockley) Tj
T*
(parameters: I_S = 1e-14 A, thermal voltage V_T = 0.026 V\).) Tj
T*
(Python Source Code:) Tj
T*
(import math) Tj
T*
() Tj
T*
(def solve_diode_operating_point\(v_s, r, i_s=1e-14, v_t=0.026, tol=1e-7, max_iter=100\):) Tj
T*
(# Circuit KVL: f\(V_D\) = \(V_S - V_D\) / R - I_S * \(exp\(V_D / V_T\) - 1\) = 0) Tj
T*
(# Derivative: f'\(V_D\) = -1/R - \(I_S / V_T\) * exp\(V_D / V_T\)) Tj
T*
() Tj
T*
(v_d = 0.7 # Initial engineering guess for silicon diode) Tj
T*
(for i in range\(max_iter\):) Tj
T*
(f_val = \(v_s - v_d\) / r - i_s * \(math.exp\(v_d / v_t\) - 1\)) Tj
T*
(f_prime = -1.0 / r - \(i_s / v_t\) * math.exp\(v_d / v_t\)) Tj
T*
() Tj
T*
(delta = f_val / f_prime) Tj
T*
(v_d_new = v_d - delta) Tj
T*
() Tj
T*
(if abs\(v_d_new - v_d\) < tol:) Tj
T*
(current_ma = \(\(v_s - v_d_new\) / r\) * 1000.0) Tj
T*
(return v_d_new, current_ma, i + 1) Tj
T*
(v_d = v_d_new) Tj
T*
(raise RuntimeError\('Newton-Raphson failed to converge'\)) Tj
T*
() Tj
T*
(vd, id_ma, iterations = solve_diode_operating_point\(v_s=5.0, r=1000.0\)) Tj
T*
(print\(f'Newton-Raphson Converged in {iterations} iterations:'\)) Tj
T*
(print\(f' Diode Forward Voltage \(V_D\) : {vd:.6f} Volts'\)) Tj
T*
(print\(f' Circuit Current \(I_D\) : {id_ma:.6f} mA'\)) Tj
T*
() Tj
T*
() Tj
T*
/F2 9.5 Tf
(-----------------------------------------------------------------------------------------) Tj
T*
/F1 9 Tf
/F2 9.5 Tf
