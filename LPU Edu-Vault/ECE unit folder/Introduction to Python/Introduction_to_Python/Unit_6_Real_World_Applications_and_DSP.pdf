(# Composite dual-tone signal with added white noise) Tj
T*
(signal_clean = 2.0 * np.sin\(2 * np.pi * 500 * t\) + 1.2 * np.sin\(2 * np.pi * 1200 * t\)) Tj
T*
(np.random.seed\(42\)) Tj
T*
(noise = np.random.normal\(0, 0.8, size=n_samples\)) Tj
T*
(signal_noisy = signal_clean + noise) Tj
T*
() Tj
T*
(# Compute Fast Fourier Transform \(FFT\)) Tj
T*
(fft_complex = np.fft.fft\(signal_noisy\)) Tj
T*
(fft_magnitude = \(2.0 / n_samples\) * np.abs\(fft_complex[:n_samples // 2]\)) Tj
T*
(frequencies = np.fft.fftfreq\(n_samples, 1.0 / f_s\)[:n_samples // 2]) Tj
T*
() Tj
T*
(# Identify top 2 frequency peaks) Tj
T*
(peak_indices = np.argsort\(fft_magnitude\)[-2:][::-1]) Tj
T*
(print\('FFT Dominant Frequency Detection:'\)) Tj
T*
(for idx in peak_indices:) Tj
T*
(print\(f' Detected Peak: {frequencies[idx]:7.1f} Hz \(Amplitude:) Tj
T*
({fft_magnitude[idx]:.2f}\)'\)) Tj
T*
() Tj
T*
() Tj
T*
/F2 9.5 Tf
(-----------------------------------------------------------------------------------------) Tj
T*
/F1 9 Tf
/F2 9.5 Tf
([PROGRAM 4: End-to-End CRC-16 Communication Packet Verifier]) Tj
T*
/F1 9 Tf
/F2 9.5 Tf
(-----------------------------------------------------------------------------------------) Tj
T*
/F1 9 Tf
(Problem Context: Implement a complete serial transmitter and receiver module that) Tj
T*
(computes CRC-16 \(CCITT standard: polynomial 0x1021\) to detect transmission errors.) Tj
T*
(Python Source Code:) Tj
T*
(def compute_crc16_ccitt\(data_bytes\):) Tj
T*
(crc = 0xFFFF) Tj
T*
(for byte in data_bytes:) Tj
T*
(crc ^= \(byte << 8\)) Tj
T*
(for _ in range\(8\):) Tj
T*
(if crc & 0x8000:) Tj
T*
(crc = \(\(crc << 1\) ^ 0x1021\) & 0xFFFF) Tj
T*
(else:) Tj
T*
(crc = \(crc << 1\) & 0xFFFF) Tj
T*
(return crc) Tj
T*
() Tj
T*
(# 1. Transmitter Side: Prepare packet and append CRC-16) Tj
T*
(payload = b"CMD_MOTOR_ON_SPEED_1500") Tj
T*
(crc_tx = compute_crc16_ccitt\(payload\)) Tj
T*
(transmitted_packet = payload + crc_tx.to_bytes\(2, byteorder='big'\)) Tj
T*
() Tj
T*
(# 2. Receiver Side \(Uncorrupted Packet\):) Tj
T*
(rx_payload = transmitted_packet[:-2]) Tj
T*
(rx_crc_claimed = int.from_bytes\(transmitted_packet[-2:], byteorder='big'\)) Tj
T*
(rx_crc_calc = compute_crc16_ccitt\(rx_payload\)) Tj
T*
(is_clean = \(rx_crc_claimed == rx_crc_calc\)) Tj
T*
ET

endstream
