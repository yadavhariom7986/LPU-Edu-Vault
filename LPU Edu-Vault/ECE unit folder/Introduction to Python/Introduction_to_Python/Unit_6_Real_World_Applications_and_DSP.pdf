45 780 Td
(over half a cycle \(0 to 10 ms\).) Tj
T*
(Python Source Code:) Tj
T*
(import math) Tj
T*
() Tj
T*
(def simpson_energy\(r, duration, n_intervals=100\):) Tj
T*
(if n_intervals % 2 != 0:) Tj
T*
(n_intervals += 1 # Simpson's rule mandates even number of intervals) Tj
T*
() Tj
T*
(h = duration / n_intervals) Tj
T*
() Tj
T*
(# Power function: p\(t\) = i\(t\)^2 * R) Tj
T*
(def p\(t\):) Tj
T*
(i = 10.0 * math.sin\(100.0 * math.pi * t\)) Tj
T*
(return \(i**2\) * r) Tj
T*
() Tj
T*
(# Simpson's 1/3 integration summation) Tj
T*
(sum_val = p\(0\) + p\(duration\)) Tj
T*
(for i in range\(1, n_intervals\):) Tj
T*
(t_i = i * h) Tj
T*
(weight = 4 if \(i % 2 != 0\) else 2) Tj
T*
(sum_val += weight * p\(t_i\)) Tj
T*
() Tj
T*
(energy_joules = \(h / 3.0\) * sum_val) Tj
T*
(return energy_joules) Tj
T*
() Tj
T*
(duration_s = 0.010 # 10 milliseconds) Tj
T*
(e_numeric = simpson_energy\(r=5.0, duration=duration_s, n_intervals=200\)) Tj
T*
(# Analytical check: Integral_0^0.01 [ 500 * sin^2\(100 pi t\) dt ] = 500 * \(0.01 / 2\) =) Tj
T*
(2.5 Joules) Tj
T*
(print\(f'Total Energy Dissipated \(Simpson 1/3\) : {e_numeric:.6f} Joules'\)) Tj
T*
(print\(f'Exact Analytical Integration Value : 2.500000 Joules'\)) Tj
T*
() Tj
T*
() Tj
T*
