([PROGRAM 1: Prime Number Verification and Sieve of Eratosthenes]) Tj
T*
/F1 9 Tf
/F2 9.5 Tf
(-----------------------------------------------------------------------------------------) Tj
T*
/F1 9 Tf
(Problem: Write an optimized C program to: \(1\) Verify if a given integer N is prime in) Tj
T*
(O\(sqrt\(N\)\) time, \(2\) Generate all prime numbers up to limit M using Sieve of) Tj
T*
(Eratosthenes.) Tj
T*
(Source Code:) Tj
T*
(#include <stdio.h>) Tj
T*
(#include <stdbool.h>) Tj
T*
(#include <string.h>) Tj
T*
(bool isPrime\(int n\) {) Tj
T*
(if \(n <= 1\) return false;) Tj
T*
(if \(n <= 3\) return true;) Tj
T*
(if \(n % 2 == 0 || n % 3 == 0\) return false;) Tj
T*
(for \(int i = 5; i * i <= n; i += 6\) {) Tj
T*
(if \(n % i == 0 || n % \(i + 2\) == 0\)) Tj
T*
(return false;) Tj
T*
(}) Tj
T*
(return true;) Tj
T*
(}) Tj
T*
(void sieveOfEratosthenes\(int limit\) {) Tj
T*
(bool prime[limit + 1];) Tj
T*
(memset\(prime, true, sizeof\(prime\)\);) Tj
T*
(for \(int p = 2; p * p <= limit; p++\) {) Tj
T*
(if \(prime[p] == true\) {) Tj
T*
(for \(int i = p * p; i <= limit; i += p\)) Tj
T*
(prime[i] = false;) Tj
T*
(}) Tj
T*
(}) Tj
T*
(printf\("Primes up to %d: ", limit\);) Tj
T*
(for \(int p = 2; p <= limit; p++\)) Tj
T*
(if \(prime[p]\) printf\("%d ", p\);) Tj
T*
(printf\("\\n"\);) Tj
T*
(}) Tj
T*
(int main\(\) {) Tj
T*
(int testVal = 29;) Tj
T*
(printf\("%d is %s\\n", testVal, isPrime\(testVal\) ? "PRIME" : "COMPOSITE"\);) Tj
T*
(sieveOfEratosthenes\(30\);) Tj
T*
(return 0;) Tj
T*
(}) Tj
T*
