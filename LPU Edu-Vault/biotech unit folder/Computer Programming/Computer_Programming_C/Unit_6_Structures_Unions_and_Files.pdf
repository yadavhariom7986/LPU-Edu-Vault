([PROGRAM 1: Structure Alignment and Padding Demonstration]) Tj
T*
/F1 9 Tf
/F2 9.5 Tf
(-----------------------------------------------------------------------------------------) Tj
T*
/F1 9 Tf
(Problem: Write an ANSI C program to demonstrate structure padding, compare struct vs.) Tj
T*
(union memory footprints, and prove that union members share memory.) Tj
T*
(Source Code:) Tj
T*
(#include <stdio.h>) Tj
T*
(struct UnpaddedStruct {) Tj
T*
(char c; /* 1 byte + 3 bytes padding */) Tj
T*
(int i; /* 4 bytes */) Tj
T*
(short s; /* 2 bytes + 2 bytes padding */) Tj
T*
(}; /* Total = 12 bytes on 32/64-bit systems */) Tj
T*
(union SharedMemory {) Tj
T*
(int intVal;) Tj
T*
(float floatVal;) Tj
T*
(char str[4];) Tj
T*
(}; /* Total = 4 bytes \(size of largest member\) */) Tj
T*
(int main\(\) {) Tj
T*
(printf\("Size of UnpaddedStruct: %zu bytes \(Sum of members = 1+4+2 = 7 bytes\)\\n",) Tj
T*
(sizeof\(struct UnpaddedStruct\)\);) Tj
T*
(printf\("Size of SharedMemory Union: %zu bytes\\n", sizeof\(union SharedMemory\)\);) Tj
T*
(union SharedMemory u;) Tj
T*
(u.intVal = 0x41424344;) Tj
T*
(printf\("Union intVal = 0x%X\\n", u.intVal\);) Tj
T*
(printf\("Union as chars: %c %c %c %c\\n", u.str[0], u.str[1], u.str[2], u.str[3]\);) Tj
T*
(return 0;) Tj
T*
(}) Tj
T*
(Output:) Tj
T*
(Size of UnpaddedStruct: 12 bytes \(Sum of members = 1+4+2 = 7 bytes\)) Tj
T*
(Size of SharedMemory Union: 4 bytes) Tj
T*
(Union intVal = 0x41424344) Tj
T*
(Union as chars: D C B A) Tj
T*
() Tj
T*
() Tj
T*
