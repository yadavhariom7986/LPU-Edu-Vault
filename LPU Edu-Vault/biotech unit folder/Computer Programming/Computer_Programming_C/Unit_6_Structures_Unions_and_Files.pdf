(#include <stdio.h>) Tj
T*
(#define LOG_INT\(var\) printf\("[DEBUG] Variable '" #var "' has value: %d\\n", var\)) Tj
T*
(#define CREATE_PAIR\(type, name\) type name##_first; type name##_second) Tj
T*
(#define SAFE_DIV\(a, b\) \(\(b\) != 0 ? \(\(a\) / \(b\)\) : 0\)) Tj
T*
(int main\(\) {) Tj
T*
(int voltage = 230;) Tj
T*
(LOG_INT\(voltage\);) Tj
T*
