T*
/F1 9 Tf
/F2 9.5 Tf
(-----------------------------------------------------------------------------------------) Tj
T*
/F1 9 Tf
(Problem: Write a program that writes alphabet 'A' through 'Z' to a file, then uses) Tj
T*
(fseek\(\) and ftell\(\) to read characters at specific byte offsets randomly.) Tj
T*
(Source Code:) Tj
T*
(#include <stdio.h>) Tj
T*
(int main\(\) {) Tj
T*
(FILE *fp = fopen\("alphabet.txt", "w+"\);) Tj
T*
(if \(!fp\) return 1;) Tj
T*
(for \(char c = 'A'; c <= 'Z'; c++\) fputc\(c, fp\);) Tj
T*
(fseek\(fp, 0, SEEK_END\);) Tj
T*
(long fileSize = ftell\(fp\);) Tj
T*
(printf\("Total file size: %ld bytes\\n", fileSize\);) Tj
T*
(fseek\(fp, 0, SEEK_SET\);) Tj
T*
(printf\("Position 0: %c\\n", fgetc\(fp\)\);) Tj
T*
(fseek\(fp, 4, SEEK_SET\);) Tj
T*
(printf\("Position 4: %c\\n", fgetc\(fp\)\);) Tj
T*
(fseek\(fp, -5, SEEK_END\);) Tj
T*
(printf\("5 bytes from end: %c\\n", fgetc\(fp\)\);) Tj
T*
(fclose\(fp\);) Tj
T*
(return 0;) Tj
T*
(}) Tj
T*
