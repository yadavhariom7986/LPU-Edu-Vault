T*
/F1 9 Tf
(Problem: Write a program to: \(1\) Write an array of student records to a binary file) Tj
T*
(using fwrite\(\), \(2\) Read and display records using fread\(\).) Tj
T*
(Source Code:) Tj
T*
(#include <stdio.h>) Tj
T*
(#include <stdlib.h>) Tj
T*
(typedef struct {) Tj
T*
(int rollNo;) Tj
T*
(char name[30];) Tj
T*
(float gpa;) Tj
T*
(} Student_t;) Tj
T*
(int main\(\) {) Tj
T*
(Student_t students[2] = {) Tj
T*
({ 101, "Aarav Sharma", 8.95 },) Tj
T*
({ 102, "Diya Verma", 9.40 }) Tj
T*
(};) Tj
T*
(FILE *fp = fopen\("students.dat", "wb"\);) Tj
T*
(if \(!fp\) { printf\("File open failed!\\n"\); return 1; }) Tj
T*
(fwrite\(students, sizeof\(Student_t\), 2, fp\);) Tj
T*
(fclose\(fp\);) Tj
T*
(printf\("Records written to binary file successfully.\\n"\);) Tj
T*
(Student_t readStudents[2];) Tj
T*
(fp = fopen\("students.dat", "rb"\);) Tj
T*
(if \(!fp\) { printf\("File read failed!\\n"\); return 1; }) Tj
T*
(fread\(readStudents, sizeof\(Student_t\), 2, fp\);) Tj
T*
(fclose\(fp\);) Tj
T*
(printf\("Retrieved Records:\\n"\);) Tj
T*
(for \(int i = 0; i < 2; i++\) {) Tj
T*
(printf\(" Roll: %d | Name: %-15s | GPA: %.2f\\n", readStudents[i].rollNo,) Tj
T*
(readStudents[i].name, readStudents[i].gpa\);) Tj
T*
(}) Tj
T*
(return 0;) Tj
T*
(}) Tj
T*
(Output:) Tj
T*
(Records written to binary file successfully.) Tj
T*
(Retrieved Records:) Tj
T*
(Roll: 101 | Name: Aarav Sharma | GPA: 8.95) Tj
T*
(Roll: 102 | Name: Diya Verma | GPA: 9.40) Tj
T*
() Tj
