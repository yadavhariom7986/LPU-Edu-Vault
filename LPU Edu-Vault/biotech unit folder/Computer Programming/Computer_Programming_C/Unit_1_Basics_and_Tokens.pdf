T*
/F1 9 Tf
(Problem: Write a robust C program to compute real and complex roots of a quadratic) Tj
T*
(equation ax^2 + bx + c = 0.) Tj
T*
(Source Code:) Tj
T*
(#include <stdio.h>) Tj
T*
(#include <math.h>) Tj
T*
(int main\(\) {) Tj
T*
(double a, b, c, disc, root1, root2, realPart, imagPart;) Tj
T*
(printf\("Enter coefficients a, b, c: "\);) Tj
T*
(scanf\("%lf %lf %lf", &a, &b, &c\);) Tj
T*
(if \(a == 0.0\) {) Tj
T*
(printf\("Coefficient 'a' cannot be zero in a quadratic equation.\\n"\);) Tj
T*
(return 1;) Tj
T*
(}) Tj
T*
(disc = b * b - 4.0 * a * c;) Tj
T*
(if \(disc > 0.0\) {) Tj
T*
(root1 = \(-b + sqrt\(disc\)\) / \(2.0 * a\);) Tj
T*
(root2 = \(-b - sqrt\(disc\)\) / \(2.0 * a\);) Tj
T*
(printf\("Roots are real and distinct: Root1 = %.4f, Root2 = %.4f\\n", root1, root2\);) Tj
T*
(} else if \(disc == 0.0\) {) Tj
T*
(root1 = -b / \(2.0 * a\);) Tj
T*
(printf\("Roots are real and equal: Root1 = Root2 = %.4f\\n", root1\);) Tj
T*
(} else {) Tj
T*
(realPart = -b / \(2.0 * a\);) Tj
T*
(imagPart = sqrt\(-disc\) / \(2.0 * a\);) Tj
T*
(printf\("Roots are complex conjugates:\\n"\);) Tj
T*
(printf\("Root1 = %.4f + %.4fi\\n", realPart, imagPart\);) Tj
T*
(printf\("Root2 = %.4f - %.4fi\\n", realPart, imagPart\);) Tj
T*
(}) Tj
T*
(return 0;) Tj
T*
(}) Tj
T*
