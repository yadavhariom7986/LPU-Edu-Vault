(   [Problem Statement]: Write a Python script implementing the Binary Search algorithm recursively on a sorted array of sensor frequencies.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   Recursive Binary Search implementation:) Tj
T*
() Tj
T*
(   ```python) Tj
T*
(   def binary_search_recursive\(arr, target, low, high\):) Tj
T*
(   if low > high: # Base case: element not found) Tj
T*
(   return -1) Tj
T*
() Tj
T*
(   mid = \(low + high\) // 2) Tj
T*
(   if arr[mid] == target: # Base case: found match) Tj
T*
(   return mid) Tj
T*
(   elif arr[mid] > target:) Tj
T*
(   return binary_search_recursive\(arr, target, low, mid - 1\)) Tj
T*
(   else:) Tj
T*
(   return binary_search_recursive\(arr, target, mid + 1, high\)) Tj
T*
() Tj
T*
(   frequencies = [100, 250, 500, 1000, 2500, 5000, 10000, 25000]) Tj
T*
(   target_f = 5000) Tj
T*
(   idx = binary_search_recursive\(frequencies, target_f, 0, len\(frequencies\) - 1\)) Tj
T*
(   print\(f'Frequency {target_f} Hz located at index: {idx}'\)) Tj
T*
(   ```) Tj
T*
() Tj
