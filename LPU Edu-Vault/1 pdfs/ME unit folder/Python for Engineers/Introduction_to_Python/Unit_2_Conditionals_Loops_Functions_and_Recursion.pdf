T*
(   def make_pid_controller\(kp, ki, kd\):) Tj
T*
(   integral_error = 0.0 # Enclosed state) Tj
T*
(   def compute\(error, dt\):) Tj
T*
(   nonlocal integral_error # Modifies outer variable) Tj
T*
(   integral_error += error * dt) Tj
T*
(   return kp * error + ki * integral_error) Tj
T*
(   return compute) Tj
T*
(   ```) Tj
