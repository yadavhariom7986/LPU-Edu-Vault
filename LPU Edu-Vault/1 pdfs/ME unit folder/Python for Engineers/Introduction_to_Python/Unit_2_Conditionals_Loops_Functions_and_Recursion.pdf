(   [Problem Statement]: Demonstrate how to author a custom Retry Decorator in Python with configurable attempts and backoff delay for flaky network hardware.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   Authoring a robust retry decorator:) Tj
T*
() Tj
T*
(   ```python) Tj
T*
(   import time) Tj
T*
(   from functools import wraps) Tj
T*
() Tj
T*
(   def retry_on_failure\(max_retries=3, delay_sec=1.0\):) Tj
T*
(   def decorator\(func\):) Tj
T*
(   @wraps\(func\)) Tj
T*
(   def wrapper\(*args, **kwargs\):) Tj
T*
(   attempts = 0) Tj
T*
(   while attempts < max_retries:) Tj
T*
(   try:) Tj
T*
(   return func\(*args, **kwargs\)) Tj
T*
(   except Exception as err:) Tj
T*
(   attempts += 1) Tj
T*
(   print\(f'Attempt {attempts} failed: {err}. Retrying in {delay_sec}s...'\)) Tj
T*
(   time.sleep\(delay_sec\)) Tj
T*
(   if attempts == max_retries:) Tj
T*
(   raise err) Tj
T*
(   return wrapper) Tj
T*
(   return decorator) Tj
T*
() Tj
T*
(   # Usage on an instrument connection function) Tj
T*
(   @retry_on_failure\(max_retries=3, delay_sec=0.1\)) Tj
T*
(   def connect_oscilloscope\(ip\):) Tj
T*
(   print\(f'Connecting to instrument at {ip}...'\)) Tj
T*
(   return True) Tj
T*
(   ```) Tj
T*
() Tj
T*
(--------------------------------------------------------------------------------) Tj
T*
() Tj
T*
