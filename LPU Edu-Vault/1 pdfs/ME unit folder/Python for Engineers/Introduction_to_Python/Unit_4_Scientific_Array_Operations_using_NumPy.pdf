(   y = z - H @ x_pred # Innovation residual) Tj
T*
(   x_new = x_pred + K @ y) Tj
T*
(   P_new = \(np.eye\(2\) - K @ H\) @ P_pred) Tj
T*
(   return x_new, P_new) Tj
T*
