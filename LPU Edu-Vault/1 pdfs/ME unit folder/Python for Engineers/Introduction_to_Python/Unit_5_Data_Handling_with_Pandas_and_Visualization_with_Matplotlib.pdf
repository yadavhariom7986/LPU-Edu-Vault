(   # 3. Handle outliers using IQR thresholding per node) Tj
T*
(   def remove_iqr_outliers\(group\):) Tj
T*
(   q25 = group['raw_val'].quantile\(0.25\)) Tj
T*
(   q75 = group['raw_val'].quantile\(0.75\)) Tj
T*
(   iqr = q75 - q25) Tj
T*
(   valid_mask = \(group['raw_val'] >= q25 - 1.5 * iqr\) & \(group['raw_val'] <= q75 + 1.5 * iqr\)) Tj
T*
(   group.loc[~valid_mask, 'raw_val'] = np.nan) Tj
T*
(   return group) Tj
T*
() Tj
T*
(   df = df.groupby\('node_id', group_keys=False\).apply\(remove_iqr_outliers\)) Tj
T*
() Tj
T*
(   # 4. Interpolate missing values) Tj
T*
(   df['calibrated_temp'] = df.groupby\('node_id'\)['raw_val'].transform\() Tj
T*
(   lambda s: s.interpolate\(method='time'\).ffill\(\).bfill\(\)) Tj
T*
(   \) * 0.01 - 50.0 # Linear calibration formula) Tj
T*
() Tj
T*
(   return df) Tj
T*
