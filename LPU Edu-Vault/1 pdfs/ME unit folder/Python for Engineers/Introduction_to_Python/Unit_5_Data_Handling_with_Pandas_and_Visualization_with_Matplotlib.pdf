(   [Problem Statement]: Explain how to plot 3D surface and wireframe plots in Matplotlib using `mpl_toolkits.mplot3d` for antenna beam patterns.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   3D Surface Visualization:) Tj
T*
() Tj
T*
(   ```python) Tj
T*
(   import matplotlib.pyplot as plt) Tj
T*
(   from mpl_toolkits.mplot3d import Axes3D) Tj
T*
(   import numpy as np) Tj
T*
() Tj
T*
(   theta = np.linspace\(0, np.pi, 100\)) Tj
T*
(   phi = np.linspace\(0, 2 * np.pi, 100\)) Tj
T*
(   THETA, PHI = np.meshgrid\(theta, phi\)) Tj
T*
() Tj
T*
(   # Dipole antenna radiation pattern: r\(theta\) = sin^2\(theta\)) Tj
T*
(   R = np.sin\(THETA\)**2) Tj
T*
(   X = R * np.sin\(THETA\) * np.cos\(PHI\)) Tj
T*
(   Y = R * np.sin\(THETA\) * np.sin\(PHI\)) Tj
T*
(   Z = R * np.cos\(THETA\)) Tj
T*
() Tj
T*
(   fig = plt.figure\(figsize=\(8, 7\)\)) Tj
T*
(   ax = fig.add_subplot\(111, projection='3d'\)) Tj
T*
(   surf = ax.plot_surface\(X, Y, Z, cmap='plasma', edgecolor='none'\)) Tj
T*
(   ax.set_title\('Dipole Antenna 3D Radiation Pattern'\)) Tj
T*
(   fig.colorbar\(surf, ax=ax, shrink=0.5\)) Tj
T*
(   ```) Tj
