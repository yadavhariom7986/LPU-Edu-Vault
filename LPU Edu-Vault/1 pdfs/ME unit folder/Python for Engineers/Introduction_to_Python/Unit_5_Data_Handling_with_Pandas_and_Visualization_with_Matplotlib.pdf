(   [Problem Statement]: Demonstrate plotting twin axes \(`ax.twinx\(\)`\) for dual-parameter engineering plots with distinct units and scales.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   Dual-Axis Plotting in Electrical Engineering:) Tj
T*
() Tj
T*
(   ```python) Tj
T*
(   import matplotlib.pyplot as plt) Tj
T*
(   import numpy as np) Tj
T*
() Tj
T*
(   t = np.linspace\(0, 0.02, 1000\) # 20 ms \(50 Hz cycle\)) Tj
T*
(   voltage = 230 * np.sqrt\(2\) * np.sin\(2 * np.pi * 50 * t\)) Tj
T*
(   current = 10 * np.sqrt\(2\) * np.sin\(2 * np.pi * 50 * t - np.pi/6\) # Lagging PF) Tj
T*
() Tj
T*
(   fig, ax1 = plt.subplots\(figsize=\(10, 5\)\)) Tj
T*
() Tj
T*
(   # Primary axis: Voltage \(Volts\)) Tj
T*
(   color = 'tab:blue') Tj
T*
(   ax1.set_xlabel\('Time \(seconds\)'\)) Tj
T*
(   ax1.set_ylabel\('Voltage \(V\)', color=color\)) Tj
T*
(   l1, = ax1.plot\(t, voltage, color=color, linewidth=2, label='Line Voltage'\)) Tj
T*
(   ax1.tick_params\(axis='y', labelcolor=color\)) Tj
T*
(   ax1.grid\(True, linestyle=':'\)) Tj
T*
() Tj
T*
(   # Secondary twin axis sharing x: Current \(Amperes\)) Tj
T*
(   ax2 = ax1.twinx\(\)) Tj
T*
(   color = 'tab:red') Tj
T*
(   ax2.set_ylabel\('Current \(A\)', color=color\)) Tj
T*
(   l2, = ax2.plot\(t, current, color=color, linewidth=2, linestyle='--', label='Load Current'\)) Tj
T*
(   ax2.tick_params\(axis='y', labelcolor=color\)) Tj
T*
() Tj
T*
(   # Combine legends from both axes) Tj
T*
(   fig.legend\(handles=[l1, l2], loc='upper right'\)) Tj
T*
ET

