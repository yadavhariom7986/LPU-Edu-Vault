T*
() Tj
T*
(   ```python) Tj
T*
(   import matplotlib.pyplot as plt) Tj
T*
(   from matplotlib.colors import LinearSegmentedColormap) Tj
T*
(   import numpy as np) Tj
T*
() Tj
T*
(   # Define thermal palette: Black -> Blue -> Cyan -> Yellow -> White) Tj
T*
(   thermal_colors = [\(0, 0, 0\), \(0, 0, 0.8\), \(0, 0.8, 0.8\), \(1, 1, 0\), \(1, 1, 1\)]) Tj
T*
(   thermal_cmap = LinearSegmentedColormap.from_list\('ThermalCam', thermal_colors, N=256\)) Tj
T*
() Tj
T*
