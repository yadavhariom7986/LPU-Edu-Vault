(   [Problem Statement]: Explain how to construct a complete Bode Plot in Matplotlib showing Magnitude in dB and Phase in degrees.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   Bode Frequency Response Plot Construction:) Tj
T*
() Tj
T*
(   ```python) Tj
T*
(   import matplotlib.pyplot as plt) Tj
T*
(   import numpy as np) Tj
T*
() Tj
T*
(   # Transfer function H\(s\) = 1 / \(1 + s*RC\) for low-pass RC filter) Tj
T*
(   fc = 1000.0 # 1 kHz cutoff) Tj
T*
(   freq = np.logspace\(1, 6, 1000\) # 10 Hz to 1 MHz) Tj
T*
(   omega = 2 * np.pi * freq) Tj
T*
(   H = 1.0 / \(1.0 + 1j * \(freq / fc\)\)) Tj
T*
() Tj
T*
(   mag_db = 20 * np.log10\(np.abs\(H\)\)) Tj
T*
(   phase_deg = np.angle\(H, deg=True\)) Tj
T*
() Tj
T*
(   fig, \(ax_mag, ax_phase\) = plt.subplots\(2, 1, figsize=\(8, 7\), sharex=True\)) Tj
T*
() Tj
T*
(   # Magnitude response) Tj
T*
(   ax_mag.semilogx\(freq, mag_db, 'b', linewidth=2\)) Tj
T*
(   ax_mag.axhline\(-3, color='r', linestyle='--', label='-3 dB Cutoff'\)) Tj
T*
(   ax_mag.set_ylabel\('Magnitude \(dB\)'\)) Tj
T*
(   ax_mag.grid\(True, which='both', linestyle=':'\)) Tj
T*
(   ax_mag.legend\(\)) Tj
T*
() Tj
T*
(   # Phase response) Tj
T*
(   ax_phase.semilogx\(freq, phase_deg, 'g', linewidth=2\)) Tj
T*
(   ax_phase.axhline\(-45, color='r', linestyle='--', label='-45 deg at fc'\)) Tj
T*
(   ax_phase.set_xlabel\('Frequency \(Hz\)'\)) Tj
T*
(   ax_phase.set_ylabel\('Phase \(degrees\)'\)) Tj
T*
(   ax_phase.grid\(True, which='both', linestyle=':'\)) Tj
T*
(   ax_phase.legend\(\)) Tj
T*
(   ```) Tj
T*
() Tj
T*
(--------------------------------------------------------------------------------) Tj
T*
() Tj
T*
ET
