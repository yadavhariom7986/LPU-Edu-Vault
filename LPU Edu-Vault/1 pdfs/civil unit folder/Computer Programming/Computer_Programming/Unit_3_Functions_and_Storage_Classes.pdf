12.5 TL
(   [Problem Statement]: Write an ANSI C program to solve the Tower of Hanoi problem recursively, detailing mathematical complexity and move proofs.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   Tower of Hanoi Problem: Recursive Solution and Complexity:) Tj
T*
(   1. Problem Formulation:) Tj
T*
(   Three pegs: Source \(A\), Destination \(C\), and Auxiliary \(B\).) Tj
T*
(   Objective: Transfer N disks from peg A to peg C under rules:) Tj
T*
(   - Rule 1: Only one disk can be moved at a time.) Tj
T*
(   - Rule 2: Each move consists of taking the upper disk from one peg and placing it atop another.) Tj
T*
(   - Rule 3: No disk may be placed on top of a smaller disk.) Tj
T*
() Tj
T*
(   2. Recursive Divide-and-Conquer Strategy:) Tj
T*
(   To move N disks from Source to Destination using Auxiliary:) Tj
T*
(   Step 1: Move top \(N - 1\) disks from Source to Auxiliary \(using Destination as temporary peg\).) Tj
T*
(   Step 2: Move the single largest disk N directly from Source to Destination.) Tj
T*
(   Step 3: Move the \(N - 1\) disks from Auxiliary to Destination \(using Source as temporary peg\).) Tj
T*
() Tj
T*
(   3. Mathematical Recurrence and Proof:) Tj
T*
(   T\(1\) = 1 move) Tj
T*
(   T\(N\) = 2 * T\(N - 1\) + 1) Tj
T*
(   Expansion:) Tj
T*
(   T\(N\) = 2*\(2*T\(N-2\) + 1\) + 1 = 4*T\(N-2\) + 2 + 1 = 2^\(N-1\) + ... + 2 + 1 = 2^N - 1.) Tj
T*
(   Total moves required: exactly \(2^N - 1\).) Tj
T*
(   Time Complexity: O\(2^N\) exponential time. Space Complexity: O\(N\) call stack depth.) Tj
T*
() Tj
T*
(   4. Complete ANSI C Source Code:) Tj
T*
(   #include <stdio.h>) Tj
T*
() Tj
T*
(   void solve_tower_of_hanoi\(int n, char source, char dest, char aux, int *move_counter\) {) Tj
T*
(   if \(n == 1\) {) Tj
T*
(   \(*move_counter\)++;) Tj
T*
(   printf\("Move %2d: Transfer Disk 1 from Peg %c -> Peg %c\\n", *move_counter, source, dest\);) Tj
T*
(   return;) Tj
T*
(   }) Tj
T*
() Tj
T*
(   /* Step 1: Move n-1 disks from Source to Aux */) Tj
T*
(   solve_tower_of_hanoi\(n - 1, source, aux, dest, move_counter\);) Tj
T*
() Tj
T*
(   /* Step 2: Move n-th disk from Source to Dest */) Tj
T*
(   \(*move_counter\)++;) Tj
T*
(   printf\("Move %2d: Transfer Disk %d from Peg %c -> Peg %c\\n", *move_counter, n, source, dest\);) Tj
T*
() Tj
T*
(   /* Step 3: Move n-1 disks from Aux to Dest */) Tj
T*
(   solve_tower_of_hanoi\(n - 1, aux, dest, source, move_counter\);) Tj
T*
(   }) Tj
T*
() Tj
T*
(   int main\(void\) {) Tj
T*
(   int disks = 3;) Tj
T*
(   int moves = 0;) Tj
T*
(   printf\("=== Tower of Hanoi \(%d Disks\) ===\\n", disks\);) Tj
T*
(   solve_tower_of_hanoi\(disks, 'A', 'C', 'B', &moves\);) Tj
T*
(   printf\("Total moves executed: %d \(Expected: %d\)\\n", moves, \(1 << disks\) - 1\);) Tj
T*
ET

