(   [Problem Statement]: Write an ANSI C program to calculate the greatest common divisor \(GCD\) using tail recursion and compare with iterative execution.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   Tail-Recursive Greatest Common Divisor \(GCD\):) Tj
T*
(   1. Mathematical Equivalence:) Tj
T*
(   The Euclidean algorithm is naturally tail-recursive:) Tj
T*
(   gcd\(a, b\) = gcd\(b, a % b\), with base case gcd\(a, 0\) = a.) Tj
T*
(   Because the recursive invocation is in pure tail position, optimizing compilers emit code) Tj
T*
(   identical to an iterative while loop!) Tj
T*
() Tj
T*
(   2. Complete ANSI C Source Code:) Tj
T*
(   #include <stdio.h>) Tj
T*
() Tj
T*
(   /* Tail-Recursive Implementation */) Tj
T*
(   unsigned long long gcd_tail\(unsigned long long a, unsigned long long b\) {) Tj
T*
(   if \(b == 0\) return a;) Tj
T*
(   return gcd_tail\(b, a % b\); /* Tail call */) Tj
T*
(   }) Tj
T*
() Tj
T*
(   /* Iterative Reference */) Tj
T*
(   unsigned long long gcd_iterative\(unsigned long long a, unsigned long long b\) {) Tj
T*
(   while \(b != 0\) {) Tj
T*
(   unsigned long long temp = a % b;) Tj
T*
(   a = b;) Tj
T*
(   b = temp;) Tj
T*
(   }) Tj
T*
(   return a;) Tj
T*
(   }) Tj
T*
() Tj
T*
(   int main\(void\) {) Tj
T*
(   unsigned long long x = 1234567890ULL, y = 98765432ULL;) Tj
T*
(   printf\("GCD Tail-Recursive: %llu\\n", gcd_tail\(x, y\)\);) Tj
T*
(   printf\("GCD Iterative: %llu\\n", gcd_iterative\(x, y\)\);) Tj
T*
(   return 0;) Tj
T*
(   }) Tj
T*
() Tj
T*
