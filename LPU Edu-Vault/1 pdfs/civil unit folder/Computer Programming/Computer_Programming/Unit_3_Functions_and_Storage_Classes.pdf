(   [Problem Statement]: Write an ANSI C program to implement a modular codon translation table converting RNA triplets into amino acid names.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   Genetic Code Codon Translation Table in C:) Tj
T*
(   1. Biological Logic:) Tj
T*
(   Messenger RNA codons consist of nucleotide base triplets translated by ribosomes into) Tj
T*
(   corresponding amino acids.) Tj
T*
(   Start Codon: AUG -> Methionine.) Tj
T*
(   Stop Codons: UAA, UAG, UGA -> Stop.) Tj
T*
() Tj
T*
(   2. Complete ANSI C Source Code:) Tj
T*
(   #include <stdio.h>) Tj
T*
(   #include <string.h>) Tj
T*
() Tj
T*
(   const char *translate_codon\(const char *triplet\) {) Tj
T*
(   if \(strcmp\(triplet, "AUG"\) == 0\) return "Methionine \(START\)";) Tj
T*
(   if \(strcmp\(triplet, "UUU"\) == 0 || strcmp\(triplet, "UUC"\) == 0\) return "Phenylalanine";) Tj
T*
(   if \(strcmp\(triplet, "UUA"\) == 0 || strcmp\(triplet, "UUG"\) == 0\) return "Leucine";) Tj
T*
(   if \(strcmp\(triplet, "UCU"\) == 0 || strcmp\(triplet, "UCC"\) == 0\) return "Serine";) Tj
T*
(   if \(strcmp\(triplet, "UAU"\) == 0 || strcmp\(triplet, "UAC"\) == 0\) return "Tyrosine";) Tj
T*
(   if \(strcmp\(triplet, "UGU"\) == 0 || strcmp\(triplet, "UGC"\) == 0\) return "Cysteine";) Tj
T*
(   if \(strcmp\(triplet, "UGG"\) == 0\) return "Tryptophan";) Tj
T*
(   if \(strcmp\(triplet, "UAA"\) == 0 || strcmp\(triplet, "UAG"\) == 0 || strcmp\(triplet, "UGA"\) == 0\)) Tj
T*
(   return "STOP CODON";) Tj
T*
(   return "Unknown/Unmapped";) Tj
T*
(   }) Tj
T*
() Tj
T*
(   int main\(void\) {) Tj
T*
(   const char *codons[] = {"AUG", "UUC", "UGG", "UAA"};) Tj
T*
(   int count = sizeof\(codons\) / sizeof\(codons[0]\);) Tj
T*
() Tj
T*
(   printf\("=== Ribosomal mRNA Translation Simulator ===\\n"\);) Tj
T*
