(   [Problem Statement]: Write an ANSI C program to reverse a string in-place using a recursive function without auxiliary string buffers.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   In-Place Recursive String Reversal:) Tj
T*
(   1. Recursive Formulation:) Tj
T*
(   - Function takes string pointer and two boundary indices: left and right.) Tj
T*
(   - Base Case: When left >= right, recursion terminates.) Tj
T*
(   - Recursive Step: Swap characters str[left] and str[right], then invoke reverse_recursive\(str,) Tj
T*
(   left + 1, right - 1\).) Tj
T*
() Tj
T*
(   2. Complete ANSI C Source Code:) Tj
T*
(   #include <stdio.h>) Tj
T*
(   #include <string.h>) Tj
T*
() Tj
T*
(   void reverse_string_recursive\(char *str, int left, int right\) {) Tj
T*
(   if \(left >= right\) return; /* Base case */) Tj
T*
() Tj
T*
(   /* Swap characters at left and right boundaries */) Tj
T*
(   char temp = str[left];) Tj
T*
(   str[left] = str[right];) Tj
T*
(   str[right] = temp;) Tj
T*
() Tj
T*
(   /* Recursive step moving boundaries inwards */) Tj
T*
(   reverse_string_recursive\(str, left + 1, right - 1\);) Tj
T*
(   }) Tj
T*
() Tj
T*
(   int main\(void\) {) Tj
T*
(   char sequence[] = "ACGT-BIOTECHNOLOGY-101";) Tj
T*
(   int len = strlen\(sequence\);) Tj
T*
() Tj
T*
(   printf\("Original Sequence: %s\\n", sequence\);) Tj
T*
(   reverse_string_recursive\(sequence, 0, len - 1\);) Tj
T*
(   printf\("Reversed Sequence: %s\\n", sequence\);) Tj
T*
() Tj
T*
(   return 0;) Tj
T*
(   }) Tj
T*
() Tj
T*
