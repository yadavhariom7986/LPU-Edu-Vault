(   [Problem Statement]: Write an ANSI C program to compute the molecular weight of an oligopeptide from an amino acid single-letter sequence string.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   Oligopeptide Molecular Mass Computation:) Tj
T*
(   1. Biophysical Constants:) Tj
T*
(   Single-letter amino acid residue weights \(condensed in peptide chain\):) Tj
T*
(   A: 71.08, C: 103.14, D: 115.09, E: 129.12, F: 147.18, G: 57.05, H: 137.14,) Tj
T*
(   I: 113.16, K: 128.17, L: 113.16, M: 131.20, N: 114.10, P: 97.12, Q: 128.13,) Tj
T*
(   R: 156.19, S: 87.08, T: 101.11, V: 99.13, W: 186.21, Y: 163.18.) Tj
T*
(   Plus 18.015 g/mol \(terminal H- and -OH water molecule\).) Tj
T*
() Tj
T*
(   2. Complete ANSI C Source Code:) Tj
T*
(   #include <stdio.h>) Tj
T*
(   #include <ctype.h>) Tj
T*
() Tj
T*
(   double get_amino_acid_mw\(char aa\) {) Tj
T*
(   switch \(toupper\(\(unsigned char\)aa\)\) {) Tj
T*
(   case 'A': return 71.08; case 'C': return 103.14; case 'D': return 115.09;) Tj
T*
(   case 'E': return 129.12; case 'F': return 147.18; case 'G': return 57.05;) Tj
T*
(   case 'H': return 137.14; case 'I': return 113.16; case 'K': return 128.17;) Tj
T*
(   case 'L': return 113.16; case 'M': return 131.20; case 'N': return 114.10;) Tj
T*
(   case 'P': return 97.12; case 'Q': return 128.13; case 'R': return 156.19;) Tj
T*
(   case 'S': return 87.08; case 'T': return 101.11; case 'V': return 99.13;) Tj
T*
(   case 'W': return 186.21; case 'Y': return 163.18;) Tj
T*
(   default: return 0.0;) Tj
T*
(   }) Tj
T*
(   }) Tj
T*
() Tj
T*
(   double compute_peptide_mw\(const char *peptide\) {) Tj
T*
(   double total_weight = 0.0;) Tj
T*
(   int residue_count = 0;) Tj
T*
() Tj
T*
(   for \(int i = 0; peptide[i] != '\\0'; i++\) {) Tj
T*
(   double w = get_amino_acid_mw\(peptide[i]\);) Tj
T*
(   if \(w > 0.0\) {) Tj
T*
(   total_weight += w;) Tj
T*
(   residue_count++;) Tj
T*
(   }) Tj
T*
(   }) Tj
T*
() Tj
T*
(   if \(residue_count == 0\) return 0.0;) Tj
T*
(   /* Add terminal water: H- \(1.008\) and -OH \(17.007\) */) Tj
T*
(   return total_weight + 18.015;) Tj
T*
(   }) Tj
T*
() Tj
T*
ET

