(   [ 1 - v -u 0 ]) Tj
T*
(   J = [ v*\(1 - w\) u*\(1 - w\) -uv ]) Tj
T*
(   [ vw uw uv ]) Tj
T*
(   Step 5: Apply column operations to simplify:) Tj
T*
(   Add Row 3 to Row 2:) Tj
T*
(   Row 2 + Row 3:) Tj
T*
(   [ v*\(1 - w\) + vw, u*\(1 - w\) + uw, -uv + uv ] = [ v, u, 0 ].) Tj
T*
(   The matrix becomes:) Tj
T*
(   [ 1 - v -u 0 ]) Tj
T*
(   J = [ v u 0 ]) Tj
T*
(   [ vw uw uv ]) Tj
T*
(   Step 6: Expand the determinant along column 3:) Tj
T*
(   det\(J\) = uv * det\([ 1 - v, -u; v, u ]\).) Tj
T*
(   Step 7: Evaluate the 2x2 determinant:) Tj
T*
(   det\([ 1 - v, -u; v, u ]\) = \(1 - v\)*u - \(-u\)*v = u - uv + uv = u.) Tj
T*
(   Step 8: Final multiplication:) Tj
T*
(   det\(J\) = uv * u = u^2 * v.) Tj
T*
(   Conclusion:) Tj
T*
(   d\(x, y, z\) / d\(u, v, w\) = u^2 * v.) Tj
T*
() Tj
T*
(--------------------------------------------------------------------------------) Tj
T*
() Tj
T*
