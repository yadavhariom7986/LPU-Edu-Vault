(   ```python) Tj
T*
(   import numpy as np) Tj
T*
(   from scipy import signal) Tj
T*
() Tj
T*
(   fs = 200000.0 # 200 kHz sampling rate) Tj
T*
(   t = np.linspace\(0, 0.01, int\(0.01 * fs\), endpoint=False\) # 10 ms) Tj
T*
() Tj
T*
(   # Message: 1 kHz tone; Carrier: 20 kHz tone) Tj
T*
(   fm, fc = 1000.0, 20000.0) Tj
T*
(   m_t = np.cos\(2 * np.pi * fm * t\)) Tj
T*
(   mu = 0.8 # Modulation index 80%) Tj
T*
(   Ac = 1.0) Tj
T*
() Tj
T*
(   # AM Double-Sideband with Carrier \(DSB-WC\)) Tj
T*
(   s_tx = Ac * \(1 + mu * m_t\) * np.cos\(2 * np.pi * fc * t\)) Tj
T*
() Tj
T*
(   # Channel AWGN: Add noise for 15 dB SNR) Tj
T*
(   p_sig = np.mean\(s_tx**2\)) Tj
T*
(   p_noise = p_sig / \(10**\(15.0 / 10.0\)\)) Tj
T*
(   noise = np.random.normal\(0, np.sqrt\(p_noise\), len\(t\)\)) Tj
T*
(   s_rx = s_tx + noise) Tj
T*
() Tj
T*
(   # Demodulation via Analytic Signal \(Hilbert Transform\)) Tj
T*
(   analytic_rx = signal.hilbert\(s_rx\)) Tj
T*
(   env_rx = np.abs\(analytic_rx\)) Tj
T*
() Tj
T*
(   # Remove DC carrier offset to reconstruct original message) Tj
T*
(   m_demod = \(env_rx - np.mean\(env_rx\)\) / \(Ac * mu\)) Tj
T*
(   ```) Tj
T*
() Tj
T*
