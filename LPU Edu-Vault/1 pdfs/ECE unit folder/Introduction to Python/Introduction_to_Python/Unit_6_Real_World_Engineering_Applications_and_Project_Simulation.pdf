T*
(   voltages = \(np.array\(raw_bytes\) - y_orig\) * y_inc) Tj
T*
(   time_axis = np.arange\(len\(voltages\)\) * x_inc) Tj
T*
() Tj
T*
(   scope.close\(\)) Tj
