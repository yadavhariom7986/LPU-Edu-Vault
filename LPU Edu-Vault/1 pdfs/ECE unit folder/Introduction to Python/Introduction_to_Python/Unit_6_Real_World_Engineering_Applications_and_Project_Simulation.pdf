(   ```python) Tj
T*
(   import pywt) Tj
T*
(   import numpy as np) Tj
T*
() Tj
T*
(   def wavelet_denoise\(signal_data, wavelet='db4', level=4, threshold=0.1\):) Tj
T*
(   # Multi-level DWT decomposition) Tj
T*
(   coeffs = pywt.wavedec\(signal_data, wavelet, level=level\)) Tj
T*
() Tj
T*
(   # Soft thresholding on high-frequency detail coefficients) Tj
T*
(   coeffs_thresh = [coeffs[0]] # Keep approximation coefficients) Tj
T*
(   for c in coeffs[1:]:) Tj
T*
(   c_t = pywt.threshold\(c, threshold, mode='soft'\)) Tj
T*
(   coeffs_thresh.append\(c_t\)) Tj
T*
() Tj
T*
(   # Inverse DWT reconstruction) Tj
T*
(   clean_signal = pywt.waverec\(coeffs_thresh, wavelet\)) Tj
T*
(   return clean_signal) Tj
T*
