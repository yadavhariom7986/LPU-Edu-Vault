() Tj
T*
(   # Acquire waveform preamble parameters) Tj
T*
(   preamble = scope.query\(':WAV:PRE?'\).split\(','\)) Tj
T*
(   x_inc = float\(preamble[4]\)) Tj
T*
(   y_inc = float\(preamble[7]\)) Tj
T*
(   y_orig = float\(preamble[8]\)) Tj
T*
() Tj
