(   [Detailed Step-by-Step Answer]:) Tj
T*
(   16-QAM Modulator and Slicer Mechanics:) Tj
T*
() Tj
T*
(   16-QAM transmits 4 bits per symbol: 2 bits for In-phase \(I\) and 2 bits for Quadrature \(Q\).) Tj
T*
() Tj
T*
(   Gray Mapping:) Tj
T*
(   Constellation alphabet: $\\{-3d, -d, +d, +3d\\}$ along each axis.) Tj
T*
(   ```python) Tj
T*
(   import numpy as np) Tj
T*
() Tj
T*
(   def qam16_modulate\(bits\):) Tj
T*
(   # Reshape bits into \(N, 4\)) Tj
T*
(   symbols = bits.reshape\(-1, 4\)) Tj
T*
(   lut = { \(0,0\): -3, \(0,1\): -1, \(1,1\): +1, \(1,0\): +3 }) Tj
T*
(   I = np.array\([lut[\(b[0], b[1]\)] for b in symbols]\)) Tj
T*
(   Q = np.array\([lut[\(b[2], b[3]\)] for b in symbols]\)) Tj
T*
(   return I + 1j * Q) Tj
T*
() Tj
T*
(   def qam16_demap\(complex_symbols\):) Tj
T*
(   # Slicing at decision boundaries: -2, 0, +2) Tj
T*
(   def slice_axis\(val\):) Tj
T*
(   if val < -2: return \(0, 0\)) Tj
T*
(   elif val < 0: return \(0, 1\)) Tj
T*
(   elif val < 2: return \(1, 1\)) Tj
T*
(   else: return \(1, 0\)) Tj
T*
(   out_bits = []) Tj
T*
(   for s in complex_symbols:) Tj
T*
(   out_bits.extend\(slice_axis\(s.real\) + slice_axis\(s.imag\)\)) Tj
T*
(   return np.array\(out_bits\)) Tj
T*
(   ```) Tj
T*
() Tj
T*
