(   ber_sim = []) Tj
T*
(   ber_theory = []) Tj
T*
() Tj
T*
(   # 1. Generate random binary bits {0, 1}) Tj
T*
(   bits = np.random.randint\(0, 2, num_bits\)) Tj
T*
(   # 2. BPSK mapping: 0 -> +1 V, 1 -> -1 V) Tj
T*
(   s = 1.0 - 2.0 * bits) Tj
T*
() Tj
T*
(   for snr_db in snr_db_range:) Tj
T*
(   snr_linear = 10.0 ** \(snr_db / 10.0\)) Tj
T*
(   # Noise variance: sigma^2 = Eb / \(2 * SNR\)) Tj
T*
(   sigma = np.sqrt\(1.0 / \(2.0 * snr_linear\)\)) Tj
T*
(   noise = np.random.normal\(0, sigma, num_bits\)) Tj
T*
(   r = s + noise) Tj
T*
() Tj
T*
(   # Optimal threshold decision at 0V) Tj
T*
(   detected_bits = \(r < 0.0\).astype\(int\)) Tj
T*
(   errors = np.sum\(bits != detected_bits\)) Tj
T*
(   ber_sim.append\(errors / num_bits\)) Tj
T*
() Tj
T*
(   # Theoretical Q\(sqrt\(2 * Eb/N0\)\)) Tj
T*
(   theory = 0.5 * erfc\(np.sqrt\(snr_linear\)\)) Tj
T*
(   ber_theory.append\(theory\)) Tj
T*
() Tj
T*
(   return np.array\(ber_sim\), np.array\(ber_theory\)) Tj
T*
