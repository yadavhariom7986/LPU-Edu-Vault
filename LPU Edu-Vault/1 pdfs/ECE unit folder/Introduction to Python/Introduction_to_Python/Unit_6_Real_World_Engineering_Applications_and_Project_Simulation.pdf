(   HEADER_MAGIC = 0xAA55) Tj
T*
() Tj
T*
(   def pack_telemetry\(msg_id: int, timestamp: int, v1: float, v2: float\) -> bytes:) Tj
T*
(   # Pack preliminary packet without CRC) Tj
T*
(   prelim = struct.pack\('>HB I f f', HEADER_MAGIC, msg_id, timestamp, v1, v2\)) Tj
T*
(   crc = zlib.crc32\(prelim\)) Tj
T*
(   return struct.pack\('>HB I f f I', HEADER_MAGIC, msg_id, timestamp, v1, v2, crc\)) Tj
T*
() Tj
T*
(   def unpack_telemetry\(raw_bytes: bytes\):) Tj
T*
(   if len\(raw_bytes\) != struct.calcsize\(PACKET_FMT\):) Tj
T*
(   raise ValueError\('Invalid packet length'\)) Tj
T*
(   magic, msg_id, t_stamp, v1, v2, rx_crc = struct.unpack\(PACKET_FMT, raw_bytes\)) Tj
T*
(   if magic != HEADER_MAGIC:) Tj
T*
(   raise ValueError\('Invalid magic byte header'\)) Tj
T*
(   # Verify CRC) Tj
T*
(   calc_crc = zlib.crc32\(raw_bytes[:-4]\)) Tj
T*
(   if rx_crc != calc_crc:) Tj
T*
(   raise ValueError\(f'CRC mismatch: expected {calc_crc}, got {rx_crc}'\)) Tj
T*
(   return {'id': msg_id, 'time': t_stamp, 'v1': v1, 'v2': v2}) Tj
T*
(   ```) Tj
T*
() Tj
