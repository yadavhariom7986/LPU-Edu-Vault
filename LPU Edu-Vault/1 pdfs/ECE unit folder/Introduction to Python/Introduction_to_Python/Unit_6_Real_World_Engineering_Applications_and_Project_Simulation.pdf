(   ```python) Tj
T*
(   import pyvisa) Tj
T*
(   import numpy as np) Tj
T*
() Tj
T*
(   def capture_scope_waveform\(resource_str='USB0::0x1AB1::0x04CE::DS1ZA1234::INSTR'\):) Tj
T*
(   rm = pyvisa.ResourceManager\(\)) Tj
T*
(   scope = rm.open_resource\(resource_str\)) Tj
T*
(   scope.timeout = 5000) Tj
T*
() Tj
