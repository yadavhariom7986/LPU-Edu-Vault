(   [Problem Statement]: Implement a custom PID speed controller simulation with anti-windup clamping in Python.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   Anti-Windup Integral Clamping Algorithm:) Tj
T*
() Tj
T*
(   ```python) Tj
T*
(   class RobustPID:) Tj
T*
(   def __init__\(self, Kp, Ki, Kd, dt, out_min, out_max\):) Tj
T*
(   self.Kp, self.Ki, self.Kd = Kp, Ki, Kd) Tj
T*
(   self.dt = dt) Tj
T*
(   self.out_min, self.out_max = out_min, out_max) Tj
T*
(   self.integral = 0.0) Tj
T*
(   self.prev_error = 0.0) Tj
T*
() Tj
T*
(   def compute\(self, setpoint, process_val\):) Tj
T*
(   error = setpoint - process_val) Tj
T*
(   derivative = \(error - self.prev_error\) / self.dt) Tj
T*
() Tj
T*
(   # Proposed output) Tj
T*
(   u_unsat = self.Kp * error + self.Ki * self.integral + self.Kd * derivative) Tj
T*
(   u_sat = max\(self.out_min, min\(self.out_max, u_unsat\)\)) Tj
T*
() Tj
T*
(   # Anti-windup: Integrate only if not saturated or error drives out of saturation) Tj
T*
(   if \(u_unsat == u_sat\) or \(u_unsat > u_sat and error < 0\) or \(u_unsat < u_sat and error > 0\):) Tj
T*
(   self.integral += error * self.dt) Tj
T*
() Tj
T*
(   self.prev_error = error) Tj
T*
(   return u_sat) Tj
T*
(   ```) Tj
T*
() Tj
T*
(--------------------------------------------------------------------------------) Tj
T*
ET

endstream
