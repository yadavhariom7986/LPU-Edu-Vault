(   return f'{self.voltage:.3f}') Tj
T*
(   elif cmd == ':OUTP ON':) Tj
T*
(   self.output_enabled = True) Tj
T*
(   return 'OK') Tj
T*
(   elif cmd == ':OUTP?':) Tj
T*
(   return '1' if self.output_enabled else '0') Tj
T*
(   else:) Tj
T*
