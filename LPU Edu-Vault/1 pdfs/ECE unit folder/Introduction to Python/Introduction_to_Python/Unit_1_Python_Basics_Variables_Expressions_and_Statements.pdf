(   def __init__\(self, initial_val=0x00\):) Tj
T*
(   self.port = initial_val & 0xFF # Enforce 8-bit mask) Tj
T*
() Tj
T*
(   def set_pin\(self, pin\):) Tj
T*
(   self.port |= \(1 << pin\)) Tj
T*
() Tj
T*
(   def clear_pin\(self, pin\):) Tj
T*
(   self.port &= ~\(1 << pin\)) Tj
T*
() Tj
T*
(   def toggle_pin\(self, pin\):) Tj
T*
(   self.port ^= \(1 << pin\)) Tj
T*
() Tj
T*
(   def read_pin\(self, pin\):) Tj
T*
(   return 1 if \(self.port & \(1 << pin\)\) else 0) Tj
T*
() Tj
T*
(   def display\(self\):) Tj
T*
(   print\(f'PORT Value: 0x{self.port:02X} | Binary: 0b{self.port:08b}'\)) Tj
T*
() Tj
T*
(   gpio = GPIORegister\(0b00000000\)) Tj
T*
(   gpio.set_pin\(2\) # Set Pin 2 HIGH) Tj
T*
(   gpio.set_pin\(5\) # Set Pin 5 HIGH) Tj
T*
(   gpio.display\(\) # 0b00100100 \(0x24\)) Tj
T*
(   gpio.toggle_pin\(2\) # Toggle Pin 2 LOW) Tj
T*
(   gpio.display\(\) # 0b00100000 \(0x20\)) Tj
T*
(   print\('Pin 5 State:', gpio.read_pin\(5\)\) # 1) Tj
T*
(   ```) Tj
T*
() Tj
T*
