(   [Problem Statement]: Write a complete Python script to calculate Ohm's Law and Power Dissipation given user inputs, handling ValueError exceptions robustly.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   Here is a complete interactive engineering calculation script with robust exception handling:) Tj
T*
() Tj
T*
(   ```python) Tj
T*
(   def calculate_ohms_law\(\):) Tj
T*
(   print\('--- Ohm\\'s Law & Power Dissipation Calculator ---'\)) Tj
T*
(   try:) Tj
T*
(   voltage = float\(input\('Enter DC Voltage \(V\) in Volts: '\)\)) Tj
T*
(   resistance = float\(input\('Enter Resistance \(R\) in Ohms: '\)\)) Tj
T*
() Tj
T*
(   if resistance <= 0:) Tj
T*
(   raise ZeroDivisionError\('Resistance must be strictly positive and non-zero.'\)) Tj
T*
() Tj
T*
(   current = voltage / resistance) Tj
T*
(   power = \(voltage ** 2\) / resistance) Tj
T*
() Tj
T*
(   print\(f'\\nCalculated Current \(I\) : {current:.4f} A \({current*1000:.2f} mA\)'\)) Tj
T*
(   print\(f'Power Dissipation \(P\) : {power:.4f} W \({power*1000:.2f} mW\)'\)) Tj
T*
(   except ValueError:) Tj
T*
(   print\('ERROR: Invalid input! Please enter valid numeric decimal values.'\)) Tj
T*
(   except ZeroDivisionError as zde:) Tj
T*
(   print\(f'ERROR: {zde}'\)) Tj
T*
() Tj
T*
(   if __name__ == '__main__':) Tj
T*
(   calculate_ohms_law\(\)) Tj
T*
(   ```) Tj
T*
