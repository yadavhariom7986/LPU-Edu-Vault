T*
(   ip_pattern = re.compile\(r'IP:\\s+\(\\d{1,3}\(?:\\.\\d{1,3}\){3}\)'\)) Tj
T*
() Tj
T*
(   # 1. search\(\)) Tj
T*
(   first_match = ip_pattern.search\(log_data\)) Tj
T*
(   print\(f"re.search first match: {first_match.group\(1\)}"\)) Tj
T*
() Tj
T*
(   # 2. findall\(\)) Tj
T*
(   all_ips = ip_pattern.findall\(log_data\)) Tj
T*
(   print\(f"re.findall list: {all_ips}"\)) Tj
T*
() Tj
T*
(   # 3. finditer\(\) with span coordinates) Tj
T*
(   print\("re.finditer stream:"\)) Tj
T*
(   for m in ip_pattern.finditer\(log_data\):) Tj
T*
(   print\(f" Matched IP: {m.group\(1\):<15} at Span: {m.span\(1\)}"\)) Tj
T*
() Tj
