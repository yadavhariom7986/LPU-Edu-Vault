(   class WebLogParser:) Tj
T*
(   LOG_REGEX = re.compile\() Tj
T*
(   r'^\(?P<ip>\\S+\)\\s+\\S+\\s+\\S+\\s+') Tj
T*
(   r'\\[\(?P<timestamp>[^\\]]+\)\\]\\s+') Tj
T*
(   r'"\(?P<method>[A-Z]+\)\\s+\(?P<endpoint>\\S+\)\\s+HTTP/[0-9.]+"\\s+') Tj
T*
(   r'\(?P<status>\\d{3}\)\\s+\(?P<bytes>\\S+\)') Tj
T*
(   \)) Tj
T*
() Tj
T*
(   @classmethod) Tj
T*
(   def parse_logs\(cls, log_lines: list\) -> dict:) Tj
T*
(   status_counts = Counter\(\)) Tj
T*
(   ip_counts = Counter\(\)) Tj
T*
(   parsed_entries = []) Tj
T*
() Tj
T*
(   for line in log_lines:) Tj
T*
(   match = cls.LOG_REGEX.match\(line.strip\(\)\)) Tj
T*
(   if match:) Tj
T*
(   data = match.groupdict\(\)) Tj
T*
(   status_counts[data["status"]] += 1) Tj
T*
(   ip_counts[data["ip"]] += 1) Tj
T*
(   parsed_entries.append\(data\)) Tj
T*
() Tj
T*
(   return {) Tj
T*
(   "TotalProcessed": len\(parsed_entries\),) Tj
T*
(   "StatusDistribution": dict\(status_counts\),) Tj
T*
(   "TopIPs": ip_counts.most_common\(2\)) Tj
T*
(   }) Tj
T*
() Tj
