T*
(   print\("Parsed URL Named Groups \(groupdict\):"\)) Tj
T*
(   for k, v in m.groupdict\(\).items\(\):) Tj
T*
(   print\(f" {k:<10}: {v}"\)) Tj
T*
() Tj
T*
(   # 2. Backreference Demonstration \(Duplicate Words\)) Tj
T*
(   prose = "Paris in the the spring was was beautiful.") Tj
T*
