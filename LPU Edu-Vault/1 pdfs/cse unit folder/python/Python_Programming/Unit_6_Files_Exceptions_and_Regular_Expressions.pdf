(   4. Group files with matching SHA-256 digests.) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   import hashlib) Tj
T*
(   import os) Tj
T*
(   from collections import defaultdict) Tj
T*
() Tj
T*
(   def find_duplicate_files\(root_folder: str\) -> dict:) Tj
T*
(   size_map = defaultdict\(list\)) Tj
T*
() Tj
T*
(   # Pass 1: Group by file size) Tj
T*
(   for dirpath, _, filenames in os.walk\(root_folder\):) Tj
T*
(   for fn in filenames:) Tj
T*
(   fp = os.path.join\(dirpath, fn\)) Tj
T*
(   try:) Tj
T*
(   sz = os.path.getsize\(fp\)) Tj
T*
(   size_map[sz].append\(fp\)) Tj
T*
(   except OSError:) Tj
T*
(   pass) Tj
T*
() Tj
T*
(   duplicates = defaultdict\(list\)) Tj
T*
() Tj
T*
(   # Pass 2: Hash only candidate files with size collision) Tj
T*
(   for sz, files in size_map.items\(\):) Tj
T*
(   if len\(files\) > 1 and sz > 0:) Tj
T*
(   for fp in files:) Tj
T*
(   h = hashlib.sha256\(\)) Tj
T*
(   try:) Tj
T*
(   with open\(fp, "rb"\) as f:) Tj
T*
(   while chunk := f.read\(65536\):) Tj
T*
(   h.update\(chunk\)) Tj
T*
(   digest = h.hexdigest\(\)) Tj
T*
(   duplicates[digest].append\(fp\)) Tj
T*
(   except OSError:) Tj
T*
(   pass) Tj
T*
() Tj
T*
(   # Filter only genuine duplicates) Tj
T*
(   return {k: v for k, v in duplicates.items\(\) if len\(v\) > 1}) Tj
T*
() Tj
T*
(   # Demonstration on existing python syllabus directory) Tj
T*
(   target = "C:/FINAL PrOJECT/cse unit folder/python") Tj
T*
(   dups = find_duplicate_files\(target\)) Tj
T*
(   print\(f"Found {len\(dups\)} duplicate content groups in '{target}'."\)) Tj
T*
() Tj
T*
(   3. Complexity Analysis:) Tj
T*
(   - Time Complexity: O\(Files\) size checks + O\(Candidate Bytes\) hashing.) Tj
T*
(   - Space Complexity: O\(Files\) path metadata.) Tj
T*
() Tj
T*
(--------------------------------------------------------------------------------) Tj
T*
() Tj
T*
