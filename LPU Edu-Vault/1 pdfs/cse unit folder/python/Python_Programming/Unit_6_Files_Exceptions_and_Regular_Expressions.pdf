(   [Problem Statement]: Implement a Markdown to HTML Converter in Python using Regular Expressions for headers, bold, italics, links, and code blocks.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Problem Context:) Tj
T*
(   Build a lightweight Markdown parser that converts CommonMark syntax into valid HTML tags:) Tj
T*
(   - Headers \(# H1, ## H2\) -> <h1>, <h2>) Tj
T*
(   - Bold \(**text**\) -> <strong>text</strong>) Tj
T*
(   - Italics \(*text*\) -> <em>text</em>) Tj
T*
(   - Links \([text]\(url\)\) -> <a href='url'>text</a>) Tj
T*
(   - Inline code \(`code`\) -> <code>code</code>) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   import re) Tj
T*
() Tj
T*
(   class MarkdownParser:) Tj
T*
(   @staticmethod) Tj
T*
(   def parse_markdown\(md_text: str\) -> str:) Tj
T*
(   lines = []) Tj
T*
(   for line in md_text.splitlines\(\):) Tj
T*
(   # Headers) Tj
T*
(   if line.startswith\("### "\):) Tj
T*
(   line = f"<h3>{line[4:]}</h3>") Tj
T*
(   elif line.startswith\("## "\):) Tj
T*
(   line = f"<h2>{line[3:]}</h2>") Tj
T*
(   elif line.startswith\("# "\):) Tj
T*
(   line = f"<h1>{line[2:]}</h1>") Tj
T*
(   else:) Tj
T*
(   # Bold & Italics) Tj
T*
(   line = re.sub\(r'\\*\\*\(.*?\)\\*\\*', r'<strong></strong>', line\)) Tj
T*
(   line = re.sub\(r'\\*\(.*?\)\\*', r'<em></em>', line\)) Tj
T*
(   # Inline code) Tj
T*
(   line = re.sub\(r'`\(.*?\)`', r'<code></code>', line\)) Tj
T*
(   # Hyperlinks) Tj
T*
(   line = re.sub\(r'\\[\(.*?\)\\]\\\(\(.*?\)\\\)', r'<a href=""></a>', line\)) Tj
T*
(   if line:) Tj
T*
(   line = f"<p>{line}</p>") Tj
T*
(   lines.append\(line\)) Tj
T*
(   return "\\n".join\(lines\)) Tj
T*
ET

