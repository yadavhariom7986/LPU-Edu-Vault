(   r'^\(?P<scheme>https?\)://') Tj
T*
(   r'\(?P<host>[a-zA-Z0-9.-]+\)') Tj
T*
(   r'\(?::\(?P<port>\\d+\)\)?') Tj
T*
(   r'\(?P<path>/[a-zA-Z0-9/_.-]*\)?$') Tj
T*
(   \)) Tj
T*
