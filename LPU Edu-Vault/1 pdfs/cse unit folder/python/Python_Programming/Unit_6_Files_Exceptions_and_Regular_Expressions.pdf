(   class EnvConfigManager:) Tj
T*
(   @staticmethod) Tj
T*
(   def parse_env_string\(env_text: str\) -> dict:) Tj
T*
(   config = {}) Tj
T*
(   for line in env_text.splitlines\(\):) Tj
T*
(   line = line.strip\(\)) Tj
T*
(   # Ignore empty lines and comments) Tj
T*
(   if not line or line.startswith\('#'\):) Tj
T*
(   continue) Tj
T*
() Tj
T*
(   if '=' in line:) Tj
T*
(   key, val = line.split\('=', 1\)) Tj
T*
(   key = key.strip\(\)) Tj
T*
(   val = val.strip\(\)) Tj
T*
() Tj
T*
(   # Strip inline comment) Tj
T*
(   if '#' in val:) Tj
T*
(   val = val.split\('#', 1\)[0].strip\(\)) Tj
T*
() Tj
T*
(   # Strip matching surrounding quotes) Tj
T*
(   if \(val.startswith\('"'\) and val.endswith\('"'\)\) or \(val.startswith\("'"\) and val.endswith\("'"\)\):) Tj
T*
(   val = val[1:-1]) Tj
T*
() Tj
T*
(   # Type coercion) Tj
T*
(   if val.lower\(\) == 'true': val = True) Tj
T*
(   elif val.lower\(\) == 'false': val = False) Tj
T*
(   elif val.isdigit\(\): val = int\(val\)) Tj
T*
() Tj
T*
(   config[key] = val) Tj
T*
(   return config) Tj
T*
() Tj
T*
(   # Verification) Tj
T*
(   raw_env = """) Tj
T*
(   # Server Runtime Configuration) Tj
T*
(   PORT=8080 # Production port) Tj
T*
(   DEBUG=false) Tj
T*
(   DATABASE_URL="postgres://user:secret@localhost:5432/app_db") Tj
T*
(   WORKERS=4) Tj
T*
(   """) Tj
T*
() Tj
T*
(   parsed_cfg = EnvConfigManager.parse_env_string\(raw_env\)) Tj
T*
(   print\("Parsed Environment Configuration:"\)) Tj
T*
(   for k, v in parsed_cfg.items\(\):) Tj
T*
(   print\(f" {k:<15} -> {v} \({type\(v\).__name__}\)"\)) Tj
T*
() Tj
T*
(   3. Complexity Analysis:) Tj
T*
(   - Time Complexity: O\(N\) linear scan over lines.) Tj
T*
(   - Space Complexity: O\(K\) dictionary storage.) Tj
T*
() Tj
T*
(--------------------------------------------------------------------------------) Tj
T*
