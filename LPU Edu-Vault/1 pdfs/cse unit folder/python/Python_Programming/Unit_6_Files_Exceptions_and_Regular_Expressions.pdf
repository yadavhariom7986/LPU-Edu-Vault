(   [Problem Statement]: Implement an INI-Style Configuration Parser in Python using Regular Expressions without external libraries.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Problem Context:) Tj
T*
(   Parse INI format configuration files containing [Sections] and key = value assignments:) Tj
T*
(   [database]) Tj
T*
(   host = 127.0.0.1) Tj
T*
(   port = 5432) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   import re) Tj
T*
() Tj
T*
(   def parse_ini_file_content\(ini_text: str\) -> dict:) Tj
T*
(   section_regex = re.compile\(r'^\\[\(?P<section>[a-zA-Z0-9_-]+\)\\]$'\)) Tj
T*
(   key_val_regex = re.compile\(r'^\(?P<key>[a-zA-Z0-9_-]+\)\\s*=\\s*\(?P<val>.*\)$'\)) Tj
T*
() Tj
T*
(   config = {}) Tj
T*
(   current_section = "DEFAULT") Tj
T*
(   config[current_section] = {}) Tj
T*
() Tj
T*
(   for line in ini_text.splitlines\(\):) Tj
T*
(   line = line.strip\(\)) Tj
T*
(   if not line or line.startswith\(';'\) or line.startswith\('#'\):) Tj
T*
(   continue) Tj
T*
() Tj
T*
(   sec_match = section_regex.match\(line\)) Tj
T*
(   if sec_match:) Tj
T*
(   current_section = sec_match.group\("section"\)) Tj
T*
(   config[current_section] = {}) Tj
T*
(   continue) Tj
T*
() Tj
T*
(   kv_match = key_val_regex.match\(line\)) Tj
T*
(   if kv_match:) Tj
T*
(   k = kv_match.group\("key"\)) Tj
T*
(   v = kv_match.group\("val"\).strip\(\)) Tj
T*
(   config[current_section][k] = v) Tj
T*
() Tj
T*
(   return config) Tj
T*
() Tj
T*
(   # Verification) Tj
T*
(   sample_ini = """) Tj
T*
(   ; Server Configuration File) Tj
T*
(   [network]) Tj
T*
(   host = 0.0.0.0) Tj
T*
(   port = 8080) Tj
T*
() Tj
T*
(   [auth]) Tj
T*
(   provider = ldap) Tj
T*
(   ssl = true) Tj
T*
(   """) Tj
T*
() Tj
T*
(   parsed = parse_ini_file_content\(sample_ini\)) Tj
T*
(   print\("Parsed INI Structure:", parsed\)) Tj
T*
ET

endstream
