() Tj
T*
(   2. Python Implementation:) Tj
T*
(   import struct) Tj
T*
() Tj
T*
(   class NetworkPacket:) Tj
T*
(   # Header format: Magic \(2B\), Version \(1B\), PacketType \(1B\), Sequence \(4B\), PayloadLen \(2B\)) Tj
T*
(   HEADER_FORMAT = ">HBB I H") Tj
T*
(   HEADER_SIZE = struct.calcsize\(HEADER_FORMAT\) # 10 bytes) Tj
T*
() Tj
T*
(   @classmethod) Tj
T*
(   def pack\(cls, seq_num: int, payload: str\) -> bytes:) Tj
T*
(   magic = 0xABCD) Tj
T*
(   version = 1) Tj
T*
(   pkt_type = 2 # DATA) Tj
T*
(   encoded_payload = payload.encode\('utf-8'\)) Tj
T*
(   payload_len = len\(encoded_payload\)) Tj
T*
() Tj
T*
(   header = struct.pack\(cls.HEADER_FORMAT, magic, version, pkt_type, seq_num, payload_len\)) Tj
T*
(   return header + encoded_payload) Tj
T*
() Tj
T*
(   @classmethod) Tj
T*
(   def unpack\(cls, raw_bytes: bytes\) -> tuple:) Tj
T*
(   header_bytes = raw_bytes[:cls.HEADER_SIZE]) Tj
T*
(   magic, ver, p_type, seq, p_len = struct.unpack\(cls.HEADER_FORMAT, header_bytes\)) Tj
T*
(   payload = raw_bytes[cls.HEADER_SIZE:cls.HEADER_SIZE + p_len].decode\('utf-8'\)) Tj
T*
(   return {"Magic": hex\(magic\), "Seq": seq, "Payload": payload}) Tj
T*
() Tj
T*
(   # Demonstration) Tj
T*
(   packet_bytes = NetworkPacket.pack\(1042, "Telemetry Sensor Ping"\)) Tj
T*
(   print\(f"Packed Binary Packet: {packet_bytes} \({len\(packet_bytes\)} bytes\)"\)) Tj
T*
() Tj
T*
(   decoded = NetworkPacket.unpack\(packet_bytes\)) Tj
T*
(   print\(f"Unpacked Packet: {decoded}"\)) Tj
T*
() Tj
T*
(   3. Complexity Analysis:) Tj
T*
(   - Pack/Unpack Time: O\(1\) fixed-size header struct mapping.) Tj
T*
(   - Space Complexity: O\(Payload Length\) byte array.) Tj
T*
() Tj
T*
(--------------------------------------------------------------------------------) Tj
T*
() Tj
T*
