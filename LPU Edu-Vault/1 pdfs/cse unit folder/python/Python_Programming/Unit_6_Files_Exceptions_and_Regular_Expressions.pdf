T*
(   ip_map[real_ip] = f"ANON_IP_{ip_counter:03d}") Tj
T*
(   ip_counter += 1) Tj
T*
(   return ip_map[real_ip]) Tj
T*
() Tj
T*
(   anonymized_text = ip_regex.sub\(replace_ip, csv_input\)) Tj
T*
(   return anonymized_text) Tj
T*
() Tj
T*
