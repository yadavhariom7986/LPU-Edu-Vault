/F1 8.5 Tf
12.5 TL
(   [Problem Statement]: Implement a Syntax Highlighter Lexer in Python using Regular Expressions to tokenize Python source code into Keywords, Identifiers, Numbers, Strings, and Operators.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Problem Context:) Tj
T*
(   Develop a regular expression lexer that scans source code and emits token tuples \(TYPE, VALUE\)) Tj
T*
(   for syntax highlighting.) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   import re) Tj
T*
() Tj
T*
(   TOKEN_SPECIFICATION = [) Tj
T*
(   \('KEYWORD', r'\(?:def|class|if|else|while|for|return|import|try|except\)'\),) Tj
T*
(   \('NUMBER', r'\\d+\(?:\\.\\d+\)?'\),) Tj
T*
(   \('STRING', r'"[^") Tj
T*
(   ]*"|'[^') Tj
T*
(   ]*''\),) Tj
T*
(   \('IDENTIFIER', r'[A-Za-z_][A-Za-z0-9_]*'\),) Tj
T*
(   \('OPERATOR', r'[+\\-*/=<>!]+'\),) Tj
T*
(   \('PUNCTUATION',r'[\(\){}:;,]'\),) Tj
T*
(   \('WHITESPACE', r'\\s+'\),) Tj
T*
(   ]) Tj
T*
() Tj
T*
(   MASTER_REGEX = re.compile\('|'.join\(f'\(?P<{name}>{pattern}\)' for name, pattern in) Tj
T*
(   TOKEN_SPECIFICATION\)\)) Tj
T*
() Tj
T*
(   def tokenize_code\(code_str: str\) -> list:) Tj
T*
(   tokens = []) Tj
T*
(   for match in MASTER_REGEX.finditer\(code_str\):) Tj
T*
(   kind = match.lastgroup) Tj
T*
(   value = match.group\(\)) Tj
T*
(   if kind != 'WHITESPACE':) Tj
T*
(   tokens.append\(\(kind, value\)\)) Tj
T*
(   return tokens) Tj
T*
() Tj
T*
(   # Verification) Tj
T*
(   sample_py = "def square\(x\): return x * 2") Tj
T*
(   tokens = tokenize_code\(sample_py\)) Tj
T*
(   print\("Lexed Tokens:"\)) Tj
T*
(   for t_type, t_val in tokens:) Tj
T*
(   print\(f" {t_type:<12}: '{t_val}'"\)) Tj
T*
() Tj
T*
(   3. Complexity Analysis:) Tj
T*
(   - Tokenization Time: O\(N\) linear scan over source text.) Tj
T*
(   - Space Complexity: O\(Tokens\) token array.) Tj
T*
() Tj
T*
(--------------------------------------------------------------------------------) Tj
T*
() Tj
T*
ET

endstream
