(   [Problem Statement]: Implement a File Integrity Verification Utility in Python that computes MD5, SHA-1, and SHA-256 digests simultaneously in a single file pass.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Problem Context:) Tj
T*
(   Computing multiple hashes sequentially requires reading the file multiple times from disk. We) Tj
T*
(   compute MD5, SHA-1, and SHA-256 simultaneously in a single read pass.) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   import hashlib) Tj
T*
(   import os) Tj
T*
() Tj
T*
(   def multi_hash_stream\(filepath: str\) -> dict:) Tj
T*
(   md5 = hashlib.md5\(\)) Tj
T*
(   sha1 = hashlib.sha1\(\)) Tj
T*
(   sha256 = hashlib.sha256\(\)) Tj
T*
() Tj
T*
(   with open\(filepath, "rb"\) as f:) Tj
T*
(   while chunk := f.read\(65536\):) Tj
T*
(   md5.update\(chunk\)) Tj
T*
(   sha1.update\(chunk\)) Tj
T*
(   sha256.update\(chunk\)) Tj
T*
() Tj
T*
(   return {) Tj
T*
(   "MD5": md5.hexdigest\(\),) Tj
T*
(   "SHA1": sha1.hexdigest\(\),) Tj
T*
(   "SHA256": sha256.hexdigest\(\)) Tj
T*
(   }) Tj
T*
() Tj
T*
ET

endstream
