(   Unattended server logs grow indefinitely, eventually filling disk drives.) Tj
T*
(   Log Rotation rotates active logs once they exceed a size threshold \(e.g., 5 MB\) by renaming) Tj
T*
(   them with timestamps, compressing them with gzip \(.gz\), and maintaining a maximum backlog of) Tj
T*
(   archives.) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   import gzip) Tj
T*
(   import os) Tj
T*
(   import shutil) Tj
T*
(   import time) Tj
T*
() Tj
T*
(   class LogRotator:) Tj
T*
(   def __init__\(self, log_path: str, max_bytes=1024, max_backups=3\):) Tj
T*
(   self.log_path = log_path) Tj
T*
(   self.max_bytes = max_bytes) Tj
T*
(   self.max_backups = max_backups) Tj
T*
() Tj
T*
(   def rotate_if_needed\(self\):) Tj
T*
(   if not os.path.exists\(self.log_path\):) Tj
T*
(   return) Tj
T*
() Tj
T*
(   if os.path.getsize\(self.log_path\) >= self.max_bytes:) Tj
T*
(   timestamp = int\(time.time\(\)\)) Tj
T*
(   archive_name = f"{self.log_path}.{timestamp}.gz") Tj
T*
() Tj
T*
(   # Compress active log to .gz) Tj
T*
(   with open\(self.log_path, 'rb'\) as f_in:) Tj
T*
(   with gzip.open\(archive_name, 'wb'\) as f_out:) Tj
T*
(   shutil.copyfileobj\(f_in, f_out\)) Tj
T*
() Tj
T*
(   # Truncate active log file to 0 bytes) Tj
T*
(   with open\(self.log_path, 'w'\) as f:) Tj
T*
(   pass) Tj
T*
() Tj
T*
(   print\(f"[ROTATED] Compressed active log to: {archive_name}"\)) Tj
T*
() Tj
T*
(   # Verification) Tj
T*
(   test_log = "service.log") Tj
T*
(   with open\(test_log, "w"\) as f:) Tj
T*
(   f.write\("A" * 2000\) # Exceeds 1024 bytes) Tj
T*
() Tj
T*
(   rotator = LogRotator\(test_log, max_bytes=1024\)) Tj
T*
(   rotator.rotate_if_needed\(\)) Tj
T*
() Tj
T*
(   # Cleanup) Tj
T*
(   if os.path.exists\(test_log\): os.remove\(test_log\)) Tj
T*
(   for f in os.listdir\("."\):) Tj
T*
(   if f.startswith\("service.log."\): os.remove\(f\)) Tj
T*
() Tj
T*
(   3. Complexity Analysis:) Tj
T*
(   - Compression Time: O\(File Size\) streaming gzip deflation.) Tj
T*
