12.5 TL
(   [Problem Statement]: Implement an Exception-Safe Transactional Database File Journaling System in Python using write-ahead logs \(WAL\).) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Problem Context:) Tj
T*
(   Write-Ahead Logging \(WAL\) ensures database consistency. Before committing changes to main) Tj
T*
(   storage, operations are appended to a persistent journal log. If a crash occurs, the journal is) Tj
T*
(   replayed to restore state.) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   import os) Tj
T*
(   import json) Tj
T*
() Tj
T*
(   class WALDatabase:) Tj
T*
(   def __init__\(self, db_file="data.json", wal_file="data.wal"\):) Tj
T*
(   self.db_file = db_file) Tj
T*
(   self.wal_file = wal_file) Tj
T*
(   self.state = self._recover_and_load\(\)) Tj
T*
() Tj
T*
(   def _recover_and_load\(self\) -> dict:) Tj
T*
(   data = {}) Tj
T*
(   if os.path.exists\(self.db_file\):) Tj
T*
(   with open\(self.db_file, "r"\) as f:) Tj
T*
(   data = json.load\(f\)) Tj
T*
(   # Replay WAL if present) Tj
T*
(   if os.path.exists\(self.wal_file\):) Tj
T*
(   print\("[RECOVERY] Uncommitted WAL detected. Replaying journal..."\)) Tj
T*
(   with open\(self.wal_file, "r"\) as f:) Tj
T*
(   for line in f:) Tj
T*
(   entry = json.loads\(line\)) Tj
T*
(   data[entry["key"]] = entry["value"]) Tj
T*
(   # Flush to main DB and delete WAL) Tj
T*
(   with open\(self.db_file, "w"\) as f:) Tj
T*
(   json.dump\(data, f\)) Tj
T*
(   os.remove\(self.wal_file\)) Tj
T*
(   return data) Tj
T*
() Tj
T*
(   def set\(self, key: str, value\):) Tj
T*
(   # 1. Log to WAL first) Tj
T*
(   with open\(self.wal_file, "a"\) as f:) Tj
T*
(   f.write\(json.dumps\({"key": key, "value": value}\) + "\\n"\)) Tj
T*
(   self.state[key] = value) Tj
T*
() Tj
T*
(   # Verification) Tj
T*
(   db = WALDatabase\("test_db.json", "test_db.wal"\)) Tj
T*
(   db.set\("user_101", {"name": "Aarav", "balance": 500}\)) Tj
T*
() Tj
T*
(   # Cleanup) Tj
T*
(   for p in \("test_db.json", "test_db.wal"\):) Tj
T*
(   if os.path.exists\(p\): os.remove\(p\)) Tj
T*
() Tj
T*
(   3. Complexity Analysis:) Tj
T*
(   - Append Time: O\(1\) sequential disk write.) Tj
T*
(   - Recovery Time: O\(Journal Entries\).) Tj
T*
() Tj
T*
ET

endstream
