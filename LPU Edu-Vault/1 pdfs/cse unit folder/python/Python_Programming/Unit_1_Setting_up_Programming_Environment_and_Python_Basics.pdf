(   [Problem Statement]: Implement a Python program to perform Cartesian Coordinate System operations: Distance calculation, midpoint, polar coordinate conversion, and slope.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Problem Context:) Tj
T*
(   Develop a modular Python program for 2D Cartesian plane geometry. Given two points P1\(x1, y1\)) Tj
T*
(   and P2\(x2, y2\), calculate:) Tj
T*
(   1. Euclidean distance d = sqrt\(\(x2 - x1\)^2 + \(y2 - y1\)^2\)) Tj
T*
(   2. Midpoint M = \(\(x1 + x2\)/2, \(y1 + y2\)/2\)) Tj
T*
(   3. Line slope m = \(y2 - y1\) / \(x2 - x1\)) Tj
T*
(   4. Polar coordinates \(r, theta\) using math.hypot and math.atan2.) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   import math) Tj
T*
() Tj
T*
(   class Point2D:) Tj
T*
(   def __init__\(self, x: float, y: float\):) Tj
T*
(   self.x = float\(x\)) Tj
T*
(   self.y = float\(y\)) Tj
T*
() Tj
T*
(   def distance_to\(self, other: 'Point2D'\) -> float:) Tj
T*
(   return math.hypot\(self.x - other.x, self.y - other.y\)) Tj
T*
() Tj
T*
(   def midpoint_with\(self, other: 'Point2D'\) -> tuple:) Tj
T*
(   return \(\(self.x + other.x\) / 2.0, \(self.y + other.y\) / 2.0\)) Tj
T*
() Tj
T*
(   def slope_to\(self, other: 'Point2D'\) -> float:) Tj
T*
(   dx = other.x - self.x) Tj
T*
(   dy = other.y - self.y) Tj
T*
(   if dx == 0:) Tj
T*
(   return float\('inf'\) # Vertical line) Tj
T*
(   return dy / dx) Tj
T*
() Tj
T*
(   def to_polar\(self\) -> tuple:) Tj
T*
(   r = math.hypot\(self.x, self.y\)) Tj
T*
(   theta_rad = math.atan2\(self.y, self.x\)) Tj
T*
(   theta_deg = math.degrees\(theta_rad\)) Tj
T*
(   return \(round\(r, 4\), round\(theta_deg, 2\)\)) Tj
T*
() Tj
T*
(   def __repr__\(self\):) Tj
T*
(   return f"Point\({self.x}, {self.y}\)") Tj
T*
() Tj
T*
(   # Verification) Tj
T*
(   p1 = Point2D\(3, 4\)) Tj
T*
(   p2 = Point2D\(7, 1\)) Tj
T*
() Tj
T*
(   print\(f"Point 1: {p1} | Polar \(r, theta\): {p1.to_polar\(\)}"\)) Tj
T*
(   print\(f"Point 2: {p2} | Polar \(r, theta\): {p2.to_polar\(\)}"\)) Tj
T*
(   print\(f"Euclidean Distance P1-P2: {p1.distance_to\(p2\):.4f}"\)) Tj
T*
(   print\(f"Midpoint P1-P2: {p1.midpoint_with\(p2\)}"\)) Tj
T*
ET

endstream
