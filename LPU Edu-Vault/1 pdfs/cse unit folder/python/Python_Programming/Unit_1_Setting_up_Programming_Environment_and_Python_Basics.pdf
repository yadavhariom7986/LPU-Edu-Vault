(   3. The Guard Idiom:) Tj
T*
(   By enclosing script entry points within the guard:) Tj
T*
(   if __name__ == '__main__':) Tj
T*
(   main\(\)) Tj
T*
(   developers guarantee that execution occurs ONLY when the script is run directly, while allowing) Tj
T*
(   all classes, functions, and constants to be cleanly imported elsewhere without side effects.) Tj
T*
() Tj
T*
(   4. Python Code Demonstration:) Tj
T*
(   def calculate_factorial\(n: int\) -> int:) Tj
T*
(   """Reusable library function.""") Tj
T*
(   if n < 0:) Tj
T*
(   raise ValueError\("Factorial undefined for negative numbers."\)) Tj
T*
(   result = 1) Tj
T*
(   for i in range\(1, n + 1\):) Tj
T*
(   result *= i) Tj
T*
(   return result) Tj
T*
() Tj
T*
(   def main\(\):) Tj
T*
(   """CLI entry point for direct script execution.""") Tj
T*
(   print\("Executing as standalone script..."\)) Tj
T*
(   test_val = 5) Tj
T*
(   print\(f"Test Factorial\({test_val}\) = {calculate_factorial\(test_val\)}"\)) Tj
T*
() Tj
T*
(   # Idiomatic Module Guard) Tj
T*
(   if __name__ == '__main__':) Tj
T*
(   main\(\)) Tj
T*
(   else:) Tj
T*
(   print\(f"Module '{__name__}' imported successfully into another namespace."\)) Tj
T*
() Tj
T*
(   5. Complexity Analysis:) Tj
T*
(   - Time Complexity: O\(1\) string equality comparison during module initialization.) Tj
T*
(   - Space Complexity: O\(1\) interpreter state.) Tj
T*
() Tj
T*
(--------------------------------------------------------------------------------) Tj
T*
() Tj
T*
ET

