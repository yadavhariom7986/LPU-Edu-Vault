T*
(   new_str = base_str + " Programming") Tj
T*
(   print\(f"New String: {new_str}, New ID: {id\(new_str\)}"\)) Tj
T*
() Tj
T*
(   # Efficient Building via join\(\) vs Inefficient Building via +=) Tj
T*
