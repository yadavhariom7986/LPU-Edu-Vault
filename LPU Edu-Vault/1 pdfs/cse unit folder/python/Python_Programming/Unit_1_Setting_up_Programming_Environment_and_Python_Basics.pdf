(   if a == 0:) Tj
T*
(   raise ValueError\("Degenerate Case: 'a' cannot be zero in a quadratic equation."\)) Tj
T*
() Tj
T*
(   discriminant = \(b ** 2\) - \(4 * a * c\)) Tj
T*
(   print\(f"\\nSolving: \({a}\)x^2 + \({b}\)x + \({c}\) = 0 | Discriminant = {discriminant}"\)) Tj
T*
() Tj
T*
(   if discriminant > 0:) Tj
T*
(   sqrt_d = math.sqrt\(discriminant\)) Tj
T*
(   r1 = \(-b + sqrt_d\) / \(2 * a\)) Tj
T*
(   r2 = \(-b - sqrt_d\) / \(2 * a\)) Tj
T*
(   print\(f" Two Distinct Real Roots: x1 = {r1:.4f}, x2 = {r2:.4f}"\)) Tj
T*
(   return \(r1, r2\)) Tj
T*
(   elif discriminant == 0:) Tj
T*
(   r = -b / \(2 * a\)) Tj
T*
(   print\(f" Single Degenerate Real Root: x = {r:.4f}"\)) Tj
T*
(   return \(r,\)) Tj
T*
(   else:) Tj
T*
(   # Complex conjugate roots using cmath) Tj
T*
(   sqrt_d = cmath.sqrt\(discriminant\)) Tj
T*
(   r1 = \(-b + sqrt_d\) / \(2 * a\)) Tj
T*
(   r2 = \(-b - sqrt_d\) / \(2 * a\)) Tj
T*
(   print\(f" Complex Conjugate Roots: x1 = {r1.real:.4f} + {r1.imag:.4f}j, x2 = {r2.real:.4f} +) Tj
T*
(   {r2.imag:.4f}j"\)) Tj
T*
(   return \(r1, r2\)) Tj
T*
() Tj
T*
(   # Test All Three Regimes) Tj
T*
(   solve_quadratic_equation\(1, -5, 6\) # Roots: 3.0, 2.0 \(Delta = 1\)) Tj
T*
(   solve_quadratic_equation\(1, -4, 4\) # Roots: 2.0 \(Delta = 0\)) Tj
T*
(   solve_quadratic_equation\(1, 2, 5\) # Complex Roots: -1 +/- 2j \(Delta = -16\)) Tj
T*
() Tj
T*
(   3. Complexity Analysis:) Tj
T*
(   - Time Complexity: O\(1\) elementary arithmetic and square root computation.) Tj
T*
(   - Space Complexity: O\(1\) memory for roots.) Tj
T*
() Tj
T*
