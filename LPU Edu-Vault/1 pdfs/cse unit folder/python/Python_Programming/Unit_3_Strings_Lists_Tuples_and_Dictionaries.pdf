(   [Problem Statement]: Implement an LRU \(Least Recently Used\) Cache simulation in Python using OrderedDict or dictionaries with move_to_end\(\).) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Theoretical Principles of LRU Cache:) Tj
T*
(   An LRU Cache is a bounded associative cache that evicts the least recently accessed item when) Tj
T*
(   capacity is exceeded.) Tj
T*
(   Both get\(\) and put\(\) must operate in O\(1\) time complexity.) Tj
T*
(   In Python 3.7+, standard dictionaries preserve insertion order. The collections.OrderedDict) Tj
T*
(   provides an explicit move_to_end\(key\) method to refresh item recency in O\(1\) time.) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   from collections import OrderedDict) Tj
T*
() Tj
T*
(   class LRUCache:) Tj
T*
(   def __init__\(self, capacity: int\):) Tj
T*
(   self.capacity = capacity) Tj
T*
(   self.cache = OrderedDict\(\)) Tj
T*
() Tj
T*
(   def get\(self, key: int\) -> int:) Tj
T*
(   if key not in self.cache:) Tj
T*
(   return -1) Tj
T*
(   # Refresh recency: move accessed item to end) Tj
T*
(   self.cache.move_to_end\(key\)) Tj
T*
(   return self.cache[key]) Tj
T*
() Tj
T*
(   def put\(self, key: int, value: int\):) Tj
T*
(   if key in self.cache:) Tj
T*
(   self.cache.move_to_end\(key\)) Tj
T*
(   self.cache[key] = value) Tj
T*
(   if len\(self.cache\) > self.capacity:) Tj
T*
(   # Evict least recently used \(first item in FIFO order\)) Tj
T*
(   oldest_key, _ = self.cache.popitem\(last=False\)) Tj
T*
(   print\(f" [EVICTION] Capacity exceeded. Evicted key: {oldest_key}"\)) Tj
T*
() Tj
T*
(   def display\(self\):) Tj
T*
(   print\(f"Current Cache State \(Oldest -> Newest\): {list\(self.cache.items\(\)\)}"\)) Tj
T*
() Tj
T*
(   # Demonstration) Tj
T*
(   lru = LRUCache\(capacity=2\)) Tj
T*
(   print\("Initialized LRU Cache with capacity=2"\)) Tj
T*
(   lru.put\(1, 10\)) Tj
T*
(   lru.put\(2, 20\)) Tj
T*
(   lru.display\(\)) Tj
T*
() Tj
T*
(   print\(f"Access key 1: {lru.get\(1\)}"\)) Tj
T*
ET

endstream
