12.5 TL
(   [Problem Statement]: Implement a Text Analytics & Word Frequency Counter in Python using strings, lists, dictionaries, and collections.Counter with punctuation stripping.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Problem Context:) Tj
T*
(   Develop a text analytics program that takes a block of raw prose, sanitizes it \(converts to) Tj
T*
(   lowercase, removes punctuation\), computes word frequencies, finds the top K most common words,) Tj
T*
(   and calculates average word length.) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   import string) Tj
T*
(   from collections import Counter) Tj
T*
() Tj
T*
(   class TextAnalyticsEngine:) Tj
T*
(   def __init__\(self, raw_text: str\):) Tj
T*
(   self.raw_text = raw_text) Tj
T*
(   self.tokens = self._tokenize\(\)) Tj
T*
() Tj
T*
(   def _tokenize\(self\) -> list:) Tj
T*
(   # Translation table to remove punctuation) Tj
T*
(   translator = str.maketrans\('', '', string.punctuation\)) Tj
T*
(   clean_text = self.raw_text.translate\(translator\).lower\(\)) Tj
T*
(   return clean_text.split\(\)) Tj
T*
() Tj
T*
(   def get_word_frequencies\(self\) -> dict:) Tj
T*
(   freq = {}) Tj
T*
(   for w in self.tokens:) Tj
T*
(   freq[w] = freq.get\(w, 0\) + 1) Tj
T*
(   return freq) Tj
T*
() Tj
T*
(   def top_k_words\(self, k=3\) -> list:) Tj
T*
(   counts = Counter\(self.tokens\)) Tj
T*
(   return counts.most_common\(k\)) Tj
T*
() Tj
T*
(   def average_word_length\(self\) -> float:) Tj
T*
(   if not self.tokens:) Tj
T*
(   return 0.0) Tj
T*
(   total_chars = sum\(len\(w\) for w in self.tokens\)) Tj
T*
(   return round\(total_chars / len\(self.tokens\), 2\)) Tj
T*
() Tj
T*
(   # Verification) Tj
T*
(   prose = """Python is an interpreted, high-level, general-purpose programming language.) Tj
T*
(   Python's design philosophy emphasizes code readability. Python is dynamically typed.""") Tj
T*
() Tj
T*
(   engine = TextAnalyticsEngine\(prose\)) Tj
T*
(   print\(f"Total Words Processed: {len\(engine.tokens\)}"\)) Tj
T*
(   print\(f"Average Word Length: {engine.average_word_length\(\)} characters"\)) Tj
T*
(   print\(f"Top 3 Most Frequent Words: {engine.top_k_words\(3\)}"\)) Tj
T*
(   print\(f"Vocabulary Size: {len\(engine.get_word_frequencies\(\)\)} unique words"\)) Tj
T*
() Tj
T*
(   3. Complexity Analysis:) Tj
T*
(   - Tokenization Time Complexity: O\(N\) where N is character count.) Tj
T*
ET

endstream
endobj
