(>> Solution to Question 29:) Tj
T*
ET
BT
/F1 8.5 Tf
12.5 TL
(   [Problem Statement]: Design an Inventory Management System in Python using dictionaries, handling stock reorders, low-stock alerts, and batch transactions.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Problem Context:) Tj
T*
(   Develop a retail inventory tracker using nested dictionaries:) Tj
T*
(   Item SKU -> {name, unit_price, quantity, reorder_threshold}.) Tj
T*
(   The system handles stock sales, restocks, low-stock alerts, and inventory valuation reports.) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   class RetailInventoryManager:) Tj
T*
(   def __init__\(self\):) Tj
T*
(   self.inventory = {}) Tj
T*
() Tj
T*
(   def add_product\(self, sku: str, name: str, price: float, initial_qty: int, threshold: int\):) Tj
T*
(   self.inventory[sku] = {) Tj
T*
(   "name": name,) Tj
T*
(   "price": price,) Tj
T*
(   "qty": initial_qty,) Tj
T*
(   "threshold": threshold) Tj
T*
(   }) Tj
T*
() Tj
T*
(   def process_sale\(self, sku: str, quantity: int\) -> float:) Tj
T*
(   if sku not in self.inventory:) Tj
T*
(   raise KeyError\(f"SKU {sku} not found in inventory catalog."\)) Tj
T*
(   item = self.inventory[sku]) Tj
T*
(   if item["qty"] < quantity:) Tj
T*
(   raise ValueError\(f"Insufficient Stock for {item['name']}. Available: {item['qty']}, Requested:) Tj
T*
(   {quantity}"\)) Tj
T*
(   item["qty"] -= quantity) Tj
T*
(   revenue = quantity * item["price"]) Tj
T*
(   return revenue) Tj
T*
() Tj
T*
(   def check_reorder_alerts\(self\) -> list:) Tj
T*
(   alerts = []) Tj
T*
(   for sku, data in self.inventory.items\(\):) Tj
T*
(   if data["qty"] <= data["threshold"]:) Tj
T*
(   alerts.append\(\(sku, data["name"], data["qty"], data["threshold"]\)\)) Tj
T*
(   return alerts) Tj
T*
() Tj
T*
(   # Demonstration) Tj
T*
(   inv = RetailInventoryManager\(\)) Tj
T*
(   inv.add_product\("SKU-101", "USB-C Cable", 9.99, 50, 10\)) Tj
T*
(   inv.add_product\("SKU-102", "Wireless Mouse", 24.50, 12, 15\)) Tj
T*
() Tj
T*
(   rev = inv.process_sale\("SKU-101", 5\)) Tj
T*
(   print\(f"Processed Sale: Generated ${rev:.2f}"\)) Tj
T*
() Tj
T*
(   alerts = inv.check_reorder_alerts\(\)) Tj
T*
(   print\(f"Low Stock Alerts: {alerts}"\)) Tj
T*
ET

endstream
