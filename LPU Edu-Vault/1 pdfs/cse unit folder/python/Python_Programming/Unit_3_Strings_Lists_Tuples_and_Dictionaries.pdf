(>> Solution to Question 30:) Tj
T*
ET
BT
/F1 8.5 Tf
12.5 TL
(   [Problem Statement]: Implement a Custom Matrix Determinant and Matrix Inversion program for 2x2 and 3x3 matrices in Python using nested lists.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Mathematical Formulation:) Tj
T*
(   - 2x2 Matrix A = [[a, b], [c, d]]:) Tj
T*
(   det\(A\) = a*d - b*c) Tj
T*
(   A^\(-1\) = \(1 / det\(A\)\) * [[d, -b], [-c, a]]) Tj
T*
(   - 3x3 Matrix Determinant via cofactor expansion:) Tj
T*
(   det\(A\) = A[0][0]*\(A[1][1]*A[2][2] - A[1][2]*A[2][1]\)) Tj
T*
(   - A[0][1]*\(A[1][0]*A[2][2] - A[1][2]*A[2][0]\)) Tj
T*
(   + A[0][2]*\(A[1][0]*A[2][1] - A[1][1]*A[2][0]\)) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   class MatrixMath:) Tj
T*
(   @staticmethod) Tj
T*
(   def det_2x2\(m: list\) -> float:) Tj
T*
(   return \(m[0][0] * m[1][1]\) - \(m[0][1] * m[1][0]\)) Tj
T*
() Tj
T*
(   @staticmethod) Tj
T*
(   def invert_2x2\(m: list\) -> list:) Tj
T*
(   d = MatrixMath.det_2x2\(m\)) Tj
T*
(   if abs\(d\) < 1e-12:) Tj
T*
(   raise ValueError\("Singular Matrix: Determinant is zero; cannot invert."\)) Tj
T*
(   inv_d = 1.0 / d) Tj
T*
(   return [) Tj
T*
(   [round\(m[1][1] * inv_d, 4\), round\(-m[0][1] * inv_d, 4\)],) Tj
T*
(   [round\(-m[1][0] * inv_d, 4\), round\(m[0][0] * inv_d, 4\)]) Tj
T*
(   ]) Tj
T*
() Tj
T*
(   @staticmethod) Tj
T*
(   def det_3x3\(m: list\) -> float:) Tj
T*
(   c0 = m[0][0] * \(m[1][1] * m[2][2] - m[1][2] * m[2][1]\)) Tj
T*
(   c1 = m[0][1] * \(m[1][0] * m[2][2] - m[1][2] * m[2][0]\)) Tj
T*
(   c2 = m[0][2] * \(m[1][0] * m[2][1] - m[1][1] * m[2][0]\)) Tj
T*
(   return c0 - c1 + c2) Tj
T*
() Tj
T*
(   # Verification) Tj
T*
(   m2 = [[4, 7], [2, 6]]) Tj
T*
(   det2 = MatrixMath.det_2x2\(m2\)) Tj
T*
(   inv2 = MatrixMath.invert_2x2\(m2\)) Tj
T*
(   print\(f"2x2 Matrix: {m2} | Determinant = {det2}"\)) Tj
T*
(   print\(f"Inverse of 2x2 Matrix: {inv2}"\)) Tj
T*
() Tj
T*
(   m3 = [[6, 1, 1], [4, -2, 5], [2, 8, 7]]) Tj
T*
(   print\(f"3x3 Matrix Determinant: {MatrixMath.det_3x3\(m3\)}"\)) Tj
T*
() Tj
T*
ET

endstream
