12.5 TL
(   [Problem Statement]: Implement a Student Gradebook Management System in Python using nested dictionaries, calculating per-student weighted GPAs and class statistics.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Problem Context:) Tj
T*
(   Design a student record system where each student is keyed by Student ID. Each student contains) Tj
T*
(   demographic data and a dictionary of enrolled courses with credits and letter grades. The) Tj
T*
(   program computes individual cumulative GPA \(on a 4.0 scale\) and identifies class toppers.) Tj
T*
() Tj
T*
(   2. Grade Mapping:) Tj
T*
(   Letter grades correspond to grade points:) Tj
T*
(   'A': 4.0, 'B': 3.0, 'C': 2.0, 'D': 1.0, 'F': 0.0.) Tj
T*
(   GPA = Sum\(Grade_Points * Credits\) / Sum\(Credits\).) Tj
T*
() Tj
T*
(   3. Python Implementation:) Tj
T*
(   class GradebookSystem:) Tj
T*
(   GRADE_SCALE = {'A': 4.0, 'B': 3.0, 'C': 2.0, 'D': 1.0, 'F': 0.0}) Tj
T*
() Tj
T*
(   def __init__\(self\):) Tj
T*
(   self.students = {}) Tj
T*
() Tj
T*
(   def add_student\(self, student_id: str, name: str\):) Tj
T*
(   self.students[student_id] = {"name": name, "courses": {}}) Tj
T*
() Tj
T*
(   def add_course_grade\(self, student_id: str, course_code: str, credits: int, grade: str\):) Tj
T*
(   if student_id not in self.students:) Tj
T*
(   raise KeyError\(f"Student {student_id} not found."\)) Tj
T*
(   self.students[student_id]["courses"][course_code] = {"credits": credits, "grade":) Tj
T*
(   grade.upper\(\)}) Tj
T*
() Tj
T*
(   def calculate_gpa\(self, student_id: str\) -> float:) Tj
T*
(   courses = self.students[student_id]["courses"]) Tj
T*
(   if not courses:) Tj
T*
(   return 0.0) Tj
T*
(   total_points = sum\(self.GRADE_SCALE[c["grade"]] * c["credits"] for c in courses.values\(\)\)) Tj
T*
(   total_credits = sum\(c["credits"] for c in courses.values\(\)\)) Tj
T*
(   return round\(total_points / total_credits, 2\)) Tj
T*
() Tj
T*
(   def display_report\(self\):) Tj
T*
(   print\("=" * 65\)) Tj
T*
(   print\(f"{'ID':<10}{'Name':<20}{'Courses Taken':<18}{'Cumulative GPA':<15}"\)) Tj
T*
(   print\("-" * 65\)) Tj
T*
(   for s_id, data in self.students.items\(\):) Tj
T*
(   gpa = self.calculate_gpa\(s_id\)) Tj
T*
(   print\(f"{s_id:<10}{data['name']:<20}{len\(data['courses']\):<18}{gpa:<15}"\)) Tj
T*
(   print\("=" * 65\)) Tj
T*
() Tj
T*
(   # Verification) Tj
T*
(   gb = GradebookSystem\(\)) Tj
T*
ET

endstream
