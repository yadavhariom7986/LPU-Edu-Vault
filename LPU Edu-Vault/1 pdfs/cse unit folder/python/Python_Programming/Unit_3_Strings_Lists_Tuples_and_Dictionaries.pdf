12.5 TL
(   [Problem Statement]: Implement Matrix Multiplication in Python using nested lists and nested loops, validating inner matrix dimension compatibility.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Mathematical Formulation:) Tj
T*
(   Let A be an \(M x K\) matrix and B be a \(K x N\) matrix:) Tj
T*
(   Matrix multiplication C = A x B is valid if and only if:) Tj
T*
(   Number of Columns in A == Number of Rows in B \(Inner Dimension Match = K\).) Tj
T*
(   The resulting product matrix C has dimensions \(M x N\) where:) Tj
T*
(   C[i][j] = Sum_{p=0}^{K-1} A[i][p] * B[p][j].) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   def multiply_matrices_checked\(A: list, B: list\) -> list:) Tj
T*
(   rows_A = len\(A\)) Tj
T*
(   cols_A = len\(A[0]\)) Tj
T*
(   rows_B = len\(B\)) Tj
T*
(   cols_B = len\(B[0]\)) Tj
T*
() Tj
T*
(   # Validation check) Tj
T*
(   if cols_A != rows_B:) Tj
T*
(   raise ValueError\(f"Dimension Mismatch: Cannot multiply \({rows_A}x{cols_A}\) with) Tj
T*
(   \({rows_B}x{cols_B}\)."\)) Tj
T*
() Tj
T*
(   # Pre-allocate result matrix of size rows_A x cols_B with zeros) Tj
T*
(   C = [[0 for _ in range\(cols_B\)] for _ in range\(rows_A\)]) Tj
T*
() Tj
T*
(   # Triple nested loop evaluation) Tj
T*
(   for i in range\(rows_A\):) Tj
T*
(   for j in range\(cols_B\):) Tj
T*
(   dot_product = 0) Tj
T*
(   for p in range\(cols_A\):) Tj
T*
(   dot_product += A[i][p] * B[p][j]) Tj
T*
(   C[i][j] = dot_product) Tj
T*
() Tj
T*
(   return C) Tj
T*
() Tj
T*
(   # Demonstration) Tj
T*
(   matA = [[1, 2, 3],) Tj
T*
(   [4, 5, 6]] # 2 x 3) Tj
T*
ET

endstream
