(   If any direction leads to target -> Return True.) Tj
T*
(   4. If all directions fail: Unmark cell \(backtrack\) and return False.) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   class MazeSolver:) Tj
T*
(   @staticmethod) Tj
T*
(   def solve\(maze\):) Tj
T*
(   rows = len\(maze\)) Tj
T*
(   cols = len\(maze[0]\)) Tj
T*
(   path = []) Tj
T*
() Tj
T*
(   def backtrack\(r, c\):) Tj
T*
(   if not \(0 <= r < rows and 0 <= c < cols\):) Tj
T*
(   return False) Tj
T*
(   if maze[r][c] != 0:) Tj
T*
(   return False # Wall or already visited) Tj
T*
() Tj
T*
(   maze[r][c] = 2 # Mark cell as part of solution path) Tj
T*
(   path.append\(\(r, c\)\)) Tj
T*
() Tj
T*
(   # Target reached) Tj
T*
(   if r == rows - 1 and c == cols - 1:) Tj
T*
(   return True) Tj
T*
() Tj
T*
(   # Explore Down, Right, Up, Left) Tj
T*
(   if \(backtrack\(r + 1, c\) or) Tj
T*
(   backtrack\(r, c + 1\) or) Tj
T*
(   backtrack\(r - 1, c\) or) Tj
T*
(   backtrack\(r, c - 1\)\):) Tj
T*
(   return True) Tj
T*
() Tj
T*
(   # Backtrack) Tj
T*
(   path.pop\(\)) Tj
T*
(   maze[r][c] = 3 # Mark as dead end) Tj
T*
(   return False) Tj
T*
() Tj
T*
(   success = backtrack\(0, 0\)) Tj
T*
(   return success, path) Tj
T*
() Tj
T*
(   # Verification) Tj
T*
(   test_maze = [) Tj
T*
(   [0, 1, 0, 0],) Tj
T*
(   [0, 0, 0, 1],) Tj
T*
(   [1, 0, 1, 0],) Tj
T*
(   [0, 0, 0, 0]) Tj
T*
(   ]) Tj
T*
() Tj
T*
(   solved, solution_path = MazeSolver.solve\(test_maze\)) Tj
T*
(   print\(f"Maze Solvable? {solved}"\)) Tj
T*
(   print\(f"Path Coordinates \({len\(solution_path\)} steps\): {solution_path}"\)) Tj
T*
() Tj
T*
(   3. Complexity Analysis:) Tj
T*
(   - Time Complexity: O\(4^\(M*N\)\) worst case; bounded by O\(M * N\) with visited memoization.) Tj
T*
(   - Space Complexity: O\(M * N\) call stack and path buffer.) Tj
T*
ET

