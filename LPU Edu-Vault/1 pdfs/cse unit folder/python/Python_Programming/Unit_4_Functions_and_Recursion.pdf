(   2. Python Implementation:) Tj
T*
(   import re) Tj
T*
() Tj
T*
(   def is_markup_balanced\(html_str: str\) -> bool:) Tj
T*
(   tag_regex = re.compile\(r'</?\([a-zA-Z0-9]+\)>'\)) Tj
T*
(   tags = tag_regex.findall\(html_str\)) Tj
T*
(   raw_tokens = tag_regex.finditer\(html_str\)) Tj
T*
() Tj
T*
(   stack = []) Tj
T*
(   for match in raw_tokens:) Tj
T*
(   full_tag = match.group\(0\)) Tj
T*
(   tag_name = match.group\(1\)) Tj
T*
() Tj
T*
(   if full_tag.startswith\("</"\): # Closing tag) Tj
T*
(   if not stack or stack[-1] != tag_name:) Tj
T*
(   return False) Tj
T*
(   stack.pop\(\)) Tj
T*
(   else: # Opening tag) Tj
T*
(   stack.append\(tag_name\)) Tj
T*
() Tj
T*
(   return len\(stack\) == 0) Tj
T*
() Tj
T*
(   # Verification) Tj
T*
(   valid_html = "<html><body><h1>Title</h1><p>Body</p></body></html>") Tj
T*
(   invalid_html = "<html><body><h1>Title</p></h1></body></html>") Tj
T*
() Tj
T*
(   print\(f"Is valid_html balanced? {is_markup_balanced\(valid_html\)}"\)) Tj
T*
(   print\(f"Is invalid_html balanced? {is_markup_balanced\(invalid_html\)}"\)) Tj
T*
() Tj
T*
(   3. Complexity Analysis:) Tj
T*
(   - Time Complexity: O\(N\) regex scan.) Tj
T*
(   - Space Complexity: O\(Depth\) tag stack.) Tj
T*
() Tj
T*
