T*
(   def factorial_tail_thunk\(n: int, acc=1\):) Tj
T*
(   if n <= 1:) Tj
T*
(   return acc) Tj
T*
(   # Return a lambda thunk instead of recursing directly) Tj
T*
(   return lambda: factorial_tail_thunk\(n - 1, acc * n\)) Tj
T*
() Tj
T*
(   # Run via Trampoline) Tj
T*
(   big_n = 500) Tj
T*
(   result = Trampoline.call\(factorial_tail_thunk, big_n\)) Tj
T*
(   print\(f"Factorial\({big_n}\) computed with Trampoline without StackOverflow!"\)) Tj
T*
(   print\(f"Digits in {big_n}!: {len\(str\(result\)\)} digits"\)) Tj
T*
() Tj
T*
(   3. Complexity Analysis:) Tj
T*
(   - Time Complexity: O\(N\) linear loop.) Tj
T*
(   - Stack Space: O\(1\) strictly constant stack depth!) Tj
T*
() Tj
T*
(--------------------------------------------------------------------------------) Tj
T*
