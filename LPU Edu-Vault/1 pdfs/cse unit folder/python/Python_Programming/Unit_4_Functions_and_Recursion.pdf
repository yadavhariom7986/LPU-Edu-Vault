(   - Term: Factor \(\( '*' | '/' \) Factor\)*) Tj
T*
(   - Factor: Number | '\(' Expression '\)') Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   class SimpleCalculatorParser:) Tj
T*
(   def __init__\(self, expression: str\):) Tj
T*
(   self.tokens = expression.replace\(" ", ""\)) Tj
T*
(   self.pos = 0) Tj
T*
() Tj
T*
(   def parse\(self\) -> float:) Tj
T*
(   return self._expr\(\)) Tj
T*
() Tj
T*
(   def _expr\(self\) -> float:) Tj
T*
(   val = self._term\(\)) Tj
T*
(   while self.pos < len\(self.tokens\) and self.tokens[self.pos] in \('+', '-'\):) Tj
T*
(   op = self.tokens[self.pos]) Tj
T*
(   self.pos += 1) Tj
T*
(   term_val = self._term\(\)) Tj
T*
(   val = val + term_val if op == '+' else val - term_val) Tj
T*
(   return val) Tj
T*
() Tj
T*
(   def _term\(self\) -> float:) Tj
T*
(   val = self._factor\(\)) Tj
T*
(   while self.pos < len\(self.tokens\) and self.tokens[self.pos] in \('*', '/'\):) Tj
T*
(   op = self.tokens[self.pos]) Tj
T*
(   self.pos += 1) Tj
T*
(   factor_val = self._factor\(\)) Tj
T*
(   val = val * factor_val if op == '*' else val / factor_val) Tj
T*
(   return val) Tj
T*
() Tj
T*
(   def _factor\(self\) -> float:) Tj
T*
(   if self.tokens[self.pos] == '\(':) Tj
T*
(   self.pos += 1 # Skip '\(') Tj
T*
(   val = self._expr\(\)) Tj
T*
(   self.pos += 1 # Skip '\)') Tj
T*
(   return val) Tj
T*
() Tj
T*
(   # Parse number) Tj
T*
(   start = self.pos) Tj
T*
(   while self.pos < len\(self.tokens\) and \(self.tokens[self.pos].isdigit\(\) or self.tokens[self.pos]) Tj
T*
(   == '.'\):) Tj
T*
(   self.pos += 1) Tj
T*
(   return float\(self.tokens[start:self.pos]\)) Tj
T*
() Tj
T*
(   # Verification) Tj
T*
(   calc = SimpleCalculatorParser\("3 + 5 * \(10 - 2\) / 4"\)) Tj
T*
(   calc_result = calc.parse\(\)) Tj
T*
(   print\(f"Parsed '3 + 5 * \(10 - 2\) / 4' = {calc_result} \(Expected: {3 + 5 * \(10 - 2\) / 4}\)"\)) Tj
T*
() Tj
T*
(   3. Complexity Analysis:) Tj
T*
(   - Time Complexity: O\(N\) single linear pass over tokens.) Tj
T*
(   - Space Complexity: O\(Depth\) recursion stack for nested parentheses.) Tj
T*
() Tj
T*
