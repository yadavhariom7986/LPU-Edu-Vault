12.5 TL
(   [Problem Statement]: Implement the N-Queens Puzzle in Python using recursive backtracking. Find all valid non-attacking queen configurations on an N x N chessboard.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Problem Context:) Tj
T*
(   Place N non-attacking queens on an N x N chessboard such that no two queens share the same row,) Tj
T*
(   column, or diagonal.) Tj
T*
() Tj
T*
(   2. Backtracking Formulation:) Tj
T*
(   Place queens column by column:) Tj
T*
(   1. Base Case: If current column == N -> All N queens placed successfully! Record solution.) Tj
T*
(   2. For each row r in current column c:) Tj
T*
(   Check if position \(r, c\) is safe:) Tj
T*
(   - Row r not already occupied.) Tj
T*
(   - Main diagonal \(r - c\) not occupied.) Tj
T*
(   - Anti-diagonal \(r + c\) not occupied.) Tj
T*
(   3. If safe: Place queen, mark sets, and recurse for column c + 1.) Tj
T*
(   4. Backtrack: Remove queen and unmark sets.) Tj
T*
() Tj
T*
(   3. Python Implementation:) Tj
T*
(   class NQueensSolver:) Tj
T*
(   def __init__\(self, n: int\):) Tj
T*
(   self.n = n) Tj
T*
(   self.solutions = []) Tj
T*
(   self._solve\(\)) Tj
T*
() Tj
T*
(   def _solve\(self\):) Tj
T*
(   cols = set\(\)) Tj
T*
(   pos_diag = set\(\) # \(r + c\)) Tj
T*
(   neg_diag = set\(\) # \(r - c\)) Tj
T*
(   board = [["." for _ in range\(self.n\)] for _ in range\(self.n\)]) Tj
T*
() Tj
T*
(   def backtrack\(c\):) Tj
T*
(   if c == self.n:) Tj
T*
(   self.solutions.append\(["".join\(row\) for row in board]\)) Tj
T*
(   return) Tj
T*
() Tj
T*
(   for r in range\(self.n\):) Tj
T*
(   if \(r in cols\) or \(\(r + c\) in pos_diag\) or \(\(r - c\) in neg_diag\):) Tj
T*
(   continue) Tj
T*
() Tj
T*
(   # Place queen) Tj
T*
(   cols.add\(r\)) Tj
T*
(   pos_diag.add\(r + c\)) Tj
T*
(   neg_diag.add\(r - c\)) Tj
T*
(   board[r][c] = "Q") Tj
T*
() Tj
T*
(   backtrack\(c + 1\)) Tj
T*
() Tj
T*
(   # Backtrack) Tj
T*
(   cols.remove\(r\)) Tj
T*
(   pos_diag.remove\(r + c\)) Tj
T*
ET

endstream
