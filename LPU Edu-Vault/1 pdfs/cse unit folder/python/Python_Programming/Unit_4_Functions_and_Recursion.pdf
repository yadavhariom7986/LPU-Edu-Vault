() Tj
T*
(   mid = len\(arr\) // 2) Tj
T*
(   # Divide) Tj
T*
(   left_sorted = merge_sort\(arr[:mid]\)) Tj
T*
(   right_sorted = merge_sort\(arr[mid:]\)) Tj
T*
() Tj
T*
(   # Combine / Merge) Tj
T*
(   merged = []) Tj
T*
(   i = j = 0) Tj
T*
() Tj
T*
(   while i < len\(left_sorted\) and j < len\(right_sorted\):) Tj
T*
(   if left_sorted[i] <= right_sorted[j]:) Tj
T*
(   merged.append\(left_sorted[i]\)) Tj
T*
(   i += 1) Tj
T*
(   else:) Tj
T*
(   merged.append\(right_sorted[j]\)) Tj
T*
(   j += 1) Tj
T*
() Tj
T*
(   # Append any remaining elements) Tj
T*
(   merged.extend\(left_sorted[i:]\)) Tj
T*
(   merged.extend\(right_sorted[j:]\)) Tj
T*
(   return merged) Tj
T*
() Tj
T*
