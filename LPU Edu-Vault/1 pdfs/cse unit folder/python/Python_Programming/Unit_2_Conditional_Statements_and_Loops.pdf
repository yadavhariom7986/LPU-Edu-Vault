(   [Problem Statement]: Implement a Number Guessing Game in Python with binary search hints, random number generation, input validation, and attempt tracking.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Problem Context:) Tj
T*
(   Develop an interactive number guessing game. The computer generates a secret pseudo-random) Tj
T*
(   integer between 1 and 100. The player inputs guesses, and the program provides directional) Tj
T*
(   feedback \('Too High', 'Too Low', 'Correct!'\) while tracking the number of attempts and handling) Tj
T*
(   invalid non-numeric inputs gracefully.) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   import random) Tj
T*
() Tj
T*
(   def play_number_guessing_game\(secret_number=None, simulated_guesses=None\):) Tj
T*
(   """Simulated or interactive number guessing game engine.""") Tj
T*
(   if secret_number is None:) Tj
T*
(   secret_number = random.randint\(1, 100\)) Tj
T*
() Tj
T*
(   print\(f"Game Started! Target number selected in range [1, 100]."\)) Tj
T*
(   attempts = 0) Tj
T*
(   guess_history = []) Tj
T*
() Tj
T*
(   # If simulated_guesses provided, run automated test; otherwise interactive) Tj
T*
(   inputs = iter\(simulated_guesses\) if simulated_guesses else None) Tj
T*
() Tj
T*
(   while True:) Tj
T*
(   attempts += 1) Tj
T*
(   # Retrieve guess) Tj
T*
(   if inputs:) Tj
T*
(   try:) Tj
T*
(   user_guess = next\(inputs\)) Tj
T*
(   except StopIteration:) Tj
T*
(   print\("Simulation exhausted without guessing correctly."\)) Tj
T*
(   break) Tj
T*
(   else:) Tj
T*
(   raw = input\("Enter your guess \(1-100\): "\).strip\(\)) Tj
T*
(   try:) Tj
T*
(   user_guess = int\(raw\)) Tj
T*
(   except ValueError:) Tj
T*
(   print\(" Invalid Input: Please enter an integer."\)) Tj
T*
(   continue) Tj
T*
() Tj
T*
(   guess_history.append\(user_guess\)) Tj
T*
() Tj
T*
(   # Evaluate guess against secret target) Tj
T*
(   if user_guess < secret_number:) Tj
T*
(   print\(f" Attempt {attempts}: Guess {user_guess} is TOO LOW. Aim higher!"\)) Tj
T*
(   elif user_guess > secret_number:) Tj
T*
(   print\(f" Attempt {attempts}: Guess {user_guess} is TOO HIGH. Aim lower!"\)) Tj
T*
ET

