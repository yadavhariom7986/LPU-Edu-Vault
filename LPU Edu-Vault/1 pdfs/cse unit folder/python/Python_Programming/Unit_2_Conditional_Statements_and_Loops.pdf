/F1 8.5 Tf
12.5 TL
(   [Problem Statement]: Implement a Binary Search algorithm using while loops. Analyze search intervals, mid calculation, logarithmic convergence, and asymptotic complexity.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Theoretical Basis of Binary Search:) Tj
T*
(   Binary Search is a divide-and-conquer algorithm designed to locate a target value within a) Tj
T*
(   sorted collection:) Tj
T*
(   Algorithm:) Tj
T*
(   1. Initialize two pointers: low = 0, high = len\(arr\) - 1.) Tj
T*
(   2. While low <= high:) Tj
T*
(   Calculate midpoint: mid = low + \(high - low\) // 2 \(avoids integer overflow\).) Tj
T*
(   - If arr[mid] == target -> Success, return mid.) Tj
T*
(   - If arr[mid] < target -> Target must lie in the right half: low = mid + 1.) Tj
T*
(   - If arr[mid] > target -> Target must lie in the left half: high = mid - 1.) Tj
T*
(   3. If low > high without finding target, return -1 \(Not Found\).) Tj
T*
() Tj
T*
(   2. Python Implementation with Step Trace:) Tj
T*
(   def binary_search_iterative\(arr: list, target: int\) -> int:) Tj
T*
(   """Iterative Binary Search with execution trace.""") Tj
T*
(   low = 0) Tj
T*
(   high = len\(arr\) - 1) Tj
T*
(   step = 1) Tj
T*
() Tj
T*
(   print\(f"Binary Search for Target: {target} in sorted array of {len\(arr\)} elements."\)) Tj
T*
(   print\(f"{'Step':<8}{'Low':<8}{'High':<8}{'Mid':<8}{'Val':<8}{'Action':<25}"\)) Tj
T*
(   print\("-" * 65\)) Tj
T*
() Tj
T*
(   while low <= high:) Tj
T*
(   mid = \(low + high\) // 2) Tj
T*
(   val = arr[mid]) Tj
T*
() Tj
T*
(   if val == target:) Tj
T*
(   print\(f"{step:<8}{low:<8}{high:<8}{mid:<8}{val:<8}{'Match Found!':<25}"\)) Tj
T*
(   return mid) Tj
T*
(   elif val < target:) Tj
T*
(   print\(f"{step:<8}{low:<8}{high:<8}{mid:<8}{val:<8}{'Search Right \(low=mid+1\)':<25}"\)) Tj
T*
(   low = mid + 1) Tj
T*
(   else:) Tj
T*
(   print\(f"{step:<8}{low:<8}{high:<8}{mid:<8}{val:<8}{'Search Left \(high=mid-1\)':<25}"\)) Tj
T*
(   high = mid - 1) Tj
T*
() Tj
T*
(   step += 1) Tj
T*
() Tj
T*
(   print\(f"Target {target} not present in collection."\)) Tj
T*
(   return -1) Tj
T*
() Tj
T*
(   # Verification on sorted list) Tj
T*
(   dataset = [12, 24, 32, 45, 57, 68, 79, 83, 91, 105, 120]) Tj
T*
(   target_val = 83) Tj
T*
(   result_idx = binary_search_iterative\(dataset, target_val\)) Tj
T*
ET

endstream
