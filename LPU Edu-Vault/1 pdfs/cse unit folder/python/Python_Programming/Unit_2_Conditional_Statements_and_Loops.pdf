12.5 TL
(   [Problem Statement]: Implement a Palindrome and Armstrong Number Validator in Python using numeric while loops without converting numbers to strings.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Algorithmic Formulation:) Tj
T*
(   - Palindrome Number: A number that reads the same backward as forward \(e.g., 12321\).) Tj
T*
(   Reversed number is built by repeatedly extracting the last digit: rev = \(rev * 10\) + \(temp %) Tj
T*
(   10\); temp //= 10.) Tj
T*
(   - Armstrong \(Narcissistic\) Number: An n-digit number equal to the sum of its digits each raised) Tj
T*
(   to the power n \(e.g., 153 = 1^3 + 5^3 + 3^3 = 1 + 125 + 27 = 153\).) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   class NumberValidator:) Tj
T*
(   @staticmethod) Tj
T*
(   def is_palindrome\(num: int\) -> bool:) Tj
T*
(   if num < 0:) Tj
T*
(   return False # Negative numbers cannot be palindromes due to minus sign) Tj
T*
() Tj
T*
(   orig = num) Tj
T*
(   rev = 0) Tj
T*
(   temp = num) Tj
T*
(   while temp > 0:) Tj
T*
(   digit = temp % 10) Tj
T*
(   rev = \(rev * 10\) + digit) Tj
T*
(   temp //= 10) Tj
T*
(   return orig == rev) Tj
T*
() Tj
T*
(   @staticmethod) Tj
T*
(   def is_armstrong\(num: int\) -> bool:) Tj
T*
(   if num < 0:) Tj
T*
(   return False) Tj
T*
() Tj
T*
(   # Count digits mathematically) Tj
T*
(   temp = num) Tj
T*
(   num_digits = 0) Tj
T*
(   while temp > 0:) Tj
T*
(   num_digits += 1) Tj
T*
(   temp //= 10) Tj
T*
() Tj
T*
(   temp = num) Tj
T*
(   armstrong_sum = 0) Tj
T*
(   while temp > 0:) Tj
T*
(   digit = temp % 10) Tj
T*
(   armstrong_sum += digit ** num_digits) Tj
T*
(   temp //= 10) Tj
T*
() Tj
T*
(   return armstrong_sum == num) Tj
T*
() Tj
T*
(   # Verification) Tj
T*
(   print\(f"Is 12321 a Palindrome? {NumberValidator.is_palindrome\(12321\)}"\)) Tj
T*
(   print\(f"Is 12345 a Palindrome? {NumberValidator.is_palindrome\(12345\)}"\)) Tj
T*
(   print\(f"Is 153 an Armstrong Number? {NumberValidator.is_armstrong\(153\)}"\)) Tj
T*
(   print\(f"Is 9474 an Armstrong Number? \(9^4+4^4+7^4+4^4\) ->) Tj
T*
ET

endstream
endobj
