(   self._balance = initial_balance) Tj
T*
(   self._transaction_log = [f"Account opened with initial balance: ${initial_balance:.2f}"]) Tj
T*
() Tj
T*
(   def authenticate\(self, entered_pin: str\) -> bool:) Tj
T*
(   return entered_pin == self._pin) Tj
T*
() Tj
T*
(   def run_simulation\(self, commands\):) Tj
T*
(   print\("=" * 55\)) Tj
T*
(   print\(" WELCOME TO PYTHON SECURE BANK ATM "\)) Tj
T*
(   print\("=" * 55\)) Tj
T*
() Tj
T*
(   cmd_iter = iter\(commands\)) Tj
T*
() Tj
T*
(   while True:) Tj
T*
(   try:) Tj
T*
(   action = next\(cmd_iter\)) Tj
T*
(   except StopIteration:) Tj
T*
(   break) Tj
T*
() Tj
T*
(   op = action.get\("type"\)) Tj
T*
() Tj
T*
(   if op == "BALANCE":) Tj
T*
(   print\(f"[ACTION] Current Available Balance: ${self._balance:,.2f}"\)) Tj
T*
(   elif op == "DEPOSIT":) Tj
T*
(   amount = action.get\("amount", 0.0\)) Tj
T*
(   if amount <= 0:) Tj
T*
(   print\("[ERROR] Deposit amount must be positive."\)) Tj
T*
(   else:) Tj
T*
(   self._balance += amount) Tj
T*
(   self._transaction_log.append\(f"Deposited: +${amount:.2f}"\)) Tj
T*
(   print\(f"[SUCCESS] Deposited ${amount:,.2f}. New Balance: ${self._balance:,.2f}"\)) Tj
T*
(   elif op == "WITHDRAW":) Tj
T*
(   amount = action.get\("amount", 0.0\)) Tj
T*
(   if amount > self._balance:) Tj
T*
(   print\(f"[REJECTED] Overdraft limit exceeded. Balance: ${self._balance:,.2f}"\)) Tj
T*
(   elif amount <= 0:) Tj
T*
(   print\("[ERROR] Withdrawal amount must be positive."\)) Tj
T*
(   else:) Tj
T*
(   self._balance -= amount) Tj
T*
(   self._transaction_log.append\(f"Withdrawn: -${amount:.2f}"\)) Tj
T*
(   print\(f"[SUCCESS] Dispensed ${amount:,.2f}. Remaining Balance: ${self._balance:,.2f}"\)) Tj
T*
(   elif op == "STATEMENT":) Tj
T*
(   print\("--- MINI STATEMENT AUDIT LOG ---"\)) Tj
T*
(   for entry in self._transaction_log:) Tj
T*
(   print\(f" * {entry}"\)) Tj
T*
(   elif op == "EXIT":) Tj
T*
(   print\("Session terminated. Thank you for banking with us!"\)) Tj
T*
