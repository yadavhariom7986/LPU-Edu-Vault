12.5 TL
(   [Problem Statement]: Implement a Matrix Transpose and Matrix Addition program in Python using nested loops and 2D list comprehensions.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Mathematical Concepts:) Tj
T*
(   Given matrix A of dimensions R x C:) Tj
T*
(   1. Matrix Transpose \(A^T\): Dimensions become C x R where:) Tj
T*
(   A^T[j][i] = A[i][j]) Tj
T*
(   2. Matrix Addition \(A + B\): Valid only when A and B have identical dimensions R x C:) Tj
T*
(   \(A + B\)[i][j] = A[i][j] + B[i][j]) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   class MatrixOperations:) Tj
T*
(   @staticmethod) Tj
T*
(   def transpose_nested_loops\(matrix\):) Tj
T*
(   rows = len\(matrix\)) Tj
T*
(   cols = len\(matrix[0]\)) Tj
T*
(   trans = []) Tj
T*
(   for j in range\(cols\):) Tj
T*
(   trans_row = []) Tj
T*
(   for i in range\(rows\):) Tj
T*
(   trans_row.append\(matrix[i][j]\)) Tj
T*
(   trans.append\(trans_row\)) Tj
T*
(   return trans) Tj
T*
() Tj
T*
(   @staticmethod) Tj
T*
(   def transpose_comprehension\(matrix\):) Tj
T*
(   # Idiomatic 2D list comprehension) Tj
T*
(   return [[matrix[i][j] for i in range\(len\(matrix\)\)] for j in range\(len\(matrix[0]\)\)]) Tj
T*
() Tj
T*
(   @staticmethod) Tj
T*
(   def add_matrices\(mat_a, mat_b\):) Tj
T*
(   rows = len\(mat_a\)) Tj
T*
(   cols = len\(mat_a[0]\)) Tj
T*
(   return [[mat_a[i][j] + mat_b[i][j] for j in range\(cols\)] for i in range\(rows\)]) Tj
T*
() Tj
T*
(   # Verification) Tj
T*
(   mat1 = [[1, 2, 3], [4, 5, 6]]) Tj
T*
(   mat2 = [[7, 8, 9], [1, 2, 3]]) Tj
T*
() Tj
T*
(   print\("Matrix 1:"\)) Tj
T*
(   for r in mat1: print\(" ", r\)) Tj
T*
() Tj
T*
ET

endstream
endobj
