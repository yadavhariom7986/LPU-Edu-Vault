(   At each discrete tick, the fate of each cell is determined by its 8 orthogonal and diagonal) Tj
T*
(   neighbors:) Tj
T*
(   1. Underpopulation: Any live cell with < 2 live neighbors dies.) Tj
T*
(   2. Survival: Any live cell with 2 or 3 live neighbors lives to the next generation.) Tj
T*
(   3. Overpopulation: Any live cell with > 3 live neighbors dies.) Tj
T*
(   4. Reproduction: Any dead cell with exactly 3 live neighbors becomes a live cell.) Tj
T*
() Tj
T*
(   2. Toroidal Boundary Conditions:) Tj
T*
(   Edges wrap around using modulus arithmetic: \(r + dr\) % rows and \(c + dc\) % cols.) Tj
T*
() Tj
T*
(   3. Python Implementation:) Tj
T*
(   class GameOfLife:) Tj
T*
(   def __init__\(self, grid\):) Tj
T*
(   self.grid = grid) Tj
T*
(   self.rows = len\(grid\)) Tj
T*
(   self.cols = len\(grid[0]\)) Tj
T*
() Tj
T*
(   def count_neighbors\(self, r: int, c: int\) -> int:) Tj
T*
(   count = 0) Tj
T*
(   for dr in \(-1, 0, 1\):) Tj
T*
(   for dc in \(-1, 0, 1\):) Tj
T*
(   if dr == 0 and dc == 0:) Tj
T*
(   continue) Tj
T*
(   # Toroidal modular wraparound) Tj
T*
(   nr = \(r + dr\) % self.rows) Tj
T*
(   nc = \(c + dc\) % self.cols) Tj
T*
(   count += self.grid[nr][nc]) Tj
T*
(   return count) Tj
T*
() Tj
T*
(   def step\(self\):) Tj
T*
(   next_grid = [[0 for _ in range\(self.cols\)] for _ in range\(self.rows\)]) Tj
T*
(   for r in range\(self.rows\):) Tj
T*
(   for c in range\(self.cols\):) Tj
T*
(   live_neighbors = self.count_neighbors\(r, c\)) Tj
T*
(   if self.grid[r][c] == 1:) Tj
T*
(   next_grid[r][c] = 1 if live_neighbors in \(2, 3\) else 0) Tj
T*
(   else:) Tj
T*
(   next_grid[r][c] = 1 if live_neighbors == 3 else 0) Tj
T*
(   self.grid = next_grid) Tj
T*
() Tj
T*
(   def display\(self, label=""\):) Tj
T*
(   print\(f"\\n--- {label} ---"\)) Tj
T*
(   for row in self.grid:) Tj
T*
(   print\(" ".join\("#" if cell else "." for cell in row\)\)) Tj
T*
() Tj
T*
(   # Demonstration: Blinker Oscillator \(Period 2\)) Tj
T*
(   blinker = [) Tj
T*
(   [0, 0, 0, 0, 0],) Tj
T*
(   [0, 0, 1, 0, 0],) Tj
T*
(   [0, 0, 1, 0, 0],) Tj
T*
(   [0, 0, 1, 0, 0],) Tj
T*
(   [0, 0, 0, 0, 0]) Tj
T*
(   ]) Tj
T*
() Tj
T*
ET

