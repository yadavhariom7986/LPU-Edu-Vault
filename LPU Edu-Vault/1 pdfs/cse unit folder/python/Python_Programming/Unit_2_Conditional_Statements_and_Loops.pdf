BT
/F1 8.5 Tf
12.5 TL
(   [Problem Statement]: Implement a Python program for the Collatz Conjecture \(3n + 1 Problem\) with hailstone sequence generation, stopping time analysis, and peak value tracking.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Theoretical Formulation of the Collatz Conjecture:) Tj
T*
(   For any positive integer n:) Tj
T*
(   - If n is even: n_next = n // 2) Tj
T*
(   - If n is odd: n_next = \(3 * n\) + 1) Tj
T*
(   The Collatz Conjecture states that starting from any positive integer n, the sequence \(often) Tj
T*
(   called the Hailstone Sequence\) will always eventually reach 1.) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   def collatz_hailstone_analyzer\(start_n: int\):) Tj
T*
(   """Generate Collatz sequence and compute trajectory metrics.""") Tj
T*
(   if start_n <= 0:) Tj
T*
(   raise ValueError\("Collatz conjecture is defined for positive integers n >= 1."\)) Tj
T*
() Tj
T*
(   sequence = [start_n]) Tj
T*
(   current = start_n) Tj
T*
() Tj
T*
(   while current != 1:) Tj
T*
(   if current % 2 == 0:) Tj
T*
(   current = current // 2) Tj
T*
(   else:) Tj
T*
(   current = \(3 * current\) + 1) Tj
T*
(   sequence.append\(current\)) Tj
T*
() Tj
T*
(   stopping_time = len\(sequence\) - 1) Tj
T*
(   peak_value = max\(sequence\)) Tj
T*
() Tj
T*
(   print\("=" * 60\)) Tj
T*
(   print\(f"Collatz Analysis for Initial Seed: n = {start_n}"\)) Tj
T*
(   print\(f"Total Stopping Time \(Steps to reach 1\): {stopping_time}"\)) Tj
T*
(   print\(f"Maximum Peak Value Reached: {peak_value}"\)) Tj
T*
(   print\(f"First 10 Steps: {sequence[:10]} ... [Length: {len\(sequence\)}]"\)) Tj
T*
(   print\("=" * 60\)) Tj
T*
() Tj
T*
(   return {"Start": start_n, "Steps": stopping_time, "Peak": peak_value, "Seq": sequence}) Tj
T*
() Tj
T*
(   # Analysis of standard numbers) Tj
T*
(   collatz_hailstone_analyzer\(27\) # Famous seed requiring 111 steps and peaking at 9232!) Tj
T*
ET

endstream
