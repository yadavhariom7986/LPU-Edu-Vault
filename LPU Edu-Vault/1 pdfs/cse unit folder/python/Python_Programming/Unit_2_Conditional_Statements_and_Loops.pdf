45 780 Td
(   else:) Tj
T*
(   return "Missing User") Tj
T*
() Tj
T*
(   # Clean Pattern: Flat Early-Return Guard Clauses) Tj
T*
(   def verify_user_flat\(user\):) Tj
T*
(   if user is None:) Tj
T*
(   return "Missing User") Tj
T*
(   if not user.get\("is_authenticated"\):) Tj
T*
(   return "Unauthenticated") Tj
T*
(   if user.get\("role"\) != "admin":) Tj
T*
(   return "Unauthorized Role") Tj
T*
(   return "Admin Access Granted") Tj
T*
() Tj
T*
(   # Test verification) Tj
T*
(   sample_admin = {"is_authenticated": True, "role": "admin"}) Tj
T*
(   print\("Flat Guard Result:", verify_user_flat\(sample_admin\)\)) Tj
T*
() Tj
T*
(   5. Complexity Analysis:) Tj
T*
(   - Time Complexity: O\(1\) worst-case 3 dictionary lookups.) Tj
T*
(   - Space Complexity: O\(1\) auxiliary frame memory.) Tj
T*
() Tj
T*
