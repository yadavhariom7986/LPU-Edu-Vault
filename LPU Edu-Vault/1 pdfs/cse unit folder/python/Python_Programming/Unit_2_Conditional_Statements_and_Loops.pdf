(   [Problem Statement]: Implement an Run-Length Encoding \(RLE\) lossless string data compression utility using iterative while/for loops.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Theoretical Principles of Run-Length Encoding:) Tj
T*
(   Run-Length Encoding \(RLE\) is a lossless data compression technique where contiguous runs of) Tj
T*
(   identical data characters are stored as a single character value and count \(e.g.,) Tj
T*
(   'AAAAABBBCCDAA' -> 'A5B3C2D1A2'\).) Tj
T*
(   Ideal for compressing monochrome bitmaps, repeated sensor readings, and genomic DNA sequences.) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   class RunLengthEncoder:) Tj
T*
(   @staticmethod) Tj
T*
(   def compress\(text: str\) -> str:) Tj
T*
(   if not text:) Tj
T*
(   return "") Tj
T*
() Tj
T*
(   compressed = []) Tj
T*
(   n = len\(text\)) Tj
T*
(   i = 0) Tj
T*
() Tj
T*
(   while i < n:) Tj
T*
(   current_char = text[i]) Tj
T*
(   count = 1) Tj
T*
(   # Count consecutive identical characters) Tj
T*
(   while i + 1 < n and text[i + 1] == current_char:) Tj
T*
(   count += 1) Tj
T*
(   i += 1) Tj
T*
(   compressed.append\(f"{current_char}{count}"\)) Tj
T*
(   i += 1) Tj
T*
() Tj
T*
(   return "".join\(compressed\)) Tj
T*
() Tj
T*
(   @staticmethod) Tj
T*
(   def decompress\(encoded: str\) -> str:) Tj
T*
(   import re) Tj
T*
(   # Match character followed by numeric count) Tj
T*
(   tokens = re.findall\(r'\([A-Za-z]\)\(\\d+\)', encoded\)) Tj
T*
(   return "".join\(char * int\(count\) for char, count in tokens\)) Tj
T*
() Tj
T*
(   # Demonstration) Tj
T*
(   sample_data = "WWWWWWWWWWWWBWWWWWWWWWWWWBBBWWWWWWWWWWWWWWWWWWWWWWWWB") Tj
T*
(   compressed_data = RunLengthEncoder.compress\(sample_data\)) Tj
T*
(   decompressed_data = RunLengthEncoder.decompress\(compressed_data\)) Tj
T*
() Tj
T*
(   print\(f"Original String: '{sample_data}' \(Length: {len\(sample_data\)}\)"\)) Tj
T*
(   print\(f"Compressed RLE: '{compressed_data}' \(Length: {len\(compressed_data\)}\)"\)) Tj
T*
ET

endstream
endobj
