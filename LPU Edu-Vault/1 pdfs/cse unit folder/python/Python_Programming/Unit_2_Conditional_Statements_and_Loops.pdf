(   # 3. Guarding against ZeroDivisionError inside an expression) Tj
T*
(   num = 100) Tj
T*
(   denom = 0) Tj
T*
(   safe_ratio = \(num / denom\) if denom != 0 else float\('inf'\)) Tj
T*
(   print\(f"Safe Ratio \(denom=0\): {safe_ratio}"\)) Tj
T*
() Tj
T*
(   4. Complexity Analysis:) Tj
T*
(   - Time Complexity: O\(1\) branch evaluation.) Tj
T*
(   - Space Complexity: O\(1\) storage for evaluated return value.) Tj
T*
