BT
/F1 8.5 Tf
12.5 TL
45 780 Td
(   - If w[i - 1] > w: DP[i][w] = DP[i - 1][w]) Tj
T*
(   - Else: DP[i][w] = max\(DP[i - 1][w], v[i - 1] + DP[i - 1][w - w[i - 1]]\)) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   def solve_01_knapsack\(values: list, weights: list, capacity: int\) -> tuple:) Tj
T*
(   n = len\(values\)) Tj
T*
(   # Initialize DP table \(N + 1\) x \(capacity + 1\) with zeros) Tj
T*
(   dp = [[0 for _ in range\(capacity + 1\)] for _ in range\(n + 1\)]) Tj
T*
() Tj
T*
(   # Bottom-up iterative table construction) Tj
T*
(   for i in range\(1, n + 1\):) Tj
T*
(   item_val = values[i - 1]) Tj
T*
(   item_wt = weights[i - 1]) Tj
T*
(   for w in range\(1, capacity + 1\):) Tj
T*
(   if item_wt <= w:) Tj
T*
(   dp[i][w] = max\(dp[i - 1][w], item_val + dp[i - 1][w - item_wt]\)) Tj
T*
(   else:) Tj
T*
(   dp[i][w] = dp[i - 1][w]) Tj
T*
() Tj
T*
(   max_val = dp[n][capacity]) Tj
T*
() Tj
T*
(   # Backtrack to find selected items) Tj
T*
(   selected_items = []) Tj
T*
(   curr_w = capacity) Tj
T*
(   for i in range\(n, 0, -1\):) Tj
T*
(   if dp[i][curr_w] != dp[i - 1][curr_w]:) Tj
T*
(   selected_items.append\(i - 1\) # 0-indexed item) Tj
T*
(   curr_w -= weights[i - 1]) Tj
T*
() Tj
T*
(   selected_items.reverse\(\)) Tj
T*
(   return max_val, selected_items) Tj
T*
() Tj
T*
(   # Verification) Tj
T*
(   vals = [60, 100, 120]) Tj
T*
(   wts = [10, 20, 30]) Tj
T*
(   cap = 50) Tj
T*
() Tj
T*
(   best_val, chosen = solve_01_knapsack\(vals, wts, cap\)) Tj
T*
(   print\(f"Knapsack Capacity: {cap} kg"\)) Tj
T*
(   print\(f"Maximum Profit Achieved: ${best_val}"\)) Tj
T*
(   print\(f"Selected Item Indices: {chosen} \(Weights: {[wts[i] for i in chosen]}\)"\)) Tj
T*
() Tj
T*
(   3. Complexity Analysis:) Tj
T*
(   - Time Complexity: O\(N * W\) where N is number of items and W is capacity.) Tj
T*
(   - Space Complexity: O\(N * W\) memory for the 2D DP matrix.) Tj
T*
() Tj
T*
(--------------------------------------------------------------------------------) Tj
T*
() Tj
T*
