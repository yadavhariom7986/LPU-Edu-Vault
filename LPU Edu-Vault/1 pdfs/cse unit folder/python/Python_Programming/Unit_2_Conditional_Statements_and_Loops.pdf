BT
/F1 8.5 Tf
12.5 TL
(   [Problem Statement]: Design an interactive Caesar Cipher encryption and decryption program in Python using loops, character ordinals \(ord\), and modulo 26 arithmetic.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Theoretical Formulation of Caesar Cipher:) Tj
T*
(   The Caesar Cipher is a classic monoalphabetic substitution cipher where each letter in the) Tj
T*
(   plaintext is shifted by a fixed key k positions down the alphabet:) Tj
T*
(   Encryption Formula:) Tj
T*
(   E\(x\) = \(x + k\) % 26) Tj
T*
(   Decryption Formula:) Tj
T*
(   D\(x\) = \(x - k\) % 26) Tj
T*
(   where x is the 0-indexed position of letter \(A=0, B=1, ... Z=25\).) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   class CaesarCipher:) Tj
T*
(   @staticmethod) Tj
T*
(   def encrypt\(text: str, key: int\) -> str:) Tj
T*
(   result = []) Tj
T*
(   for char in text:) Tj
T*
(   if char.isupper\(\):) Tj
T*
(   # Base ord\('A'\) = 65) Tj
T*
(   enc_char = chr\(\(ord\(char\) - 65 + key\) % 26 + 65\)) Tj
T*
(   result.append\(enc_char\)) Tj
T*
(   elif char.islower\(\):) Tj
T*
(   # Base ord\('a'\) = 97) Tj
T*
(   enc_char = chr\(\(ord\(char\) - 97 + key\) % 26 + 97\)) Tj
T*
(   result.append\(enc_char\)) Tj
T*
(   else:) Tj
T*
(   # Retain punctuation, digits, spaces unchanged) Tj
T*
(   result.append\(char\)) Tj
T*
(   return "".join\(result\)) Tj
T*
() Tj
T*
(   @staticmethod) Tj
T*
(   def decrypt\(ciphertext: str, key: int\) -> str:) Tj
T*
(   # Decryption is encryption with negative key) Tj
T*
(   return CaesarCipher.encrypt\(ciphertext, -key\)) Tj
T*
() Tj
T*
(   # Verification) Tj
T*
(   plaintext = "Cyber Security & Python 3.10!") Tj
T*
(   shift_key = 5) Tj
T*
() Tj
T*
(   cipher = CaesarCipher.encrypt\(plaintext, shift_key\)) Tj
T*
ET

endstream
