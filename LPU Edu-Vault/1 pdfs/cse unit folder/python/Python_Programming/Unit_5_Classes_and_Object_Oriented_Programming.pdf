T*
(   class PaidState\(OrderState\):) Tj
T*
(   def pay\(self, ctx: OrderContext\): print\("Order is already paid."\)) Tj
T*
(   def ship\(self, ctx: OrderContext\): ctx.set_state\(ShippedState\(\)\)) Tj
T*
