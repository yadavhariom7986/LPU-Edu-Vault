T*
() Tj
T*
(   class ShippedState\(OrderState\):) Tj
T*
(   def pay\(self, ctx: OrderContext\): print\("Already paid."\)) Tj
T*
(   def ship\(self, ctx: OrderContext\): print\("Already shipped."\)) Tj
T*
(   def deliver\(self, ctx: OrderContext\): ctx.set_state\(DeliveredState\(\)\)) Tj
T*
() Tj
T*
(   class DeliveredState\(OrderState\):) Tj
T*
(   def pay\(self, ctx\): print\("Order completed."\)) Tj
T*
(   def ship\(self, ctx\): print\("Order completed."\)) Tj
T*
(   def deliver\(self, ctx\): print\("Already delivered."\)) Tj
T*
() Tj
