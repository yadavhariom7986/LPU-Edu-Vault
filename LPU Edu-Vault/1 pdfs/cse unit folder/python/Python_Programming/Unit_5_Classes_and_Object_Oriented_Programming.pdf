T*
(   print\("Multilevel Inheritance Chain Info:"\)) Tj
T*
(   print\(ev.get_info\(\)\)) Tj
T*
() Tj
T*
(   print\(f"isinstance\(ev, Vehicle\): {isinstance\(ev, Vehicle\)}"\)) Tj
T*
(   print\(f"issubclass\(ElectricCar, Vehicle\): {issubclass\(ElectricCar, Vehicle\)}"\)) Tj
T*
(   print\(f"ElectricCar MRO: {[c.__name__ for c in ElectricCar.mro\(\)]}"\)) Tj
T*
() Tj
T*
