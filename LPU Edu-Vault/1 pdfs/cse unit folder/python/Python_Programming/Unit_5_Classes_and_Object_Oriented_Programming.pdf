(   [Problem Statement]: Implement a Thread-Safe In-Memory Key-Value Store with TTL \(Time-To-Live\) Eviction in Python using Classes and threading.Lock.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   1. Theoretical Basis:) Tj
T*
(   A key-value cache with expiration requires concurrency control \(threading.Lock\) to prevent race) Tj
T*
(   conditions during read, write, and eviction cycles.) Tj
T*
() Tj
T*
(   2. Python Implementation:) Tj
T*
(   import time) Tj
T*
(   import threading) Tj
T*
() Tj
T*
(   class TTLCacheStore:) Tj
T*
(   def __init__\(self\):) Tj
T*
(   self._store = {}) Tj
T*
(   self._lock = threading.Lock\(\)) Tj
T*
() Tj
T*
(   def set\(self, key: str, value, ttl_seconds: float\):) Tj
T*
(   expire_at = time.time\(\) + ttl_seconds) Tj
T*
(   with self._lock:) Tj
T*
(   self._store[key] = \(value, expire_at\)) Tj
T*
() Tj
T*
(   def get\(self, key: str\):) Tj
T*
(   with self._lock:) Tj
T*
(   if key not in self._store:) Tj
T*
(   return None) Tj
T*
(   val, expire_at = self._store[key]) Tj
T*
(   if time.time\(\) > expire_at:) Tj
T*
(   del self._store[key] # Expired) Tj
T*
(   return None) Tj
T*
(   return val) Tj
T*
() Tj
T*
(   # Demonstration) Tj
T*
(   cache = TTLCacheStore\(\)) Tj
T*
(   cache.set\("session_token", "USER_XYZ_AUTH", ttl_seconds=1.0\)) Tj
T*
() Tj
T*
ET

