T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   Function.prototype.bind creates a new function with bound context and prepended arguments:) Tj
T*
() Tj
T*
(   ```javascript) Tj
T*
(   Function.prototype.myBind = function\(context, ...boundArgs\) {) Tj
T*
(   const originalFn = this;) Tj
T*
(   if \(typeof originalFn !== 'function'\) {) Tj
T*
(   throw new TypeError\('myBind must be called on a function'\);) Tj
T*
(   }) Tj
T*
() Tj
T*
(   function boundFunction\(...callArgs\) {) Tj
T*
(   // If called with 'new', 'this' should be the newly created instance) Tj
T*
(   const isConstructor = this instanceof boundFunction;) Tj
T*
(   const targetThis = isConstructor ? this : context;) Tj
T*
(   return originalFn.apply\(targetThis, [...boundArgs, ...callArgs]\);) Tj
T*
(   }) Tj
T*
() Tj
T*
(   // Preserve prototype chain for constructor calls) Tj
T*
(   if \(originalFn.prototype\) {) Tj
T*
(   boundFunction.prototype = Object.create\(originalFn.prototype\);) Tj
T*
(   }) Tj
T*
(   return boundFunction;) Tj
T*
(   };) Tj
T*
(   ```) Tj
