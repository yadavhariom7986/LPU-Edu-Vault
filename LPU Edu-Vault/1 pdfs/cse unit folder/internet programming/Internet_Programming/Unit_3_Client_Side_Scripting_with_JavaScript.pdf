T*
(   function leakDemonstration\(\) {) Tj
T*
(   const massiveBuffer = new Array\(10000000\).fill\('data'\); // 80 MB) Tj
T*
(   return function\(\) {) Tj
T*
(   console.log\(massiveBuffer[0]\); // Keeps massiveBuffer alive permanently!) Tj
T*
(   };) Tj
T*
(   }) Tj
T*
(   const preservedFn = leakDemonstration\(\);) Tj
T*
(   ```) Tj
T*
