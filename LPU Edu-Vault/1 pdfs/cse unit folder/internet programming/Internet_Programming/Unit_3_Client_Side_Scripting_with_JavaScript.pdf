(   [Problem Statement]: Implement a custom Debounce and Throttle function in vanilla JavaScript, explaining when to deploy each in frontend applications.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   Debounce and Throttle regulate the frequency of high-rate event execution:) Tj
T*
() Tj
T*
(   1. Debounce \(Delays execution until user pauses typing for 'delay' ms\):) Tj
T*
(   ```javascript) Tj
T*
(   function debounce\(func, delay\) {) Tj
T*
(   let timerId;) Tj
T*
(   return function\(...args\) {) Tj
T*
(   clearTimeout\(timerId\);) Tj
T*
(   timerId = setTimeout\(\(\) => func.apply\(this, args\), delay\);) Tj
T*
(   };) Tj
T*
(   }) Tj
T*
(   // Usage: Autocomplete search input on keyup) Tj
T*
(   ```) Tj
T*
() Tj
T*
(   2. Throttle \(Ensures function executes at most once every 'limit' ms\):) Tj
T*
(   ```javascript) Tj
T*
(   function throttle\(func, limit\) {) Tj
T*
(   let inThrottle = false;) Tj
T*
(   return function\(...args\) {) Tj
T*
(   if \(!inThrottle\) {) Tj
T*
(   func.apply\(this, args\);) Tj
T*
(   inThrottle = true;) Tj
T*
(   setTimeout\(\(\) => inThrottle = false, limit\);) Tj
T*
(   }) Tj
T*
(   };) Tj
T*
(   }) Tj
T*
(   // Usage: Window scroll and resize listeners) Tj
T*
(   ```) Tj
T*
() Tj
T*
(--------------------------------------------------------------------------------) Tj
T*
() Tj
T*
