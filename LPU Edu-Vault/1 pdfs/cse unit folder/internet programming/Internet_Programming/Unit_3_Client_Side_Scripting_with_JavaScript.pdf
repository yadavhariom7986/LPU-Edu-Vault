(   [Problem Statement]: Demonstrate how to implement the Publish-Subscribe \(Pub/Sub\) design pattern in pure JavaScript.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   The Pub/Sub pattern decouples message emitters from event listeners:) Tj
T*
() Tj
T*
(   ```javascript) Tj
T*
(   class EventEmitter {) Tj
T*
(   constructor\(\) {) Tj
T*
(   this.events = {};) Tj
T*
(   }) Tj
T*
() Tj
T*
(   subscribe\(event, callback\) {) Tj
T*
(   if \(!this.events[event]\) this.events[event] = [];) Tj
T*
(   this.events[event].push\(callback\);) Tj
T*
(   return \(\) => this.unsubscribe\(event, callback\); // Unsubscribe helper) Tj
T*
(   }) Tj
T*
() Tj
T*
(   publish\(event, data\) {) Tj
T*
(   if \(!this.events[event]\) return;) Tj
T*
(   this.events[event].forEach\(cb => cb\(data\)\);) Tj
T*
(   }) Tj
T*
() Tj
T*
(   unsubscribe\(event, callback\) {) Tj
T*
(   if \(!this.events[event]\) return;) Tj
T*
(   this.events[event] = this.events[event].filter\(cb => cb !== callback\);) Tj
T*
(   }) Tj
T*
(   }) Tj
T*
(   ```) Tj
T*
() Tj
T*
(--------------------------------------------------------------------------------) Tj
T*
() Tj
T*
