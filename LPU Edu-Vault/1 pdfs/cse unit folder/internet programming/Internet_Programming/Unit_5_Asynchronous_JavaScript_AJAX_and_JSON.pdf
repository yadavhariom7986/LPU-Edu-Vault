(   [Problem Statement]: Implement an asynchronous Promise pool / concurrency throttle that limits parallel execution of tasks to at most N active promises.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   Throttling parallel asynchronous tasks prevents overwhelming backend APIs:) Tj
T*
() Tj
T*
(   ```javascript) Tj
T*
(   async function promisePool\(tasks, limit = 3\) {) Tj
T*
(   const results = [];) Tj
T*
(   const executing = [];) Tj
T*
() Tj
T*
(   for \(const task of tasks\) {) Tj
T*
(   const p = Promise.resolve\(\).then\(\(\) => task\(\)\);) Tj
T*
(   results.push\(p\);) Tj
T*
() Tj
T*
(   if \(limit <= tasks.length\) {) Tj
T*
(   const e = p.then\(\(\) => executing.splice\(executing.indexOf\(e\), 1\)\);) Tj
T*
(   executing.push\(e\);) Tj
T*
(   if \(executing.length >= limit\) {) Tj
T*
(   await Promise.race\(executing\); // Wait until one active task frees up) Tj
T*
(   }) Tj
T*
(   }) Tj
T*
(   }) Tj
T*
(   return Promise.all\(results\);) Tj
T*
(   }) Tj
T*
(   // Executes 50 tasks with at most 3 running concurrently) Tj
T*
(   ```) Tj
T*
() Tj
T*
