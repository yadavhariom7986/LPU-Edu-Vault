(   [Problem Statement]: Write a custom Promise polyfill implementation \(MyPromise\) in vanilla JavaScript supporting then, catch, and state transitions.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   Here is a spec-compliant mini Promise implementation:) Tj
T*
() Tj
T*
(   ```javascript) Tj
T*
(   class MyPromise {) Tj
T*
(   constructor\(executor\) {) Tj
T*
(   this.state = 'PENDING';) Tj
T*
(   this.value = undefined;) Tj
T*
(   this.handlers = [];) Tj
T*
() Tj
T*
(   const resolve = \(val\) => {) Tj
T*
(   if \(this.state !== 'PENDING'\) return;) Tj
T*
(   this.state = 'FULFILLED';) Tj
T*
(   this.value = val;) Tj
T*
(   this.handlers.forEach\(h => h.onFulfilled\(val\)\);) Tj
T*
(   };) Tj
T*
() Tj
T*
(   const reject = \(err\) => {) Tj
T*
(   if \(this.state !== 'PENDING'\) return;) Tj
T*
(   this.state = 'REJECTED';) Tj
T*
(   this.value = err;) Tj
T*
(   this.handlers.forEach\(h => h.onRejected\(err\)\);) Tj
T*
(   };) Tj
T*
() Tj
T*
(   try { executor\(resolve, reject\); } catch \(e\) { reject\(e\); }) Tj
T*
(   }) Tj
T*
() Tj
T*
(   then\(onFulfilled, onRejected\) {) Tj
T*
(   return new MyPromise\(\(res, rej\) => {) Tj
T*
(   const handle = \(\) => {) Tj
T*
(   if \(this.state === 'FULFILLED'\) {) Tj
T*
(   queueMicrotask\(\(\) => res\(onFulfilled ? onFulfilled\(this.value\) : this.value\)\);) Tj
T*
(   } else if \(this.state === 'REJECTED'\) {) Tj
T*
(   queueMicrotask\(\(\) => rej\(onRejected ? onRejected\(this.value\) : this.value\)\);) Tj
T*
(   } else {) Tj
T*
(   this.handlers.push\({) Tj
T*
(   onFulfilled: \(v\) => queueMicrotask\(\(\) => res\(onFulfilled ? onFulfilled\(v\) : v\)\),) Tj
T*
(   onRejected: \(r\) => queueMicrotask\(\(\) => rej\(onRejected ? onRejected\(r\) : r\)\)) Tj
T*
(   }\);) Tj
T*
ET

endstream
