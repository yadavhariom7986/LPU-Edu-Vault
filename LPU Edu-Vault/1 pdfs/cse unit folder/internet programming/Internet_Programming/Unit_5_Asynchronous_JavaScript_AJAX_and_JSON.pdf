T*
(   return await res.json\(\);) Tj
T*
(   } catch \(err\) {) Tj
T*
(   if \(attempt === retries\) throw err;) Tj
T*
(   // Exponential backoff: 2^attempt + random jitter \(0-200ms\)) Tj
T*
(   const jitter = Math.random\(\) * 200;) Tj
T*
(   const delay = \(baseDelay * \(2 ** attempt\)\) + jitter;) Tj
T*
(   console.warn\(`Attempt ${attempt + 1} failed. Retrying in ${Math.round\(delay\)}ms...`\);) Tj
T*
(   await new Promise\(r => setTimeout\(r, delay\)\);) Tj
T*
(   }) Tj
