(   [Problem Statement]: Implement an Infinite Scroll feature using IntersectionObserver, fetching and appending new items dynamically when reaching bottom.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   Infinite scrolling seamlessly fetches subsequent pages as the user approaches the footer:) Tj
T*
() Tj
T*
(   ```javascript) Tj
T*
(   let page = 1;) Tj
T*
(   const feed = document.getElementById\('feed'\);) Tj
T*
(   const sentinel = document.getElementById\('sentinel'\); // Empty element at bottom) Tj
T*
() Tj
T*
(   const observer = new IntersectionObserver\(async \(entries\) => {) Tj
T*
(   const [entry] = entries;) Tj
T*
(   if \(entry.isIntersecting\) {) Tj
T*
(   await loadMorePosts\(\);) Tj
T*
(   }) Tj
T*
(   }, { rootMargin: '300px' }\); // Trigger 300px before reaching sentinel) Tj
T*
() Tj
T*
(   async function loadMorePosts\(\) {) Tj
T*
(   const res = await fetch\(`/api/posts?page=${page}`\);) Tj
T*
(   const posts = await res.json\(\);) Tj
T*
(   if \(posts.length === 0\) {) Tj
T*
(   observer.unobserve\(sentinel\); // No more posts) Tj
T*
(   return;) Tj
T*
(   }) Tj
T*
(   const fragment = document.createDocumentFragment\(\);) Tj
T*
(   posts.forEach\(post => {) Tj
T*
(   const div = document.createElement\('div'\);) Tj
T*
(   div.className = 'post-card';) Tj
T*
(   div.textContent = post.title;) Tj
T*
(   fragment.appendChild\(div\);) Tj
T*
(   }\);) Tj
T*
(   feed.appendChild\(fragment\);) Tj
T*
(   page++;) Tj
T*
(   }) Tj
T*
ET

