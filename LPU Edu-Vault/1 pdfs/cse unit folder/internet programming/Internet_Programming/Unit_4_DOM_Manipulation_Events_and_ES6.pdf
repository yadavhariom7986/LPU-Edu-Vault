(   MutationObserver provides an asynchronous mechanism to watch for mutations in the DOM tree,) Tj
T*
(   replacing legacy deprecated Mutation Events \(like DOMNodeInserted\):) Tj
T*
() Tj
T*
(   Implementation Example:) Tj
T*
(   ```javascript) Tj
T*
(   const targetNode = document.getElementById\('chatContainer'\);) Tj
T*
() Tj
T*
(   const observerOptions = {) Tj
T*
(   childList: true, // Monitor addition/removal of child nodes) Tj
T*
(   subtree: true, // Extend monitoring to all descendant subtrees) Tj
T*
(   attributes: true, // Monitor attribute mutations) Tj
T*
(   attributeFilter: ['class', 'data-status'] // Whitelist specific attributes) Tj
T*
(   };) Tj
T*
() Tj
T*
(   const observer = new MutationObserver\(\(mutationsList, obs\) => {) Tj
T*
(   for \(const mutation of mutationsList\) {) Tj
T*
(   if \(mutation.type === 'childList'\) {) Tj
T*
(   mutation.addedNodes.forEach\(node => {) Tj
T*
(   if \(node.nodeType === Node.ELEMENT_NODE\) {) Tj
T*
(   console.log\('New message element appended:', node\);) Tj
T*
(   }) Tj
T*
(   }\);) Tj
T*
(   }) Tj
T*
(   }) Tj
T*
(   }\);) Tj
T*
() Tj
T*
(   observer.observe\(targetNode, observerOptions\);) Tj
T*
(   // To disconnect: observer.disconnect\(\);) Tj
T*
(   ```) Tj
T*
() Tj
T*
(--------------------------------------------------------------------------------) Tj
T*
