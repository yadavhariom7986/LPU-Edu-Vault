(   [Problem Statement]: Write a lightweight state-management store in vanilla JavaScript inspired by Redux \(Store, Reducer, Dispatch, Subscribe\).) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   Here is a complete Redux-like state store in 25 lines of pure modern JavaScript:) Tj
T*
() Tj
T*
(   ```javascript) Tj
T*
(   function createStore\(reducer, initialState\) {) Tj
T*
(   let state = initialState;) Tj
T*
(   let listeners = [];) Tj
T*
() Tj
T*
(   return {) Tj
T*
(   getState: \(\) => state,) Tj
T*
(   dispatch: \(action\) => {) Tj
T*
(   state = reducer\(state, action\);) Tj
T*
(   listeners.forEach\(fn => fn\(\)\);) Tj
T*
(   },) Tj
T*
(   subscribe: \(listener\) => {) Tj
T*
(   listeners.push\(listener\);) Tj
T*
(   return \(\) => listeners = listeners.filter\(l => l !== listener\);) Tj
T*
(   }) Tj
T*
(   };) Tj
T*
(   }) Tj
T*
() Tj
T*
(   // Usage:) Tj
T*
(   const counterReducer = \(state = 0, action\) => {) Tj
T*
(   if \(action.type === 'INC'\) return state + 1;) Tj
T*
(   if \(action.type === 'DEC'\) return state - 1;) Tj
T*
(   return state;) Tj
T*
(   };) Tj
T*
(   const store = createStore\(counterReducer, 0\);) Tj
T*
(   store.subscribe\(\(\) => console.log\('Current state:', store.getState\(\)\)\);) Tj
T*
(   store.dispatch\({ type: 'INC' }\); // Current state: 1) Tj
T*
(   ```) Tj
T*
() Tj
T*
(--------------------------------------------------------------------------------) Tj
T*
() Tj
T*
