(   [Detailed Step-by-Step Answer]:) Tj
T*
(   CSP Reporting allows web applications to detect XSS exploit attempts and broken assets in real) Tj
T*
(   time:) Tj
T*
() Tj
T*
(   Header Declaration:) Tj
T*
(   `Content-Security-Policy: default-src 'self'; report-uri /api/csp-violations;`) Tj
T*
() Tj
T*
(   PHP Violation Ingestion Endpoint \(`/api/csp-violations`\):) Tj
T*
(   ```php) Tj
T*
(   // Browser dispatches JSON payload with Content-Type: application/csp-report) Tj
T*
(   $payload = file_get_contents\('php://input'\);) Tj
T*
(   $report = json_decode\($payload, true\);) Tj
T*
() Tj
T*
(   if \($report && isset\($report['csp-report']\)\) {) Tj
T*
(   $details = $report['csp-report'];) Tj
T*
(   $logEntry = sprintf\() Tj
T*
(   "[%s] CSP Violation on %s: Blocked '%s' violating directive '%s'\\n",) Tj
T*
(   date\('Y-m-d H:i:s'\),) Tj
T*
(   $details['document-uri'],) Tj
T*
(   $details['blocked-uri'],) Tj
T*
(   $details['violated-directive']) Tj
T*
(   \);) Tj
T*
(   file_put_contents\('/var/log/csp_violations.log', $logEntry, FILE_APPEND | LOCK_EX\);) Tj
T*
(   }) Tj
T*
(   http_response_code\(204\); // No content ack) Tj
T*
(   ```) Tj
