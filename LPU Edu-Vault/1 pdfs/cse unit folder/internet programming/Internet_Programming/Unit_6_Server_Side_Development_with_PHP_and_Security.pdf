(   $pdo->prepare\('UPDATE accounts SET balance = balance - 100 WHERE id = 1'\)->execute\(\);) Tj
T*
(   $pdo->prepare\('UPDATE accounts SET balance = balance + 100 WHERE id = 2'\)->execute\(\);) Tj
T*
(   $pdo->commit\(\); // Commits both operations atomically) Tj
T*
(   } catch \(Exception $e\) {) Tj
T*
