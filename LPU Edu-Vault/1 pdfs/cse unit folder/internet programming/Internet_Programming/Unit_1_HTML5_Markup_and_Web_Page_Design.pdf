(   Web Workers offload heavy computations to background threads. Below is a complete prime-number) Tj
T*
(   calculation example:) Tj
T*
() Tj
T*
(   Main Script \(main.js\):) Tj
T*
(   ```javascript) Tj
T*
(   const worker = new Worker\('primeWorker.js'\);) Tj
T*
(   worker.postMessage\({ maxLimit: 1000000 }\);) Tj
T*
() Tj
T*
(   worker.onmessage = function\(event\) {) Tj
T*
(   document.getElementById\('result'\).innerText = `Total Primes: ${event.data}`;) Tj
T*
(   };) Tj
T*
(   ```) Tj
T*
() Tj
T*
(   Worker Script \(primeWorker.js\):) Tj
T*
(   ```javascript) Tj
T*
(   onmessage = function\(e\) {) Tj
T*
(   const max = e.data.maxLimit;) Tj
T*
(   let count = 0;) Tj
T*
(   for \(let i = 2; i <= max; i++\) {) Tj
T*
(   let isPrime = true;) Tj
T*
(   for \(let j = 2; j * j <= i; j++\) {) Tj
T*
(   if \(i % j === 0\) { isPrime = false; break; }) Tj
T*
(   }) Tj
T*
(   if \(isPrime\) count++;) Tj
T*
(   }) Tj
T*
(   postMessage\(count\);) Tj
T*
(   };) Tj
T*
(   ```) Tj
T*
() Tj
T*
(--------------------------------------------------------------------------------) Tj
T*
() Tj
T*
