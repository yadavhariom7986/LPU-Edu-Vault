(   From A^3 = 3*A^2 + A - 9*I:) Tj
T*
(   Multiply by A: A^4 = 3*A^3 + A^2 - 9*A) Tj
T*
(   Substitute A^3: A^4 = 3\(3*A^2 + A - 9*I\) + A^2 - 9*A = 10*A^2 - 6*A - 27*I) Tj
T*
(   10*A^2 = [ 40 -30 60; 30 20 40; 0 -20 50 ]) Tj
T*
(   -6*A = [ -6 0 -18; -12 -6 6; -6 6 -6 ]) Tj
T*
(   -27*I = [ -27 0 0; 0 -27 0; 0 0 -27 ]) Tj
T*
(   A^4 = [ 40-6-27, -30+0+0, 60-18+0; 30-12+0, 20-6-27, 40+6+0; 0-6+0, -20+6+0, 50-6-27 ]) Tj
T*
(   = [ 7 -30 42 ]) Tj
T*
(   [ 18 -13 46 ]) Tj
