T*
(   [ 0 0 3 -8 ]) Tj
T*
(   Step 3: In row 2, the pivot is a23 = 3. Eliminate entries in column 3 below row 2:) Tj
T*
(   Operation R3 -> R3 - 2*R2:) Tj
T*
(   [0, 0, 6 - 2\(3\), -16 - 2\(-8\)] = [0, 0, 0, 0]) Tj
T*
(   Operation R4 -> R4 - 1*R2:) Tj
T*
(   [0, 0, 3 - 1\(3\), -8 - 1\(-8\)] = [0, 0, 0, 0]) Tj
