T*
(   3. Proper Deallocation Sequence:) Tj
T*
(   Crucial Rule: MUST FREE IN STRICT REVERSE ORDER OF ALLOCATION!) Tj
T*
(   Step 1: Loop through each row and free row buffer: free\(mat[i]\);) Tj
T*
(   Step 2: Free the top-level pointer array: free\(mat\);) Tj
T*
(   If free\(mat\) is executed first, pointers to row buffers are lost, permanently leaking heap) Tj
T*
(   memory!) Tj
T*
() Tj
T*
(   4. Complete ANSI C Source Code:) Tj
T*
(   #include <stdio.h>) Tj
T*
(   #include <stdlib.h>) Tj
T*
() Tj
T*
(   int **create_matrix\(int rows, int cols\) {) Tj
T*
(   int **mat = \(int **\)malloc\(rows * sizeof\(int *\)\);) Tj
T*
(   if \(!mat\) return NULL;) Tj
T*
() Tj
T*
(   for \(int i = 0; i < rows; i++\) {) Tj
T*
(   mat[i] = \(int *\)malloc\(cols * sizeof\(int\)\);) Tj
T*
(   if \(!mat[i]\) {) Tj
T*
(   /* Rollback previously allocated rows on failure */) Tj
T*
(   for \(int k = 0; k < i; k++\) free\(mat[k]\);) Tj
T*
(   free\(mat\);) Tj
T*
(   return NULL;) Tj
T*
(   }) Tj
T*
(   }) Tj
T*
(   return mat;) Tj
T*
(   }) Tj
T*
() Tj
T*
(   void destroy_matrix\(int **mat, int rows\) {) Tj
T*
(   if \(!mat\) return;) Tj
T*
(   for \(int i = 0; i < rows; i++\) {) Tj
T*
(   free\(mat[i]\); /* Free individual column arrays */) Tj
T*
(   }) Tj
T*
(   free\(mat\); /* Free row pointer array */) Tj
T*
(   }) Tj
T*
() Tj
T*
(   int main\(void\) {) Tj
T*
(   int r = 3, c = 4;) Tj
T*
(   int **grid = create_matrix\(r, c\);) Tj
T*
(   if \(!grid\) return 1;) Tj
T*
() Tj
T*
(   /* Populate matrix */) Tj
T*
(   for \(int i = 0; i < r; i++\) {) Tj
T*
(   for \(int j = 0; j < c; j++\) grid[i][j] = \(i + 1\) * 10 + j;) Tj
T*
(   }) Tj
T*
() Tj
T*
(   printf\("Dynamic 2D Matrix Content:\\n"\);) Tj
T*
(   for \(int i = 0; i < r; i++\) {) Tj
T*
(   for \(int j = 0; j < c; j++\) printf\("%4d ", grid[i][j]\);) Tj
T*
(   printf\("\\n"\);) Tj
T*
(   }) Tj
T*
() Tj
T*
(   destroy_matrix\(grid, r\);) Tj
T*
(   grid = NULL;) Tj
