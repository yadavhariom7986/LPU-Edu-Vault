() Tj
T*
(   int main\(void\) {) Tj
T*
(   int a = 10, b = 20;) Tj
T*
() Tj
T*
(   /* 1. Pointer to constant data */) Tj
T*
(   const int *p1 = &a;) Tj
T*
(   p1 = &b; /* LEGAL: Pointer can re-bind */) Tj
T*
(   /* *p1 = 99; */ /* ILLEGAL: Data is read-only */) Tj
T*
() Tj
T*
(   /* 2. Constant pointer */) Tj
T*
(   int * const p2 = &a;) Tj
T*
(   *p2 = 99; /* LEGAL: Data is mutable */) Tj
T*
(   /* p2 = &b; */ /* ILLEGAL: Pointer cannot re-bind */) Tj
T*
() Tj
T*
(   /* 3. Constant pointer to constant data */) Tj
T*
(   const int * const p3 = &a;) Tj
T*
