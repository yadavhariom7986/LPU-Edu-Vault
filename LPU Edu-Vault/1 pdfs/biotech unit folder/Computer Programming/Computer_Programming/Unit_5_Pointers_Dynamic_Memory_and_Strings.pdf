T*
(   temp++;) Tj
T*
(   if \(*temp == ' ' || *temp == '\\0'\) {) Tj
T*
(   reverse_sub_string\(word_start, temp - 1\);) Tj
T*
(   word_start = temp + 1;) Tj
T*
(   }) Tj
T*
(   }) Tj
T*
() Tj
T*
(   /* Step 2: Reverse entire sentence */) Tj
T*
(   reverse_sub_string\(sentence, sentence + strlen\(sentence\) - 1\);) Tj
T*
(   }) Tj
T*
() Tj
