(   [Problem Statement]: Write an ANSI C program to check whether a given string is a Palindrome ignoring case and whitespace.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   Case-Insensitive Alphanumeric Palindrome Checker:) Tj
T*
(   1. Problem:) Tj
T*
(   Determine if a string reads identically forwards and backwards, ignoring non-alphanumeric) Tj
T*
(   characters and case differences \(e.g. "Madam, I'm Adam"\).) Tj
T*
() Tj
T*
(   2. Two-Pointer In-Place Strategy:) Tj
T*
(   Left pointer starts at 0; right pointer starts at strlen - 1.) Tj
T*
(   - Advance left while !isalnum\(*left\).) Tj
T*
(   - Decrement right while !isalnum\(*right\).) Tj
T*
(   - Compare tolower\(*left\) != tolower\(*right\): return false if mismatch.) Tj
T*
(   - Advance both pointers until left >= right.) Tj
T*
() Tj
T*
(   3. Complete ANSI C Source Code:) Tj
T*
(   #include <stdio.h>) Tj
T*
(   #include <ctype.h>) Tj
T*
(   #include <stdbool.h>) Tj
T*
(   #include <string.h>) Tj
T*
() Tj
T*
(   bool is_palindrome_clean\(const char *str\) {) Tj
T*
(   int left = 0;) Tj
T*
(   int right = strlen\(str\) - 1;) Tj
T*
() Tj
T*
(   while \(left < right\) {) Tj
T*
(   while \(left < right && !isalnum\(\(unsigned char\)str[left]\)\) left++;) Tj
T*
(   while \(left < right && !isalnum\(\(unsigned char\)str[right]\)\) right--;) Tj
T*
() Tj
T*
(   if \(tolower\(\(unsigned char\)str[left]\) != tolower\(\(unsigned char\)str[right]\)\) {) Tj
T*
(   return false;) Tj
T*
(   }) Tj
T*
(   left++;) Tj
T*
(   right--;) Tj
T*
(   }) Tj
T*
