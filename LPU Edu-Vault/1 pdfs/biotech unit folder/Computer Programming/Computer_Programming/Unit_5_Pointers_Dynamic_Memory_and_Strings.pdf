(   [Problem Statement]: Write an ANSI C program to search a DNA genomic string for Restriction Endonuclease recognition motifs using strstr\(\).) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   Restriction Endonuclease Recognition Site Scanner:) Tj
T*
(   1. Biological Application:) Tj
T*
(   Restriction enzymes are molecular scissors that cleave DNA at specific palindromic sequences.) Tj
T*
(   - EcoRI: Cleaves at 5'-GAATTC-3') Tj
T*
(   - BamHI: Cleaves at 5'-GGATCC-3') Tj
T*
(   - HindIII: Cleaves at 5'-AAGCTT-3') Tj
T*
(   Scanning an entire genomic sequence for these motifs identifies recombinant cloning junction) Tj
T*
(   sites.) Tj
T*
() Tj
T*
(   2. Complete ANSI C Source Code:) Tj
T*
(   #include <stdio.h>) Tj
T*
(   #include <string.h>) Tj
T*
() Tj
T*
(   void find_restriction_sites\(const char *dna, const char *motif, const char *enzyme_name\) {) Tj
T*
(   const char *current_pos = dna;) Tj
T*
(   int count = 0;) Tj
T*
(   int motif_len = strlen\(motif\);) Tj
T*
() Tj
T*
(   printf\("Searching for %s Recognition Site [%s]...\\n", enzyme_name, motif\);) Tj
T*
() Tj
T*
(   while \(\(current_pos = strstr\(current_pos, motif\)\) != NULL\) {) Tj
T*
(   count++;) Tj
T*
(   int nucleotide_index = \(int\)\(current_pos - dna\) + 1;) Tj
T*
(   printf\(" -> Cleavage Site %d: Found at nucleotide coordinate %d\\n", count, nucleotide_index\);) Tj
T*
() Tj
T*
(   /* Advance past the start of the current match to search downstream */) Tj
T*
(   current_pos += motif_len;) Tj
T*
(   }) Tj
T*
() Tj
T*
(   if \(count == 0\) {) Tj
T*
(   printf\(" -> No recognition motifs identified for %s.\\n", enzyme_name\);) Tj
T*
(   }) Tj
T*
(   }) Tj
T*
() Tj
T*
(   int main\(void\) {) Tj
T*
(   const char *cloning_vector =) Tj
T*
(   "AGCTTTTCATTCTGAATTCGATCGATCGGATCCGTCGATCGAATTCGCGCGAAGCTTTT";) Tj
T*
() Tj
T*
(   printf\("=== Molecular Cloning Restriction Site Mapping ===\\n"\);) Tj
T*
(   printf\("Plasmid Vector Sequence Length: %zu bp\\n\\n", strlen\(cloning_vector\)\);) Tj
T*
() Tj
T*
(   find_restriction_sites\(cloning_vector, "GAATTC", "EcoRI"\);) Tj
T*
(   find_restriction_sites\(cloning_vector, "GGATCC", "BamHI"\);) Tj
T*
(   find_restriction_sites\(cloning_vector, "AAGCTT", "HindIII"\);) Tj
T*
() Tj
T*
(   return 0;) Tj
T*
(   }) Tj
T*
() Tj
T*
