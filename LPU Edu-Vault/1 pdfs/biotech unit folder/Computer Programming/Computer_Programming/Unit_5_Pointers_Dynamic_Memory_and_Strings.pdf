T*
(   #include <stdio.h>) Tj
T*
(   #include <string.h>) Tj
T*
() Tj
T*
(   void reverse_sub_string\(char *start, char *end\) {) Tj
T*
(   while \(start < end\) {) Tj
T*
(   char temp = *start;) Tj
T*
(   *start = *end;) Tj
T*
(   *end = temp;) Tj
T*
(   start++;) Tj
T*
(   end--;) Tj
T*
(   }) Tj
T*
(   }) Tj
T*
() Tj
