T*
() Tj
T*
(   printf\("Original Header: %s\\n", fasta_header\);) Tj
T*
(   printf\("Parsing Pipe-Delimited Identifiers:\\n"\);) Tj
T*
() Tj
T*
(   char *token = strtok\(fasta_header, "| "\);) Tj
T*
(   int field = 1;) Tj
T*
(   while \(token != NULL\) {) Tj
T*
(   printf\("Field %d: \\"%s\\"\\n", field++, token\);) Tj
T*
(   token = strtok\(NULL, "| "\);) Tj
T*
(   }) Tj
T*
() Tj
T*
(   return 0;) Tj
T*
(   }) Tj
