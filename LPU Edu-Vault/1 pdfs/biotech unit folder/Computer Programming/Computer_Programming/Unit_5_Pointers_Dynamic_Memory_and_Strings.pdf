(   [Problem Statement]: Write an ANSI C program to strip leading and trailing whitespace from a string in-place using pointer manipulation.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   In-Place Whitespace Trimming in C:) Tj
T*
(   1. Algorithmic Principle:) Tj
T*
(   - Trailing Trim: Start from string end \(strlen - 1\), decrement pointer while isspace\(*p\), and) Tj
T*
(   place '\\0' immediately after last non-space character.) Tj
T*
(   - Leading Trim: Find first non-space character. Use memmove\(\) to shift remaining substring to) Tj
T*
(   the start of the buffer.) Tj
T*
() Tj
T*
(   2. Complete ANSI C Source Code:) Tj
T*
(   #include <stdio.h>) Tj
T*
(   #include <ctype.h>) Tj
T*
(   #include <string.h>) Tj
T*
() Tj
T*
(   void trim_whitespace\(char *str\) {) Tj
T*
(   if \(!str || *str == '\\0'\) return;) Tj
T*
() Tj
T*
(   /* 1. Trim trailing whitespace */) Tj
T*
(   char *end = str + strlen\(str\) - 1;) Tj
T*
(   while \(end >= str && isspace\(\(unsigned char\)*end\)\) {) Tj
T*
(   *end = '\\0';) Tj
T*
(   end--;) Tj
T*
(   }) Tj
T*
() Tj
T*
(   /* 2. Trim leading whitespace */) Tj
T*
(   char *start = str;) Tj
T*
(   while \(*start && isspace\(\(unsigned char\)*start\)\) {) Tj
T*
(   start++;) Tj
T*
(   }) Tj
T*
() Tj
T*
(   /* Shift string left if leading spaces existed */) Tj
T*
(   if \(start != str\) {) Tj
T*
(   memmove\(str, start, strlen\(start\) + 1\);) Tj
T*
(   }) Tj
T*
(   }) Tj
T*
() Tj
T*
(   int main\(void\) {) Tj
T*
(   char sample[] = " \\t\\n Target_Sequence_BRCA1 \\r\\n ";) Tj
T*
(   printf\("Before: \\"%s\\"\\n", sample\);) Tj
T*
(   trim_whitespace\(sample\);) Tj
T*
(   printf\("After: \\"%s\\"\\n", sample\);) Tj
T*
(   return 0;) Tj
T*
(   }) Tj
T*
() Tj
T*
