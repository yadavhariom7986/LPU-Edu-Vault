(   - Celsius to Kelvin: K = C + 273.15) Tj
T*
(   Absolute Zero Physical Constraint: Temperature cannot drop below 0 Kelvin \(-273.15 deg C or) Tj
T*
(   -459.67 deg F\).) Tj
T*
() Tj
T*
(   2. Complete ANSI C Source Code:) Tj
T*
(   #include <stdio.h>) Tj
T*
(   #include <stdlib.h>) Tj
T*
() Tj
T*
(   #define ABSOLUTE_ZERO_C -273.15) Tj
T*
() Tj
T*
(   int main\(void\) {) Tj
T*
(   double celsius, fahrenheit, kelvin;) Tj
T*
(   int choice;) Tj
T*
() Tj
T*
(   printf\("=== Precision Laboratory Temperature Converter ===\\n"\);) Tj
T*
(   printf\("1. Input Temperature in Celsius\\n"\);) Tj
T*
(   printf\("2. Input Temperature in Fahrenheit\\n"\);) Tj
T*
(   printf\("Select Scale [1 or 2]: "\);) Tj
T*
() Tj
T*
(   if \(scanf\("%d", &choice\) != 1 || \(choice != 1 && choice != 2\)\) {) Tj
T*
(   printf\("Error: Invalid selection.\\n"\);) Tj
T*
(   return EXIT_FAILURE;) Tj
T*
(   }) Tj
T*
() Tj
T*
(   if \(choice == 1\) {) Tj
T*
(   printf\("Enter Celsius temperature: "\);) Tj
T*
(   if \(scanf\("%lf", &celsius\) != 1\) {) Tj
T*
(   printf\("Error: Invalid numeric input.\\n"\);) Tj
T*
(   return EXIT_FAILURE;) Tj
T*
(   }) Tj
T*
(   if \(celsius < ABSOLUTE_ZERO_C\) {) Tj
T*
(   printf\("Error: Temperature below absolute zero \(-273.15 deg C\)!\\n"\);) Tj
T*
(   return EXIT_FAILURE;) Tj
T*
(   }) Tj
T*
(   fahrenheit = \(celsius * \(9.0 / 5.0\)\) + 32.0;) Tj
T*
(   kelvin = celsius + 273.15;) Tj
T*
(   } else {) Tj
T*
(   printf\("Enter Fahrenheit temperature: "\);) Tj
T*
(   if \(scanf\("%lf", &fahrenheit\) != 1\) {) Tj
T*
(   printf\("Error: Invalid numeric input.\\n"\);) Tj
T*
(   return EXIT_FAILURE;) Tj
T*
(   }) Tj
T*
(   celsius = \(fahrenheit - 32.0\) * \(5.0 / 9.0\);) Tj
T*
(   if \(celsius < ABSOLUTE_ZERO_C\) {) Tj
T*
(   printf\("Error: Temperature below absolute zero!\\n"\);) Tj
T*
(   return EXIT_FAILURE;) Tj
T*
(   }) Tj
T*
(   kelvin = celsius + 273.15;) Tj
T*
(   }) Tj
T*
() Tj
T*
(   printf\("--------------------------------------------------\\n"\);) Tj
T*
(   printf\("Celsius: %10.2f deg C\\n", celsius\);) Tj
T*
(   printf\("Fahrenheit: %10.2f deg F\\n", fahrenheit\);) Tj
T*
(   printf\("Kelvin: %10.2f K\\n", kelvin\);) Tj
T*
