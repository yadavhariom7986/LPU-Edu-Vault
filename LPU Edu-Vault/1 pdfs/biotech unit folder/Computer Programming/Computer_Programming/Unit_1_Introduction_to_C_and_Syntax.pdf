T*
(   double broken_gc = \(gc_bases / total_bases\) * 100.0;) Tj
T*
() Tj
T*
(   /* With cast: accurate floating-point percentage */) Tj
T*
(   double correct_gc = \(\(double\)gc_bases / total_bases\) * 100.0;) Tj
T*
() Tj
