(   [Problem Statement]: Write an ANSI C program to calculate the exact percentage of GC-content in a given DNA oligonucleotide sequence.) Tj
T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   DNA GC-Content Calculation Program:) Tj
T*
(   1. Biological Relevance:) Tj
T*
(   GC-content represents the percentage of nitrogenous bases in a DNA or RNA molecule that are) Tj
T*
(   either Guanine \(G\) or Cytosine \(C\).) Tj
T*
(   GC pairs bond via three hydrogen bonds \(compared to two in AT pairs\), directly determining DNA) Tj
T*
(   melting temperature \(Tm\) and structural stability.) Tj
T*
() Tj
T*
(   2. Complete ANSI C Source Code:) Tj
T*
(   #include <stdio.h>) Tj
T*
(   #include <ctype.h>) Tj
T*
() Tj
T*
(   double calculate_gc_content\(const char *dna, int *gc_count, int *total_count\) {) Tj
T*
(   int g_count = 0, c_count = 0, other_count = 0;) Tj
T*
(   int i = 0;) Tj
T*
() Tj
T*
(   while \(dna[i] != '\\0'\) {) Tj
T*
(   char base = toupper\(\(unsigned char\)dna[i]\);) Tj
T*
(   if \(base == 'G'\) {) Tj
T*
(   g_count++;) Tj
T*
(   } else if \(base == 'C'\) {) Tj
T*
(   c_count++;) Tj
T*
(   } else if \(base == 'A' || base == 'T'\) {) Tj
T*
(   other_count++;) Tj
T*
(   }) Tj
T*
(   i++;) Tj
T*
(   }) Tj
T*
() Tj
T*
(   *gc_count = g_count + c_count;) Tj
T*
(   *total_count = *gc_count + other_count;) Tj
T*
() Tj
T*
(   if \(*total_count == 0\) return 0.0;) Tj
T*
(   /* Explicit cast to avoid integer division truncation */) Tj
T*
(   return \(\(double\)\(*gc_count\) / \(*total_count\)\) * 100.0;) Tj
T*
(   }) Tj
T*
() Tj
T*
(   int main\(void\) {) Tj
T*
(   const char *primer_seq = "ATGCGATCGATCGATCGCGCATATCGATC";) Tj
T*
ET

