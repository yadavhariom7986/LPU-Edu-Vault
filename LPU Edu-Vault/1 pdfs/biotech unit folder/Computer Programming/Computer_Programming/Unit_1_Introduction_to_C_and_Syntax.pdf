(   Beneficial Uses of Short-Circuiting:) Tj
T*
(   1. Pointer Safety Guard:) Tj
T*
(   if \(ptr != NULL && *ptr > 0\) /* Safely dereferences *ptr only if ptr is not NULL */) Tj
T*
(   2. Boundary Array Guard:) Tj
T*
(   if \(index < MAX_LEN && arr[index] == target\) /* Prevents out-of-bounds buffer overflow */) Tj
