T*
(   FILE *fp = fopen\(path, "rb"\);) Tj
T*
(   if \(!fp\) return 0;) Tj
T*
() Tj
T*
(   /* Calculate direct byte offset: O\(1\) random jump */) Tj
T*
(   long offset = \(long\)\(target_id - 1\) * sizeof\(GeneRecord\);) Tj
T*
(   if \(fseek\(fp, offset, SEEK_SET\) != 0\) {) Tj
