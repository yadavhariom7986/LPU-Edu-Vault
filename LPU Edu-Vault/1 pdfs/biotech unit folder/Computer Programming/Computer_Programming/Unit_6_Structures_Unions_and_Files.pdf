(   2. Shallow Copy Aliasing Hazard:) Tj
T*
(   If a structure contains pointers:) Tj
T*
(   struct Buffer { int *data; };) Tj
T*
(   struct Buffer b1, b2;) Tj
T*
(   b1.data = malloc\(100\);) Tj
T*
(   b2 = b1; /* b2.data receives the EXACT SAME MEMORY ADDRESS as b1.data! */) Tj
T*
(   Both structures now alias the same heap memory block. Freeing both causes a catastrophic) Tj
T*
(   double-free crash!) Tj
T*
(   Always perform manual deep copies for structures containing pointers.) Tj
T*
() Tj
T*
