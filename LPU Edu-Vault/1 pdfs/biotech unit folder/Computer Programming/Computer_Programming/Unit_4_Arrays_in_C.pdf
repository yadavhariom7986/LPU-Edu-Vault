(   3. Complete ANSI C Source Code:) Tj
T*
(   #include <stdio.h>) Tj
T*
() Tj
T*
(   void insertion_sort\(int *arr, int n\) {) Tj
T*
(   for \(int i = 1; i < n; i++\) {) Tj
T*
(   int key = arr[i];) Tj
T*
(   int j = i - 1;) Tj
T*
() Tj
T*
(   /* Shift elements greater than key to the right */) Tj
T*
(   while \(j >= 0 && arr[j] > key\) {) Tj
T*
(   arr[j + 1] = arr[j];) Tj
T*
(   j--;) Tj
T*
(   }) Tj
T*
(   arr[j + 1] = key; /* Place key into insertion slot */) Tj
T*
(   }) Tj
T*
(   }) Tj
T*
() Tj
T*
(   int main\(void\) {) Tj
