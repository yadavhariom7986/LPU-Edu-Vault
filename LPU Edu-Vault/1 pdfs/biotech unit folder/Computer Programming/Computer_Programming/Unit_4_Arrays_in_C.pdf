T*
(   [Detailed Step-by-Step Answer]:) Tj
T*
(   Sorting DNA Fragments by Molecular Length:) Tj
T*
(   1. Problem Statement:) Tj
T*
(   Given an array of DNA fragment sizes \(in base pairs - bp\) obtained from agarose gel) Tj
T*
(   electrophoresis, sort them in ascending order using Insertion Sort, documenting each movement) Tj
T*
(   step.) Tj
T*
() Tj
T*
(   2. Complete ANSI C Source Code:) Tj
T*
(   #include <stdio.h>) Tj
T*
() Tj
T*
(   void sort_dna_fragments\(int *fragments, int count\) {) Tj
T*
(   printf\("=== Agarose Gel Electrophoresis Migration Sorter ===\\n"\);) Tj
T*
(   for \(int i = 1; i < count; i++\) {) Tj
T*
(   int key = fragments[i];) Tj
T*
(   int j = i - 1;) Tj
T*
() Tj
T*
(   while \(j >= 0 && fragments[j] > key\) {) Tj
T*
(   fragments[j + 1] = fragments[j];) Tj
T*
(   j--;) Tj
T*
(   }) Tj
T*
(   fragments[j + 1] = key;) Tj
T*
(   }) Tj
T*
(   }) Tj
T*
() Tj
T*
(   int main\(void\) {) Tj
T*
