45 780 Td
(   followed by Row 2, etc.) Tj
T*
(   - Contrast with Fortran and MATLAB, which use Column-Major Order.) Tj
T*
() Tj
T*
(   3. 2D Memory Address Formula:) Tj
T*
(   Address\(M[i][j]\) = BaseAddress + \(i * COLS + j\) * sizeof\(ElementType\)) Tj
T*
(   - i * COLS: Skips 'i' complete rows of width COLS.) Tj
T*
(   - + j: Offsets to the j-th element in the target row.) Tj
T*
(   - Notice: The address calculation depends ONLY on the number of COLUMNS, not on the total) Tj
T*
(   number of rows! This is why function declarations MUST include the column dimension!) Tj
T*
() Tj
T*
(   4. Demonstrative ANSI C Program:) Tj
T*
(   #include <stdio.h>) Tj
T*
() Tj
T*
(   #define ROWS 3) Tj
T*
(   #define COLS 4) Tj
T*
() Tj
T*
(   int main\(void\) {) Tj
T*
(   int matrix[ROWS][COLS] = {) Tj
T*
(   {11, 12, 13, 14},) Tj
T*
(   {21, 22, 23, 24},) Tj
T*
(   {31, 32, 33, 34}) Tj
T*
(   };) Tj
T*
() Tj
T*
(   printf\("=== 2D Row-Major Memory Mapping ===\\n"\);) Tj
T*
(   for \(int i = 0; i < ROWS; i++\) {) Tj
T*
(   for \(int j = 0; j < COLS; j++\) {) Tj
T*
(   printf\("M[%d][%d] = %2d at %p\\n", i, j, matrix[i][j], \(void *\)&matrix[i][j]\);) Tj
T*
(   }) Tj
T*
(   }) Tj
T*
() Tj
T*
(   /* Demonstrate linear equivalence via single pointer */) Tj
T*
(   int *linear_ptr = &matrix[0][0];) Tj
T*
(   printf\("\\nAccessing M[2][1] linearly \(offset 2*4 + 1 = 9\): %d\\n", linear_ptr[2 * COLS + 1]\);) Tj
T*
() Tj
T*
(   return 0;) Tj
T*
(   }) Tj
T*
() Tj
T*
(--------------------------------------------------------------------------------) Tj
T*
() Tj
T*
