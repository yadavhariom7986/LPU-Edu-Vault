(   2. Sorted Array Two-Pointer Approach:) Tj
T*
(   - Sort array first \(or assume sorted input\).) Tj
T*
(   - Two Pointers: 'write_idx' tracks the boundary of unique elements; 'read_idx' traverses the) Tj
T*
(   array.) Tj
T*
(   - Since identical elements are grouped together, simply check if arr[read_idx] !=) Tj
T*
(   arr[write_idx]:) Tj
T*
(   If true: increment write_idx and copy arr[read_idx] to arr[write_idx].) Tj
T*
(   - Time Complexity: O\(N\) linear time; O\(1\) auxiliary space!) Tj
T*
() Tj
T*
(   3. Complete ANSI C Source Code:) Tj
T*
(   #include <stdio.h>) Tj
T*
() Tj
T*
(   int remove_duplicates_sorted\(int *arr, int n\) {) Tj
T*
(   if \(n <= 1\) return n;) Tj
T*
() Tj
T*
(   int write_idx = 0;) Tj
T*
(   for \(int read_idx = 1; read_idx < n; read_idx++\) {) Tj
T*
(   if \(arr[read_idx] != arr[write_idx]\) {) Tj
T*
(   write_idx++;) Tj
T*
(   arr[write_idx] = arr[read_idx];) Tj
T*
(   }) Tj
T*
(   }) Tj
T*
(   return write_idx + 1; /* Return length of unique prefix */) Tj
T*
(   }) Tj
T*
() Tj
T*
(   int main\(void\) {) Tj
T*
