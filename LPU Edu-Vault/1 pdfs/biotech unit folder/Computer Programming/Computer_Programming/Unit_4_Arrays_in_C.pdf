T*
(   for \(int i = 0; i < N; i++\) {) Tj
T*
(   for \(int j = i + 1; j < N; j++\) {) Tj
T*
(   /* Swap element across main diagonal */) Tj
T*
(   int temp = matrix[i][j];) Tj
T*
(   matrix[i][j] = matrix[j][i];) Tj
T*
(   matrix[j][i] = temp;) Tj
T*
(   }) Tj
T*
(   }) Tj
T*
(   }) Tj
T*
