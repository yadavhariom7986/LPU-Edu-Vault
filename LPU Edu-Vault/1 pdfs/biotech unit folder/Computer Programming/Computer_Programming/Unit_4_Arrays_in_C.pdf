T*
(   printf\("\\n"\);) Tj
T*
() Tj
T*
(   int unique_count = remove_duplicates_sorted\(sorted_codons, n\);) Tj
T*
() Tj
T*
(   printf\("Array after in-place deduplication \(%d unique elements\):\\n", unique_count\);) Tj
T*
(   for \(int i = 0; i < unique_count; i++\) printf\("%d ", sorted_codons[i]\);) Tj
T*
(   printf\("\\n"\);) Tj
T*
() Tj
T*
