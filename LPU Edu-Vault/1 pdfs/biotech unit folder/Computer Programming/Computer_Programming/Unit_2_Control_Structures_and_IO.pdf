T*
(   /* Check for Start Codon: ATG */) Tj
T*
(   if \(dna[i] == 'A' && dna[i+1] == 'T' && dna[i+2] == 'G'\) {) Tj
T*
(   printf\("\\n>> Found START codon \(ATG\) at nucleotide position: %d\\n", i + 1\);) Tj
T*
() Tj
T*
(   /* Scan downstream in steps of 3 \(in-frame triplets\) */) Tj
T*
(   int found_stop = 0;) Tj
T*
