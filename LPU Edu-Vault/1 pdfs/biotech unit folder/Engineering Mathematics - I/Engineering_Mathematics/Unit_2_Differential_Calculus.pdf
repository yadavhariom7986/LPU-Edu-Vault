(   ln L = lim_{x -> 0+} [ ln x / csc x ] \(Form -infinity / infinity\).) Tj
T*
(   - Apply L'Hopital's Rule:) Tj
T*
(   d/dx [ln x] = 1/x) Tj
T*
(   d/dx [csc x] = -csc x * cot x = -cos x / sin^2 x.) Tj
T*
(   ln L = lim_{x -> 0+} [ \(1/x\) / \(-cos x / sin^2 x\) ]) Tj
T*
(   = lim_{x -> 0+} [ - sin^2 x / \(x * cos x\) ]) Tj
T*
(   = - [ lim_{x -> 0+} \(sin x / x\) ] * [ lim_{x -> 0+} \(sin x / cos x\) ]) Tj
T*
(   = - \(1\) * \(0 / 1\) = 0.) Tj
T*
(   - Exponentiate:) Tj
T*
(   L = e^\(ln L\) = e^0 = 1.) Tj
T*
(   Conclusion:) Tj
T*
(   \(i\) Limit = e^\(-1/6\).) Tj
T*
(   \(ii\) Limit = 1.) Tj
