(Problem Context: Implement an IP network utility in Python that reads an IPv4 address) Tj
T*
(and subnet mask as 32-bit integers, performs bitwise AND masking to determine the) Tj
T*
(network address, and calculates total usable host addresses.) Tj
T*
(Python Source Code:) Tj
T*
(# Bitwise IP Network Masking Utility) Tj
T*
(def ip_to_int\(octet1, octet2, octet3, octet4\):) Tj
T*
(return \(octet1 << 24\) | \(octet2 << 16\) | \(octet3 << 8\) | octet4) Tj
T*
() Tj
T*
(def int_to_ip\(ip_int\):) Tj
T*
(return f'{\(ip_int >> 24\) & 255}.{\(ip_int >> 16\) & 255}.{\(ip_int >> 8\) & 255}.{ip_int &) Tj
T*
(255}') Tj
T*
() Tj
T*
(ip_val = ip_to_int\(192, 168, 1, 145\)      # 192.168.1.145) Tj
T*
(mask_val = ip_to_int\(255, 255, 255, 224\)  # /27 Subnet \(255.255.255.224\)) Tj
T*
(network_val = ip_val & mask_val) Tj
T*
(broadcast_val = network_val | \(~mask_val & 0xFFFFFFFF\)) Tj
T*
(usable_hosts = \(broadcast_val - network_val\) - 1) Tj
T*
() Tj
T*
(print\(f'Host IP Address:      {int_to_ip\(ip_val\)}'\)) Tj
T*
(print\(f'Subnet Mask:          {int_to_ip\(mask_val\)}'\)) Tj
T*
(print\(f'Network Address:      {int_to_ip\(network_val\)}'\)) Tj
T*
(print\(f'Broadcast Address:    {int_to_ip\(broadcast_val\)}'\)) Tj
T*
(print\(f'Usable Host Capacity: {usable_hosts}'\)) Tj
T*
(Execution Trace & Output:) Tj
