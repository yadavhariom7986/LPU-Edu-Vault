([PROGRAM 1: Text Frequency Analysis & Word Counter]) Tj
T*
/F1 9 Tf
/F2 9.5 Tf
(-------------------------------------------------------------------------------------) Tj
T*
/F1 9 Tf
(Problem Context: Build a text-processing utility that cleans raw text \(stripping) Tj
T*
(punctuation and converting to lowercase\), computes word frequency using a dictionary,) Tj
T*
(and displays the top 5 most frequent words.) Tj
T*
(Python Source Code:) Tj
T*
(import string) Tj
T*
() Tj
T*
(def word_frequency_analyzer\(text\):) Tj
T*
(# Clean punctuation and normalize case) Tj
T*
(clean_text = text.translate\(str.maketrans\('', '', string.punctuation\)\).lower\(\)) Tj
T*
(words = clean_text.split\(\)) Tj
T*
() Tj
T*
(freq_map = {}) Tj
T*
(for word in words:) Tj
T*
(freq_map[word] = freq_map.get\(word, 0\) + 1) Tj
T*
() Tj
T*
(# Sort by frequency descending using lambda) Tj
T*
(sorted_words = sorted\(freq_map.items\(\), key=lambda item: item[1], reverse=True\)) Tj
T*
(return sorted_words[:5]) Tj
T*
() Tj
T*
(sample = 'Data structures in Python are powerful. Python lists and Python dictionaries) Tj
T*
(offer fast lookups in data science.') Tj
T*
(top_words = word_frequency_analyzer\(sample\)) Tj
T*
(print\('Top 5 Most Frequent Words:'\)) Tj
T*
(for word, count in top_words:) Tj
T*
(print\(f'  {word:12s} : {count} occurrences'\)) Tj
T*
ET

