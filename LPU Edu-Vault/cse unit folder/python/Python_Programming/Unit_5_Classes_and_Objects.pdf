T*
(equality \(__eq__\).) Tj
T*
(Python Source Code:) Tj
T*
(import math) Tj
T*
() Tj
T*
(class Vector2D:) Tj
T*
(def __init__\(self, x, y\):) Tj
T*
(self.x = float\(x\)) Tj
T*
(self.y = float\(y\)) Tj
T*
() Tj
T*
(def __add__\(self, other\):) Tj
T*
(return Vector2D\(self.x + other.x, self.y + other.y\)) Tj
T*
() Tj
T*
(def __mul__\(self, scalar\):) Tj
T*
(return Vector2D\(self.x * scalar, self.y * scalar\)) Tj
T*
() Tj
T*
(def magnitude\(self\):) Tj
T*
(return math.sqrt\(self.x**2 + self.y**2\)) Tj
T*
() Tj
T*
(def __eq__\(self, other\):) Tj
T*
(return math.isclose\(self.magnitude\(\), other.magnitude\(\)\)) Tj
T*
() Tj
T*
(def __repr__\(self\):) Tj
T*
(return f'Vector2D\({self.x:.1f}, {self.y:.1f}\)') Tj
