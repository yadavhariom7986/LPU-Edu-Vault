(class InsufficientStockError\(Exception\):) Tj
T*
(def __init__\(self, item, requested, available\):) Tj
T*
(super\(\).__init__\(f'Cannot purchase {requested} units of '{item}'. Only {available}) Tj
T*
(available.'\)) Tj
T*
(self.item = item) Tj
T*
(self.requested = requested) Tj
T*
(self.available = available) Tj
T*
() Tj
T*
(inventory = {'Laptop': 5, 'Mouse': 20}) Tj
T*
() Tj
T*
(def purchase\(item, quantity\):) Tj
T*
(if item not in inventory:) Tj
T*
(raise KeyError\(f'Item '{item}' does not exist in inventory.'\)) Tj
T*
(if quantity > inventory[item]:) Tj
T*
(raise InsufficientStockError\(item, quantity, inventory[item]\)) Tj
T*
(inventory[item] -= quantity) Tj
T*
(print\(f'Purchase successful! Remaining {item} stock: {inventory[item]}'\)) Tj
T*
() Tj
T*
(try:) Tj
T*
(purchase\('Laptop', 8\)) Tj
T*
(except InsufficientStockError as err:) Tj
T*
