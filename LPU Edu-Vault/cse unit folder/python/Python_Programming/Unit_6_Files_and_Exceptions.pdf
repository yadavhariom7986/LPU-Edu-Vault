/F1 9 Tf
(Problem Context: Write a program reading a configuration file containing key=value) Tj
T*
(pairs, parsing valid entries into a dictionary, handling FileNotFoundError and parsing) Tj
T*
(errors cleanly.) Tj
T*
(Python Source Code:) Tj
T*
(def parse_config\(file_path\):) Tj
T*
(config = {}) Tj
T*
(try:) Tj
T*
(with open\(file_path, 'r', encoding='utf-8'\) as f:) Tj
T*
(for line_no, line in enumerate\(f, start=1\):) Tj
T*
(clean_line = line.strip\(\)) Tj
T*
(if not clean_line or clean_line.startswith\('#'\):) Tj
T*
(continue) Tj
T*
(if '=' not in clean_line:) Tj
T*
(print\(f'Warning: Line {line_no} malformed, skipping.'\)) Tj
T*
(continue) Tj
T*
(key, val = clean_line.split\('=', 1\)) Tj
T*
(config[key.strip\(\)] = val.strip\(\)) Tj
T*
(except FileNotFoundError:) Tj
T*
(print\(f'Error: File '{file_path}' not found on disk.'\)) Tj
T*
(return None) Tj
T*
(except PermissionError:) Tj
T*
(print\(f'Error: Insufficient permission to read '{file_path}'.'\)) Tj
T*
(return None) Tj
T*
(else:) Tj
T*
(print\(f'Successfully parsed {len\(config\)} config parameters.'\)) Tj
T*
ET

endstream
