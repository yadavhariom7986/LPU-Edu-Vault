(Problem Context: Implement an efficient recursive binary search function that searches) Tj
T*
(for target key in a sorted list in O\(log n\) time.) Tj
T*
(Python Source Code:) Tj
T*
(def binary_search\(arr, low, high, target\):) Tj
T*
(if low > high:) Tj
T*
(return -1  # Base Case: target not found) Tj
T*
() Tj
T*
(mid = \(low + high\) // 2) Tj
T*
(if arr[mid] == target:) Tj
T*
(return mid  # Base Case: target found at mid index) Tj
T*
(elif arr[mid] > target:) Tj
T*
(return binary_search\(arr, low, mid - 1, target\)  # Search left half) Tj
T*
(else:) Tj
T*
(return binary_search\(arr, mid + 1, high, target\)  # Search right half) Tj
T*
() Tj
T*
(data = [11, 23, 34, 45, 56, 67, 78, 89, 90, 99]) Tj
T*
(target = 67) Tj
T*
(index = binary_search\(data, 0, len\(data\) - 1, target\)) Tj
T*
(print\(f'Array: {data}'\)) Tj
T*
(print\(f'Element {target} found at index: {index}'\)) Tj
T*
