T*
(// Closure-based Private State Encapsulation) Tj
T*
(function createSecureAccount\(accountHolder, initialDeposit\) {) Tj
T*
(// Private variables inaccessible from external scope) Tj
T*
(let balance = initialDeposit;) Tj
T*
(let transactionHistory = [];) Tj
T*
() Tj
T*
(return {) Tj
T*
(getHolder: \(\) => accountHolder) Tj
T*
(getBalance: \(\) => balance) Tj
T*
(deposit: function\(amount\) {) Tj
T*
(if \(amount <= 0\) return 'Invalid deposit amount';) Tj
T*
(balance += amount;) Tj
T*
(transactionHistory.push\({ type: 'DEPOSIT', amount, date: new Date\(\) }\);) Tj
T*
(return 'Deposited INR '${amount}. New Balance: INR '${balance}';) Tj
T*
(}) Tj
T*
(withdraw: function\(amount\) {) Tj
T*
(if \(amount > balance\) return 'Insufficient funds';) Tj
T*
(balance -= amount;) Tj
T*
(transactionHistory.push\({ type: 'WITHDRAWAL', amount, date: new Date\(\) }\);) Tj
T*
(return 'Withdrew INR '${amount}. Remaining: INR '${balance}';) Tj
T*
(}) Tj
T*
(};) Tj
