T*
(function demonstrateTypes\(\) {) Tj
T*
(console.log\('--- Type Coercion Analysis ---'\);) Tj
T*
(console.log\('5' + 2\);        // '52' \(Number coerced to string\)) Tj
T*
(console.log\('5' - 2\);        // 3    \(String coerced to number\)) Tj
T*
(console.log\('5' * '2'\);      // 10   \(Both coerced to numbers\)) Tj
T*
(console.log\([] == false\);    // true \(Complex coercion\)) Tj
T*
(console.log\([] === false\);   // false \(Different types: Object vs Boolean\)) Tj
T*
() Tj
T*
(console.log\('--- Null vs Undefined ---'\);) Tj
T*
(let unassignedVar;) Tj
T*
(let emptyVar = null;) Tj
T*
(console.log\('unassignedVar: '${unassignedVar} \('${typeof unassignedVar}\)'\);) Tj
T*
(console.log\('emptyVar:      '${emptyVar} \('${typeof emptyVar}\)'\);) Tj
T*
(console.log\('null == undefined:  '${null == undefined}'\);   // true) Tj
T*
