T*
(<canvas id='radarCanvas' width='200' height='200' style='border:1px solid) Tj
T*
(#333;'></canvas>) Tj
T*
(<script>) Tj
T*
(const canvas = document.getElementById\('radarCanvas'\);) Tj
T*
(const ctx = canvas.getContext\('2d'\);) Tj
T*
(// Draw concentric radar circles) Tj
T*
(ctx.strokeStyle = '#00aa00';) Tj
T*
(ctx.lineWidth = 2;) Tj
T*
(ctx.arc\(100, 100, 40, 0, 2 * Math.PI\); ctx.stroke\(\);) Tj
T*
(ctx.beginPath\(\); ctx.arc\(100, 100, 80, 0, 2 * Math.PI\); ctx.stroke\(\);) Tj
T*
(// Draw crosshair axes) Tj
T*
(ctx.beginPath\(\);) Tj
T*
(ctx.moveTo\(100, 10\); ctx.lineTo\(100, 190\);) Tj
T*
(ctx.moveTo\(10, 100\); ctx.lineTo\(190, 100\); ctx.stroke\(\);) Tj
T*
(</script>) Tj
T*
(Outcome: Renders cross-browser multimedia without Flash plugins and draws dynamic vector) Tj
T*
