([PROGRAM 1: Vectorized Sinusoidal Signal Generation and Sampling]) Tj
T*
/F1 9 Tf
/F2 9.5 Tf
(-----------------------------------------------------------------------------------------) Tj
T*
/F1 9 Tf
(Problem Context: Generate and analyze an analog sinusoidal signal v\(t\) = V_m *) Tj
T*
(sin\(2*pi*f*t + phi\) sampled at Nyquist rate using NumPy vectorization.) Tj
T*
(Python Source Code:) Tj
T*
(import numpy as np) Tj
T*
() Tj
T*
(# Signal Specifications) Tj
T*
(f_signal = 1000.0 # 1 kHz frequency) Tj
T*
(v_peak = 5.0 # 5 Volts amplitude) Tj
T*
(phase_deg = 30.0 # 30 degrees initial phase) Tj
T*
() Tj
T*
(# Sampling Specifications \(f_s >= 2 * f_signal\)) Tj
T*
(f_sampling = 20000.0 # 20 kHz sampling frequency \(20 samples per cycle\)) Tj
T*
(duration = 0.002 # 2 milliseconds \(2 full cycles\)) Tj
T*
() Tj
T*
(# Generate time vector using np.linspace) Tj
T*
(total_samples = int\(duration * f_sampling\)) Tj
T*
(t = np.linspace\(0, duration, total_samples, endpoint=False\)) Tj
T*
() Tj
T*
(# Vectorized Signal Synthesis \(zero explicit loops\)) Tj
T*
(phi_rad = np.radians\(phase_deg\)) Tj
T*
(v_signal = v_peak * np.sin\(2 * np.pi * f_signal * t + phi_rad\)) Tj
T*
() Tj
T*
(# Statistical Array Aggregations) Tj
T*
(v_max = np.max\(v_signal\)) Tj
T*
(v_min = np.min\(v_signal\)) Tj
T*
(v_rms = np.sqrt\(np.mean\(v_signal**2\)\)) Tj
T*
(v_avg = np.mean\(np.abs\(v_signal\)\)) Tj
T*
() Tj
T*
ET

endstream
