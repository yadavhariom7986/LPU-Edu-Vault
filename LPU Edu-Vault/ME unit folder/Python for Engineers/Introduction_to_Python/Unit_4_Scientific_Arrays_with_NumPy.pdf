([PROGRAM 2: Multi-Mesh Electrical Circuit Solver via np.linalg.solve]) Tj
T*
/F1 9 Tf
/F2 9.5 Tf
(-----------------------------------------------------------------------------------------) Tj
T*
/F1 9 Tf
(Problem Context: Solve the loop currents I1, I2, I3 for a 3-loop bridge circuit using) Tj
T*
(matrix linear algebra: [R] * [I] = [V].) Tj
T*
(Python Source Code:) Tj
T*
(import numpy as np) Tj
T*
() Tj
T*
(# Resistance Matrix [R] in Ohms) Tj
T*
(R = np.array\([) Tj
T*
([ 12.0, -4.0, -2.0],) Tj
T*
([ -4.0, 16.0, -6.0],) Tj
T*
([ -2.0, -6.0, 14.0]) Tj
T*
(]\)) Tj
T*
() Tj
T*
(# Voltage Vector [V] in Volts) Tj
T*
(V = np.array\([24.0, 0.0, -12.0]\)) Tj
T*
() Tj
T*
(# Verify non-singular matrix \(det != 0\)) Tj
T*
(det_R = np.linalg.det\(R\)) Tj
T*
(print\(f'Determinant of R Matrix: {det_R:.2f}'\)) Tj
T*
() Tj
T*
(if abs\(det_R\) > 1e-6:) Tj
T*
(# Solve linear system R * I = V) Tj
T*
(I = np.linalg.solve\(R, V\)) Tj
T*
(print\('Calculated Mesh Currents:'\)) Tj
T*
(for i, current in enumerate\(I, start=1\):) Tj
T*
(print\(f' Loop Current I{i} = {current:8.4f} Amperes'\)) Tj
T*
() Tj
T*
(# Verify solution: R @ I must equal V) Tj
T*
(v_verify = R @ I) Tj
T*
(print\(f'Residual Check \(R @ I - V\): {np.max\(np.abs\(v_verify - V\)\):.2e}'\)) Tj
T*
(else:) Tj
T*
(print\('Singular matrix! Circuit has no unique solution.'\)) Tj
T*
() Tj
T*
() Tj
T*
/F2 9.5 Tf
(-----------------------------------------------------------------------------------------) Tj
T*
