(Problem Context: Simulate grayscale digital image processing operations \(brightness) Tj
T*
(scaling, thresholding, negative inversion\) on a 2D NumPy array.) Tj
T*
(Python Source Code:) Tj
T*
(import numpy as np) Tj
T*
() Tj
T*
(# Synthetic 4x4 grayscale image patch \(values 0-255 uint8\)) Tj
T*
(np.random.seed\(42\)) Tj
T*
(img = np.random.randint\(50, 200, size=\(4, 4\), dtype=np.uint8\)) Tj
T*
(print\('Original Image Matrix:\\n', img\)) Tj
T*
() Tj
T*
(# 1. Negative Image Inversion: I_inv = 255 - I) Tj
T*
(img_inverted = 255 - img) Tj
T*
(print\('\\nInverted \(Negative\) Matrix:\\n', img_inverted\)) Tj
T*
() Tj
T*
(# 2. Brightness Adjustment \(Vectorized clipping to prevent overflow\)) Tj
T*
(brightness_boost = 40) Tj
T*
(img_bright = np.clip\(img.astype\(np.int16\) + brightness_boost, 0, 255\).astype\(np.uint8\)) Tj
T*
(print\('\\nBrightness Boosted \(+40\):\\n', img_bright\)) Tj
T*
() Tj
T*
(# 3. Binary Thresholding \(Binarization at threshold = 128\)) Tj
T*
(binary_mask = \(img >= 128\).astype\(np.uint8\) * 255) Tj
T*
(print\('\\nBinarized Black/White Matrix:\\n', binary_mask\)) Tj
T*
() Tj
T*
() Tj
T*
/F2 9.5 Tf
(-----------------------------------------------------------------------------------------) Tj
T*
/F1 9 Tf
/F2 9.5 Tf
([PROGRAM 4: Statistical Outlier Rejection via Boolean Masking]) Tj
T*
/F1 9 Tf
/F2 9.5 Tf
(-----------------------------------------------------------------------------------------) Tj
T*
/F1 9 Tf
(Problem Context: Clean experimental RF signal power measurements by automatically) Tj
T*
(identifying and rejecting statistical outliers beyond 2 standard deviations.) Tj
T*
(Python Source Code:) Tj
T*
(import numpy as np) Tj
T*
() Tj
T*
(# Experimental telemetry with spurious transient noise spikes) Tj
T*
(telemetry = np.array\([45.2, 44.8, 45.0, 98.6, 44.9, 45.3, -12.4, 45.1, 44.7, 45.5]\)) Tj
T*
() Tj
T*
(mean_raw = np.mean\(telemetry\)) Tj
T*
(std_raw = np.std\(telemetry\)) Tj
T*
() Tj
T*
(# Vectorized Boolean Mask: keep samples within [mean - 2*std, mean + 2*std]) Tj
T*
(mask = \(telemetry >= mean_raw - 2 * std_raw\) & \(telemetry <= mean_raw + 2 * std_raw\)) Tj
T*
(clean_telemetry = telemetry[mask]) Tj
T*
(rejected_outliers = telemetry[~mask]) Tj
T*
() Tj
T*
(print\(f'Raw Dataset Size : {len\(telemetry\)} | Raw Mean: {mean_raw:.2f}'\)) Tj
T*
(print\(f'Rejected Outliers: {rejected_outliers}'\)) Tj
T*
(print\(f'Clean Dataset : {clean_telemetry}'\)) Tj
T*
ET

endstream
