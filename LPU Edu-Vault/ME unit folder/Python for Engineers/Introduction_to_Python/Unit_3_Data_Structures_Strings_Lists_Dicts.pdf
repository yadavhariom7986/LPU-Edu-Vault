(Problem Context: Manage electronic components in a laboratory inventory with quantities,) Tj
T*
(bin locations, and minimum threshold alerts.) Tj
T*
(Python Source Code:) Tj
T*
(# Key: Part Number | Value: \(Description, Quantity, Unit Price, Bin Location\)) Tj
T*
(inventory = {) Tj
T*
('RES_10K': \('Resistor 10k 0.25W', 1500, 0.05, 'BIN_A1'\),) Tj
T*
('CAP_100U': \('Capacitor 100uF 25V', 45, 0.35, 'BIN_B2'\),) Tj
T*
('IC_LM741': \('Op-Amp uA741 DIP8', 12, 0.75, 'BIN_C4'\),) Tj
T*
('DIODE_1N4007': \('Diode 1000V 1A', 800, 0.08, 'BIN_A3'\)) Tj
T*
(}) Tj
T*
() Tj
T*
(def check_restock\(inv, threshold=50\):) Tj
T*
(restock_list = []) Tj
T*
(for part, \(desc, qty, price, bin_loc\) in inv.items\(\):) Tj
T*
(if qty < threshold:) Tj
T*
(restock_list.append\(\(part, desc, qty, bin_loc\)\)) Tj
T*
(return restock_list) Tj
T*
() Tj
T*
(low_stock = check_restock\(inventory, threshold=50\)) Tj
T*
(print\('=== LOW STOCK ALERT \(< 50 units\) ==='\)) Tj
T*
(for part, desc, qty, bin_loc in low_stock:) Tj
T*
(print\(f'[ALERT] {part:<12} \({desc}\): Current Qty = {qty} \(Located in {bin_loc}\)'\)) Tj
T*
() Tj
T*
() Tj
