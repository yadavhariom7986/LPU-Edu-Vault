([PROGRAM 1: Telecommunication Serial Packet Parser]) Tj
T*
/F1 9 Tf
/F2 9.5 Tf
(-----------------------------------------------------------------------------------------) Tj
T*
/F1 9 Tf
(Problem Context: Parse a raw ASCII serial telemetry packet structured as) Tj
T*
("$HEADER,DEVICE_ID,VOLTAGE,CURRENT,TEMP*CHECKSUM", validate packet integrity, and) Tj
T*
(extract numerical sensor data.) Tj
T*
(Python Source Code:) Tj
T*
(def parse_telemetry_packet\(raw_packet\):) Tj
T*
(# Check start and end markers) Tj
T*
(if not raw_packet.startswith\('$'\) or '*' not in raw_packet:) Tj
T*
(return False, 'Malformed packet framing') Tj
T*
() Tj
T*
(# Strip framing and split payload from checksum) Tj
T*
(packet_core = raw_packet[1:] # remove $) Tj
T*
(payload, claimed_chk_hex = packet_core.split\('*'\)) Tj
T*
() Tj
T*
(# Verify XOR Checksum \(NMEA 0183 protocol standard\)) Tj
T*
(calculated_chk = 0) Tj
T*
(for char in payload:) Tj
T*
(calculated_chk ^= ord\(char\)) Tj
T*
() Tj
T*
(claimed_chk = int\(claimed_chk_hex, 16\)) Tj
T*
(if calculated_chk != claimed_chk:) Tj
T*
(return False, f'Checksum mismatch! Calc: {calculated_chk:#04x}, Claimed:) Tj
T*
({claimed_chk:#04x}') Tj
T*
() Tj
T*
(# Tokenize CSV fields) Tj
T*
ET

endstream
