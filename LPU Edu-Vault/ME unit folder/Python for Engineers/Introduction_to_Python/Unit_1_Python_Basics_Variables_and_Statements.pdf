([PROGRAM 2: Quadratic Equation Solver with Complex Conjugate Roots]) Tj
T*
/F1 9 Tf
/F2 9.5 Tf
(-----------------------------------------------------------------------------------------) Tj
T*
/F1 9 Tf
(Problem Context: Solve the general quadratic equation a*x^2 + b*x + c = 0, handling real) Tj
T*
(distinct roots, repeated roots, and complex conjugate roots.) Tj
T*
(Python Source Code:) Tj
T*
(import cmath) Tj
T*
() Tj
T*
(def solve_quadratic\(a, b, c\):) Tj
T*
(if a == 0:) Tj
T*
(return 'Linear equation: root = ' + str\(-c / b\) if b != 0 else 'Invalid equation') Tj
T*
() Tj
T*
(# Calculate discriminant: D = b^2 - 4ac) Tj
T*
(discriminant = b**2 - 4 * a * c) Tj
T*
() Tj
T*
(if discriminant > 0:) Tj
T*
(r1 = \(-b + discriminant**0.5\) / \(2 * a\)) Tj
T*
(r2 = \(-b - discriminant**0.5\) / \(2 * a\)) Tj
T*
(return f'Real & Distinct Roots: x1 = {r1:.4f}, x2 = {r2:.4f}') Tj
T*
(elif discriminant == 0:) Tj
T*
(r = -b / \(2 * a\)) Tj
T*
(return f'Real & Repeated Roots: x1 = x2 = {r:.4f}') Tj
T*
(else:) Tj
T*
(# Complex roots using cmath) Tj
T*
(r1 = \(-b + cmath.sqrt\(discriminant\)\) / \(2 * a\)) Tj
T*
(r2 = \(-b - cmath.sqrt\(discriminant\)\) / \(2 * a\)) Tj
T*
(return f'Complex Conjugate Roots: x1 = {r1.real:.4f} + {r1.imag:.4f}j, x2 =) Tj
T*
({r2.real:.4f} + {r2.imag:.4f}j') Tj
T*
() Tj
T*
(# Demonstration executions) Tj
T*
(print\('Case 1 \(Real\):', solve_quadratic\(1, -5, 6\)\)) Tj
T*
(print\('Case 2 \(Repeated\):', solve_quadratic\(1, -4, 4\)\)) Tj
T*
(print\('Case 3 \(Complex\):', solve_quadratic\(2, 4, 10\)\)) Tj
T*
() Tj
T*
ET

endstream
