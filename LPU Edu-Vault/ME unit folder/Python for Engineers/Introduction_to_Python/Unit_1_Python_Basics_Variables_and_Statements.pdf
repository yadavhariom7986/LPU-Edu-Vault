T*
() Tj
T*
(print\(f'{'Celsius \(C\)':<15} | {'Fahrenheit \(F\)':<15} | {'Kelvin \(K\)':<15} | {'State) Tj
T*
(Description'}'\)) Tj
T*
(print\('-' * 65\)) Tj
T*
() Tj
T*
(for c in temps_celsius:) Tj
T*
