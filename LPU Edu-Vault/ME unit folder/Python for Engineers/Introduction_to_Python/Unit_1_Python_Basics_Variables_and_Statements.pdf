([PROGRAM 3: Embedded Microcontroller Register Bit Manipulation]) Tj
T*
/F1 9 Tf
/F2 9.5 Tf
(-----------------------------------------------------------------------------------------) Tj
T*
/F1 9 Tf
(Problem Context: Demonstrate bitwise masking, bit-setting, bit-clearing, and) Tj
T*
(bit-toggling operations on an 8-bit microcontroller GPIO Port register.) Tj
T*
(Python Source Code:) Tj
T*
(# Initial 8-bit GPIO Data Direction Register \(DDR\): 0b00110100 \(Decimal 52\)) Tj
T*
(port_reg = 0b00110100) Tj
T*
() Tj
T*
(def print_binary\(label, val\):) Tj
T*
(print\(f'{label:<25} : 0b{val:08b} \(Decimal {val}\)'\)) Tj
T*
() Tj
T*
(print_binary\('Initial Register', port_reg\)) Tj
T*
() Tj
T*
(# 1. SET bit 1 \(Make pin 1 an output\): port_reg |= \(1 << 1\)) Tj
T*
(port_reg |= \(1 << 1\)) Tj
T*
(print_binary\('After SET Bit 1', port_reg\)) Tj
T*
() Tj
T*
(# 2. CLEAR bit 5: port_reg &= ~\(1 << 5\)) Tj
T*
(port_reg &= ~\(1 << 5\)) Tj
T*
(print_binary\('After CLEAR Bit 5', port_reg\)) Tj
T*
() Tj
T*
(# 3. TOGGLE bit 2: port_reg ^= \(1 << 2\)) Tj
T*
(port_reg ^= \(1 << 2\)) Tj
T*
(print_binary\('After TOGGLE Bit 2', port_reg\)) Tj
T*
() Tj
T*
(# 4. READ / TEST bit 4:) Tj
T*
(is_bit4_set = bool\(port_reg & \(1 << 4\)\)) Tj
T*
(print\(f'Is Bit 4 Set? : {is_bit4_set}'\)) Tj
T*
() Tj
T*
() Tj
T*
/F2 9.5 Tf
(-----------------------------------------------------------------------------------------) Tj
T*
